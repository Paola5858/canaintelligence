ht:15px;color:#76817B\">Camila Bertoldi</div>\n</div>\n</div>\n<span data-kid=\"1-1-2-2\" data-name=\"vertical divider\" style=\"width:1px;height:22px;background:rgba(37,49,45,.14)\"></span>\n<div data-kid=\"1-1-2-3\" data-name=\"safra and load timestamp group\" style=\"text-align:right\">\n<div data-kid=\"1-1-2-3-1\" data-name=\"safra period label\" style=\"font-size:12px;line-height:15px;color:#76817B\">Safra 2026/2027</div>\n<div data-kid=\"1-1-2-3-2\" data-name=\"model load timestamp text\" style=\"font-size:12px;line-height:15px;color:#76817B\">Carga do modelo 12/12/2026 05:12</div>\n</div>\n</div>\n</div>\n<!-- navegação -->\n<div data-kid=\"1-2\" data-name=\"tab navigation bar\" style=\"height:40px;display:flex;align-items:center;margin-top:8px\">\n<div class=\"card\" data-kid=\"1-2-1\" data-name=\"segmented tab pill container\" style=\"display:flex;align-items:center;gap:2px;padding:4px;border-radius:999px\">\n<span class=\"navpill on\" data-kid=\"1-2-1-1\" data-name=\"active tab 'Fila'\">Fila</span>\n<span class=\"navpill\" data-kid=\"1-2-1-2\" data-name=\"inactive tab 'Medições'\">Medições</span>\n<span class=\"navpill\" data-kid=\"1-2-1-3\" data-name=\"inactive tab 'Fontes'\">Fontes</span>\n<span class=\"navpill\" data-kid=\"1-2-1-4\" data-name=\"inactive tab 'Pendências'\">Pendências</span>\n</div>\n</div>\n<!-- breadcrumb -->\n<div data-kid=\"1-3\" data-name=\"breadcrumb and stats row\" style=\"height:20px;display:flex;align-items:center;justify-content:space-between;margin-top:12px\">\n<div data-kid=\"1-3-1\" data-name=\"breadcrumb trail\" style=\"display:flex;align-items:center;gap:6px\">\n<span class=\"link\" data-kid=\"1-3-1-1\" data-name=\"breadcrumb home link icon\" style=\"display:inline-flex;align-items:center;gap:4px\"><i class=\"ti ti-arrow-back-up\" data-kid=\"1-3-1-1-1\" data-name=\"back-arrow chevron icon\" style=\"font-size:13px\"></i>Safra 2026/2027</span>\n<span class=\"ic\" data-kid=\"1-3-1-2\" data-name=\"breadcrumb chevron separator\"