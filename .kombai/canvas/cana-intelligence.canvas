5.24],[188,116.75],[190,117.77],[191,116.59],[192,118.53],[193,119.4],[194,117.0],[195,113.84],[196,117.22],[197,120.45],[198,117.92],[199,115.88],[200,120.53],[201,115.94],[202,116.94],[203,116.52],[204,121.77],[205,119.01],[206,113.74],[207,115.64],[208,115.72],[212,111.56],[213,114.16],[214,115.22],[215,115.47],[216,120.46],[217,124.22],[218,119.92],[219,116.27],[221,123.83],[222,122.92],[223,122.96],[224,123.14],[225,126.37],[226,121.15],[227,117.74],[228,121.79],[229,116.03],[230,120.54],[231,121.44],[232,122.6],[233,122.46],[234,121.97],[235,121.66],[236,119.68],[237,120.01],[238,121.96],[239,119.62],[243,114.39],[244,111.38],[245,112.39],[246,117.73],[247,117.71],[248,121.34],[249,123.33],[250,116.49],[252,124.38],[253,122.65],[254,122.84],[255,118.06],[256,122.32],[257,124.96],[258,124.1],[259,123.7],[260,125.49],[261,126.25],[262,126.85],[263,124.7],[264,123.77],[265,123.38],[266,123.65],[267,121.67],[268,125.88],[269,122.42],[273,112.29],[275,112.0],[276,114.84],[277,123.73],[278,123.52],[279,121.97],[280,115.26],[282,126.13],[283,121.27],[284,121.97],[285,123.93],[286,122.1],[287,120.62],[288,122.95],[289,123.27],[290,121.79],[291,124.41],[292,117.37],[293,123.56],[294,123.52],[295,122.42],[296,120.99],[297,122.96],[298,123.43],[300,121.11],[304,115.17],[305,108.44],[306,115.13],[307,118.82],[308,119.49],[309,124.13],[310,126.51],[311,115.93],[313,118.61],[314,114.04],[315,118.76],[316,117.08],[318,116.43],[319,117.5],[320,116.27],[321,113.43],[322,115.41],[323,116.11],[324,116.59],[325,116.14],[326,117.84],[327,115.98],[328,118.12],[329,115.64],[330,118.02],[334,109.53],[335,110.17],[336,115.42],[337,114.78],[338,124.55],[339,127.72],[340,121.88],[341,117.34]];\n  var M = [[-3,'jan'],[28,'fev'],[56,'mar'],[87,'abr'],[117,'mai'],[148,'jun'],[178,'jul'],[209,'ago'],[240,'set'],[270,'out'],[301,'nov'],[331,'dez']];\n  var W = 980, H = 240, L = 44, R = 18, T = 12, B = 26, lo = 104, hi = 132, SPAN = 341;\n  var mean = 117.23, sdp = 5.10, hiBand = 122.33, loBand = 112.13;\n  var pw = W - L - R, ph = H - T - B;\n  var X = function (o) { return L + pw * o / SPAN; };\n  var Y = function (v) { return T + ph * (1 - (v - lo) / (hi - lo)); };\n  var f = function (n) { return n.toFixed(1).replace('.', ','); };\n  var s = '<svg width=\"' + W + '\" height=\"' + H + '\" viewBox=\"0 0 ' + W + ' ' + H + '\" fill=\"none\" font-family=\"Segoe UI, system-ui, sans-serif\" role=\"img\" aria-label=\"ATR: média diária das sete frentes em kg por tonelada, de 4 de janeiro a 11 de dezembro de 2026\">';\n  for (var g = lo; g <= hi; g += 4) {\n    s += '<line x1=\"' + L + '\" y1=\"' + Y(g).toFixed(1) + '\" x2=\"' + (W - R) + '\" y2=\"' + Y(g).toFixed(1) + '\" stroke=\"rgba(37,49,45,0.07)\" stroke-width=\"1\"/>';\n    s += '<text x=\"' + (L - 9) + '\" y=\"' + (Y(g) + 4).toFixed(1) + '\" text-anchor=\"end\" font-size=\"12\" fill=\"#76817B\">' + g + '</text>';\n  }\n  s += '<rect x=\"' + L + '\" y=\"' + Y(hiBand).toFixed(1) + '\" width=\"' + pw + '\" height=\"' + (Y(loBand) - Y(hiBand)).toFixed(1) + '\" fill=\"rgba(78,121,102,0.10)\"/>';\n  for (var m = 0; m < M.length; m++) {\n    var mx = X(M[m][0]);\n    s += '<line x1=\"' + mx.toFixed(1) + '\" y1=\"' + T + '\" x2=\"' + mx.toFixed(1) + '\" y2=\"' + (T + ph) + '\" stroke=\"rgba(37,49,45,0.05)\" stroke-width=\"1\"/>';\n    s += '<text x=\"' + mx.toFixed(1) + '\" y=\"' + (H - 7) + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#76817B\">' + M[m][1] + '</text>';\n  }\n  s += '<line x1=\"' + L + '\" y1=\"' + Y(mean).toFixed(1) + '\" x2=\"' + (W - R) + '\" y2=\"' + Y(mean).toFixed(1) + '\" stroke=\"#173F35\" stroke-width=\"1.2\" stroke-dasharray=\"6 4\"/>';\n  s += '<text x=\"' + (L + 4) + '\" y=\"' + (Y(mean) - 7).toFixed(1) + '\" font-size=\"12\" fill=\"#173F35\">média do período 117,23</text>';\n  s += '<text x=\"' + (L + 4) + '\" y=\"' + (Y(hiBand) - 5).toFixed(1) + '\" font-size=\"12\" fill=\"#76817B\">+1 DP 122,33</text>';\n  s += '<text x=\"' + (L + 4) + '\" y=\"' + (Y(loBand) + 13).toFixed(1) + '\" font-size=\"12\" fill=\"#76817B\">-1 DP 112,13</text>';\n  for (var i = 0; i < D.length; i++) {\n    s += '<circle cx=\"' + X(D[i][0]).toFixed(1) + '\" cy=\"' + Y(D[i][1]).toFixed(1) + '\" r=\"2.3\" fill=\"#4E7966\" opacity=\"0.5\"/>';\n  }\n  s += '<circle cx=\"' + X(339).toFixed(1) + '\" cy=\"' + Y(127.72).toFixed(1) + '\" r=\"3.4\" fill=\"#FFFFFF\" stroke=\"#4E7966\" stroke-width=\"1.4\"/>';\n  s += '<text x=\"' + (X(339) - 8).toFixed(1) + '\" y=\"' + (Y(127.72) - 9).toFixed(1) + '\" text-anchor=\"end\" font-size=\"12\" fill=\"#25312D\">127,72 · 09/12</text>';\n  s += '<circle cx=\"' + X(99).toFixed(1) + '\" cy=\"' + Y(106.83).toFixed(1) + '\" r=\"3.4\" fill=\"#FFFFFF\" stroke=\"#4E7966\" stroke-width=\"1.4\"/>';\n  s += '<text x=\"' + (X(99) - 8).toFixed(1) + '\" y=\"' + (Y(106.83) + 18).toFixed(1) + '\" text-anchor=\"end\" font-size=\"12\" fill=\"#25312D\">106,83 · 13/04</text>';\n  s += '<circle cx=\"' + X(341).toFixed(1) + '\" cy=\"' + Y(117.34).toFixed(1) + '\" r=\"4.6\" fill=\"#173F35\"/>';\n  s += '<text x=\"' + (X(341) - 10).toFixed(1) + '\" y=\"' + (Y(117.34) - 9).toFixed(1) + '\" text-anchor=\"end\" font-size=\"14\" font-weight=\"600\" fill=\"#173F35\">117,34</text>';\n  s += '</svg>';\n  host.innerHTML = s;\n})();\n</script>",
