      "html": "<style>\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .ci { font-family: \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif; font-feature-settings: \"tnum\" 1; }\n  .ci-title { font-family: \"Segoe UI Variable Display\", \"Segoe UI Semibold\", \"Segoe UI\", system-ui, sans-serif; }\n  .tab { display: flex; align-items: center; border-bottom: 2px solid transparent; color: #76817B; font-size: 14px; }\n  .tab-on { border-bottom-color: #173F35; color: #173F35; font-weight: 600; }\n  .field { height: 40px; background: #FFFFFF; border: 1px solid rgba(37,49,45,0.14); border-radius: 8px; display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: 14px; }\n  .grid-tab { display: grid; grid-template-columns: 72px 108px 100px 96px 56px 112px 1fr 116px; align-items: center; gap: 12px; }\n  .thead { height: 40px; border-bottom: 1px solid rgba(37,49,45,0.14); }\n  .trow { height: 32px; border-bottom: 1px solid rgba(37,49,45,0.07); }\n  .trow-sel { background: #F1F4EF; }\n  .kv { height: 40px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(37,49,45,0.08); }\n</style>\n<div class=\"ci w-[1440px] h-[810px] bg-[#F7F6F0] text-[#25312D] px-[24px] py-[24px] flex flex-col overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- masthead -->\n<div class=\"h-[48px] flex items-center justify-between shrink-0\" data-kid=\"1-1\" data-name=\"masthead bar\">\n<div class=\"flex items-center gap-[16px]\" data-kid=\"1-1-1\" data-name=\"brand and page title group\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1\" data-name=\"sugarcane leaf brand icon\" fill=\"none\" height=\"30\" viewbox=\"0 0 22 30\" width=\"22\">\n<path d=\"M5 29C5 19.5 7.2 11.6 12.4 4.2\" stroke=\"#173F35\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M12.4 4.2C16.4 6.4 18.9 10.2 19.6 14.8C15.1 14.2 11.7 11.6 10.2 7.6\" stroke=\"#4E7966\"