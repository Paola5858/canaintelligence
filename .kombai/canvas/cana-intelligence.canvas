1,71%</div>\n</div>\n<div class=\"flex-1 px-[20px] flex flex-col justify-center gap-[1px]\" data-kid=\"1-3-2-1-3\" data-name=\"min stat cell\">\n<div class=\"lbl\" data-kid=\"1-3-2-1-3-1\" data-name=\"min label\">Mínimo</div>\n<div class=\"ci-title text-[22px] leading-[26px] font-semibold text-[#173F35]\" data-kid=\"1-3-2-1-3-2\" data-name=\"min value\">10,32%</div>\n</div>\n<div class=\"flex-1 px-[20px] flex flex-col justify-center gap-[1px]\" data-kid=\"1-3-2-1-4\" data-name=\"max stat cell\">\n<div class=\"lbl\" data-kid=\"1-3-2-1-4-1\" data-name=\"max label\">Máximo</div>\n<div class=\"ci-title text-[22px] leading-[26px] font-semibold text-[#173F35]\" data-kid=\"1-3-2-1-4-2\" data-name=\"max value\">13,21%</div>\n</div>\n<div class=\"flex-1 px-[20px] flex flex-col justify-center gap-[1px]\" data-kid=\"1-3-2-1-5\" data-name=\"readings stat cell\">\n<div class=\"lbl\" data-kid=\"1-3-2-1-5-1\" data-name=\"readings label\">Leituras</div>\n<div class=\"ci-title text-[22px] leading-[26px] font-semibold text-[#173F35]\" data-kid=\"1-3-2-1-5-2\" data-name=\"readings value\">903</div>\n</div>\n</div>\n<div class=\"flex gap-[16px] h-[426px]\" data-kid=\"1-3-2-2\" data-name=\"charts row wrapper\">\n<!-- série -->\n<div class=\"card w-[620px] p-[18px] flex flex-col\" data-kid=\"1-3-2-2-1\" data-name=\"daily series chart card\">\n<div class=\"flex items-start justify-between\" data-kid=\"1-3-2-2-1-1\" data-name=\"chart header\">\n<div data-kid=\"1-3-2-2-1-1-1\" data-name=\"chart title group\">\n<div class=\"text-[16px] leading-[20px] font-semibold text-[#173F35]\" data-kid=\"1-3-2-2-1-1-1-1\" data-name=\"chart title text\">Série diária</div>\n<div class=\"text-[13px] text-[#76817B] mt-[2px]\" data-kid=\"1-3-2-2-1-1-1-2\" data-name=\"chart subtitle text\">903 leituras em 342 dias corridos</div>\n</div>\n<div class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"chart unit label\">%</div>\n</div>\n<div class=\"mt-[10px]\" data-dynamic=\"true\" data-kid=\"1-3-2-2-1-2\" data-name=\"daily series line chart container\" data-reason=\"children injected via innerHTML by script that builds SVG from generated data\" id=\"seriePC\"></div>\n</div>\n<!-- distribuição -->\n<div class=\"card w-[440px] p-[18px] flex flex-col\" data-kid=\"1-3-2-2-2\" data-name=\"distribution chart card\">\n<div class=\"flex items-start justify-between\" data-kid=\"1-3-2-2-2-1\" data-name=\"chart header\">\n<div data-kid=\"1-3-2-2-2-1-1\" data-name=\"chart title group\">\n<div class=\"text-[16px] leading-[20px] font-semibold text-[#173F35]\" data-kid=\"1-3-2-2-2-1-1-1\" data-name=\"chart title text\">Distribuição</div>\n<div class=\"text-[13px] text-[#76817B] mt-[2px]\" data-kid=\"1-3-2-2-2-1-1-2\" data-name=\"chart subtitle text\">Leituras por faixa de valor · %</div>\n</div>\n<div class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"chart bin count label\">14 faixas</div>\n</div>\n<div class=\"mt-[24px] relative h-[268px]\" data-kid=\"1-3-2-2-2-2\" data-name=\"distribution chart body\">\n<div class=\"absolute inset-0 flex flex-col justify-between text-[12px] text-[#76817B]\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"chart Y-axis labels and gridlines\">\n<div class=\"flex items-center gap-[8px]\" data-kid=\"1-3-2-2-2-2-1-1\" data-name=\"top gridline row\"><span class=\"w-[26px] text-right\" data-kid=\"1-3-2-2-2-2-1-1-1\" data-name=\"top Y-axis label\">140</span><span class=\"flex-1 h-px bg-[rgba(37,49,45,0.07)]\" data-kid=\"1-3-2-2-2-2-1-1-2\" data-name=\"top gridline\"></span></div>\n<div class=\"flex items-center gap-[8px]\" data-kid=\"1-3-2-2-2-2-1-2\" data-name=\"middle gridline row\"><span class=\"w-[26px] text-right\" data-kid=\"1-3-2-2-2-2-1-2-1\" data-name=\"middle Y-axis label\">70</span><span class=\"flex-1 h-px bg-[rgba(37,49,45,0.07)]\" data-kid=\"1-3-2-2-2-2-1-2-2\" data-name=\"middle gridline\"></span></div>\n<div class=\"flex items-center gap-[8px]\" data-kid=\"1-3-2-2-2-2-1-3\" data-name=\"zero gridline row\"><span class=\"w-[26px] text-right\" data-kid=\"1-3-2-2-2-2-1-3-1\" data-name=\"zero Y-axis label\">0</span><span class=\"flex-1 h-px bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-3-2-2-2-2-1-3-2\" data-name=\"zero baseline false\"></span></div>\n</div>\n<div class=\"absolute inset-0 pl-[42px] flex items-end gap-[5px]\" data-kid=\"1-3-2-2-2-2-2\" data-name=\"bars container\">\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-1\" data-name=\"distribution bar\" style=\"height:2.9%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-2\" data-name=\"distribution bar\" style=\"height:6.5%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-3\" data-name=\"distribution bar\" style=\"height:13%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-4\" data-name=\"distribution bar\" style=\"height:24.6%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-5\" data-name=\"distribution bar\" style=\"height:42%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-6\" data-name=\"distribution bar\" style=\"height:60.9%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-7\" data-name=\"distribution bar\" style=\"height:79.7%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-8\" data-name=\"distribution bar\" style=\"height:95.7%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-9\" data-name=\"peak distribution bar\" style=\"height:100%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-10\" data-name=\"distribution bar\" style=\"height:89.9%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-11\" data-name=\"distribution bar\" style=\"height:66.7%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-12\" data-name=\"distribution bar\" style=\"height:40.6%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-13\" data-name=\"distribution bar\" style=\"height:20.3%\"></div>\n<div class=\"flex-1 rounded-t-[3px] bg-[#4E7966]\" data-kid=\"1-3-2-2-2-2-2-14\" data-name=\"distribution bar\" style=\"height:11.6%\"></div>\n</div>\n</div>\n<div class=\"mt-[10px] pl-[42px] flex justify-between text-[12px] text-[#76817B]\" data-kid=\"1-3-2-2-2-3\" data-name=\"chart X-axis labels\">\n<span data-kid=\"1-3-2-2-2-3-1\" data-name=\"X-axis label 1\">10,32</span><span data-kid=\"1-3-2-2-2-3-2\" data-name=\"X-axis label 2\">11,04</span><span data-kid=\"1-3-2-2-2-3-3\" data-name=\"X-axis label 3\">11,76</span><span data-kid=\"1-3-2-2-2-3-4\" data-name=\"X-axis label 4\">12,48</span><span data-kid=\"1-3-2-2-2-3-5\" data-name=\"X-axis label 5\">13,21</span>\n</div>\n<div class=\"mt-auto pt-[12px] border-t border-[rgba(37,49,45,0.08)] text-[12px] text-[#76817B]\" data-kid=\"1-3-2-2-2-4\" data-name=\"distribution footnote\">\n            Faixa mais frequente: 11,7% a 11,9% · 138 leituras\n          </div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"px-[24px] mt-[16px] shrink-0\" data-kid=\"1-4\" data-name=\"footer status bar section\">\n<div class=\"h-[36px] flex items-center justify-between border-t border-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-1\" data-name=\"footer status bar\">\n<div class=\"text-[12px] text-[#76817B]\" data-kid=\"1-4-1-1\" data-name=\"dataset source text\">Base_Usina_PowerBI_Final_v4.xlsx · Fato_Medicoes, Dim_Indicador, Dim_Calendario</div>\n<div class=\"flex items-center gap-[16px] text-[12px] text-[#76817B]\" data-kid=\"1-4-1-2\" data-name=\"footer warning and link group\">\n<span class=\"flex items-center gap-[6px]\" data-kid=\"1-4-1-2-1\" data-name=\"unprocessed dataset warning\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A]\" data-kid=\"1-4-1-2-1-1\" data-name=\"warning indicator dot\"></span>903 registros pendentes · 4,62%</span>\n<span class=\"flex items-center gap-[6px]\" data-kid=\"1-4-1-2-2\" data-name=\"unprocessed indicator warning\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A]\" data-kid=\"1-4-1-2-2-1\" data-name=\"warning indicator dot\"></span>1 indicador pendente</span>\n<span class=\"text-[#173F35] font-semibold underline decoration-[rgba(23,63,53,0.3)] underline-offset-[3px]\" data-kid=\"1-4-1-2-3\" data-name=\"view quality link\">Ver qualidade</span>\n</div>\n</div>\n</div>\n</div>\n<script>\n(function () {\n  const MES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];\n  const host = document.getElementById('seriePC');\n  if (!host) return;\n  const rnd = (s) => { let x = s; return () => { x = (x * 16807) % 2147483647; return (x - 1) / 2147483646; }; };\n  const r = rnd(73), start = new Date(2026, 0, 4), N = 342;\n  const data = [];\n  for (let i = 0; i < N; i++) {\n    if (r() < 0.09) { data.push(null); continue; }\n    const v = 11.72 + (r() - 0.5) * 2.1 + Math.sin(i / 30) * 0.28;\n    data.push(Math.max(10.4, Math.min(13.15, v)));\n  }\n  const W = 584, H = 330, P = { l: 36, r: 8, t: 8, b: 24 };\n  const min = 9, max = 14, iw = W - P.l - P.r, ih = H - P.t - P.b;\n  const X = (i) => P.l + iw * i / (N - 1);\n  const Y = (v) => P.t + ih * (1 - (v - min) / (max - min));\n  let s = '<svg width=\"' + W + '\" height=\"' + H + '\" viewBox=\"0 0 ' + W + ' ' + H + '\" fill=\"none\">';\n  for (let t = 9; t <= 14; t++) {\n    s += '<line x1=\"' + P.l + '\" y1=\"' + Y(t).toFixed(1) + '\" x2=\"' + (W - P.r) + '\" y2=\"' + Y(t).toFixed(1) + '\" stroke=\"rgba(37,49,45,0.07)\"/>';\n    s += '<text x=\"' + (P.l - 8) + '\" y=\"' + (Y(t) + 4).toFixed(1) + '\" text-anchor=\"end\" font-size=\"12\" fill=\"#76817B\">' + t + ',0</text>';\n  }\n  for (let m = 0; m < 12; m++) {\n    const idx = Math.round((new Date(2026, m, 1) - start) / 86400000);\n    if (idx >= 0 && idx < N) {\n      s += '<text x=\"' + X(idx).toFixed(1) + '\" y=\"' + (H - 7) + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#76817B\">' + MES[m] + '</text>';\n    }\n  }\n\n  const runs = []; let cur = [];\n  data.forEach((v, i) => { if (v === null) { if (cur.length) runs.push(cur); cur = []; } else cur.push([i, v]); });\n  if (cur.length) runs.push(cur);\n  runs.forEach((run) => {\n    const line = run.map((p, k) => (k ? 'L' : 'M') + X(p[0]).toFixed(1) + ' ' + Y(p[1]).toFixed(1)).join(' ');\n    const area = line + ' L' + X(run[run.length - 1][0]).toFixed(1) + ' ' + Y(min) + ' L' + X(run[0][0]).toFixed(1) + ' ' + Y(min) + ' Z';\n    s += '<path d=\"' + area + '\" fill=\"rgba(78,121,102,0.06)\"/>';\n    s += '<path d=\"' + line + '\" stroke=\"#4E7966\" stroke-width=\"1.1\" stroke-linejoin=\"round\"/>';\n  });\n  s += '<line x1=\"' + P.l + '\" y1=\"' + Y(min) + '\" x2=\"' + (W - P.r) + '\" y2=\"' + Y(min) + '\" stroke=\"rgba(37,49,45,0.14)\"/>';\n  host.innerHTML = s + '</svg>';\n})();\n</script>\n",
