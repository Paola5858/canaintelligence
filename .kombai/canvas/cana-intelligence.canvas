ell\">\n<div class=\"lbl\" data-kid=\"1-3-1-3-2-1\" data-name=\"status label\">Status</div>\n<div class=\"kv flex items-center gap-[6px]\" data-kid=\"1-3-1-3-2-2\" data-name=\"status value with indicator dot\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#A8B9A0]\" data-kid=\"1-3-1-3-2-2-1\" data-name=\"status indicator dot\"></span>Normalizado</div>\n</div>\n<div data-kid=\"1-3-1-3-3\" data-name=\"reading count metric cell\">\n<div class=\"lbl\" data-kid=\"1-3-1-3-3-1\" data-name=\"reading count label\">Leituras</div>\n<div class=\"kv font-semibold\" data-kid=\"1-3-1-3-3-2\" data-name=\"reading count value\">903</div>\n</div>\n<div data-kid=\"1-3-1-3-4\" data-name=\"front count metric cell\">\n<div class=\"lbl\" data-kid=\"1-3-1-3-4-1\" data-name=\"front count label\">Frentes com dado</div>\n<div class=\"kv font-semibold\" data-kid=\"1-3-1-3-4-2\" data-name=\"front count value\">7</div>\n</div>\n</div>\n<div class=\"mt-[18px] h-px bg-[rgba(37,49,45,0.08)]\" data-kid=\"1-3-1-4\" data-name=\"card horizontal divider\"></div>\n<div class=\"mt-[14px]\" data-kid=\"1-3-1-5\" data-name=\"aggregation warning section\">\n<div class=\"lbl\" data-kid=\"1-3-1-5-1\" data-name=\"aggregation label\">Agregação</div>\n<div class=\"text-[13px] leading-[18px] text-[#C17A4A] mt-[2px] flex items-start gap-[6px]\" data-kid=\"1-3-1-5-2\" data-name=\"aggregation warning message\">\n<span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A] mt-[6px] shrink-0\" data-kid=\"1-3-1-5-2-1\" data-name=\"warning indicator dot\"></span>\n<span data-kid=\"1-3-1-5-2-2\" data-name=\"warning message text\">Ponderação por TC não disponível</span>\n</div>\n</div>\n<div class=\"mt-[14px]\" data-kid=\"1-3-1-6\" data-name=\"observed range section\">\n<div class=\"lbl\" data-kid=\"1-3-1-6-1\" data-name=\"observed range label\">Faixa observada</div>\n<div class=\"kv font-semibold\" data-kid=\"1-3-1-6-2\" data-name=\"observed range value\">10,32% – 13,21%</div>\n</div>\n<div class=\"mt-[14px]\" data-kid=\"1-3-1-