      "html": "<style>\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .ci { font-family: \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, sans-serif; font-feature-settings: \"tnum\" 1; }\n  .ci-title { font-family: \"Segoe UI Variable Display\", \"Segoe UI Semibold\", \"Segoe UI\", system-ui, sans-serif; }\n  .card { background: #FFFFFF; border-radius: 24px; box-shadow: 0 1px 2px rgba(23,63,53,0.045), 0 18px 44px -26px rgba(23,63,53,0.30); }\n  .navpill { display: flex; align-items: center; height: 36px; padding: 0 16px; border-radius: 999px; font-size: 14px; color: #76817B; }\n  .navpill.on { background: #173F35; color: #FFFFFF; font-weight: 600; }\n  .field { height: 40px; background: #FBFAF6; border: 1px solid rgba(37,49,45,0.09); border-radius: 12px; display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: 14px; color: #25312D; }\n  .lbl { font-size: 12px; line-height: 16px; color: #76817B; }\n  .kv { font-size: 14px; line-height: 20px; color: #25312D; }\n  .range-row { display: grid; grid-template-columns: 92px 180px 44px 44px; align-items: center; gap: 10px; height: 42px; }\n  .track { position: relative; height: 18px; }\n  .track .rail { position: absolute; left: 0; right: 0; top: 8px; height: 2px; background: #F1EFE7; border-radius: 2px; }\n  .track .seg { position: absolute; top: 7px; height: 4px; background: #4E7966; border-radius: 4px; }\n  .track .dot { position: absolute; top: 4px; width: 10px; height: 10px; border-radius: 50%; background: #FFFFFF; border: 1.6px solid #4E7966; }\n  .mtx { display: grid; grid-template-columns: 1fr 66px 104px 76px 76px; align-items: center; height: 40px; column-gap: 16px; }\n</style>\n<div class=\"ci w-[1440px] h-[810px] bg-[#F7F6F0] text-[#25312D] overflow-hidden flex flex-col\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"px-[24px] pt-[24px] shrink-0\" data-kid=\"1-1\" data-name=\"header section\">\n<div class=\"h-[48px] flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"brand and context bar\">\n<div class=\"flex items-center gap-[14px]\" data-kid=\"1-1-1-1\" data-name=\"brand group with product name\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1-1\" data-name=\"stylized plant logo icon\" fill=\"none\" height=\"30\" viewbox=\"0 0 22 30\" width=\"22\">\n<path d=\"M5 29C5 19.5 7.2 11.6 12.4 4.2\" stroke=\"#173F35\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M12.4 4.2C16.4 6.4 18.9 10.2 19.6 14.8C15.1 14.2 11.7 11.6 10.2 7.6\" stroke=\"#4E7966\" stroke-linejoin=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M6.6 20.4C5.1 19.7 3.7 20 2.4 20.9\" stroke=\"#C17A4A\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n</svg>\n<span class=\"ci-title text-[26px] leading-[30px] font-semibold tracking-[-0.4px] text-[#173F35]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">CANA INTELLIGENCE</span>\n<span class=\"w-px h-[22px] bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-1-1-1-3\" data-name=\"brand divider line\"></span>\n<span class=\"text-[16px] leading-[22px] font-semibold text-[#25312D]\" data-kid=\"1-1-1-1-4\" data-name=\"current tab title text\">Fontes</span>\n</div>\n<div class=\"flex items-center gap-[14px] text-[13px] text-[#76817B]\" data-kid=\"1-1-1-2\" data-name=\"context metadata group\">\n<span data-kid=\"1-1-1-2-1\" data-name=\"cropping season label\">Safra 2026/2027</span>\n<span class=\"w-px h-[13px] bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-1-1-2-2\" data-name=\"context separator divider\"></span>\n<span data-kid=\"1-1-1-2-3\" data-name=\"model load timestamp text\">Carga do modelo 12/12/2026 05:12</span>\n</div>\n</div>\n<div class=\"mt-[8px] h-[44px] flex items-center\" data-kid=\"1-1-2\" data-name=\"tab navigation container\">\n<div class=\"card flex items-center gap-[2px] p-[4px] rounded-full\" data-kid=\"1-1-2-1\" data-name=\"segmented tab pill bar\">\n<span class=\"navpill\" data-kid=\"1-1-2-1-1\" data-name=\"overview tab inactive\">Visão geral</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-2\" data-name=\"evolution tab inactive\">Evolução</span>\n<span class=\"navpill on\" data-kid=\"1-1-2-1-3\" data-name=\"sources tab active\">Fontes</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-4\" data-name=\"indicators tab inactive\">Indicadores</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-5\" data-name=\"quality tab inactive\">Qualidade</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-6\" data-name=\"details tab inactive\">Detalhes</span>\n</div>\n</div>\n</div>\n<div class=\"px-[24px] mt-[16px] shrink-0\" data-kid=\"1-2\" data-name=\"filters section\">\n<div class=\"card h-[64px] flex items-center gap-[12px] px-[16px]\" data-kid=\"1-2-1\" data-name=\"filters toolbar card\">\n<div class=\"w-[150px]\" data-kid=\"1-2-1-1\" data-name=\"start date field group\">\n<div class=\"lbl\" data-kid=\"1-2-1-1-1\" data-name=\"start date field label\">Data inicial</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-1-2\" data-name=\"start date input field\"><i class=\"ti ti-calendar text-[15px] text-[#76817B]\" data-kid=\"1-2-1-1-2-1\" data-name=\"calendar icon\"></i>01/01/2026</div>\n</div>\n<div class=\"w-[150px]\" data-kid=\"1-2-1-2\" data-name=\"end date field group\">\n<div class=\"lbl\" data-kid=\"1-2-1-2-1\" data-name=\"end date field label\">Data final</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-2-2\" data-name=\"end date input field\"><i class=\"ti ti-calendar text-[15px] text-[#76817B]\" data-kid=\"1-2-1-2-2-1\" data-name=\"calendar icon\"></i>11/12/2026</div>\n</div>\n<div class=\"w-[188px]\" data-kid=\"1-2-1-3\" data-name=\"indicator field group\">\n<div class=\"lbl\" data-kid=\"1-2-1-3-1\" data-name=\"indicator field label\">Indicador</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-3-2\" data-name=\"indicator select field\">ATR<span class=\"text-[#76817B]\" data-kid=\"1-2-1-3-2-1\" data-name=\"selected indicator label text\">ATR</span><i class=\"ti ti-chevron-down ml-auto text-[15px] text-[#76817B]\" data-kid=\"1-2-1-3-2-2\" data-name=\"dropdown chevron icon\"></i></div>\n</div>\n<div class=\"w-[188px]\" data-kid=\"1-2-1-4\" data-name=\"group field group\">\n<div class=\"lbl\" data-kid=\"1-2-1-4-1\" data-name=\"group field label\">Grupo</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-4-2\" data-name=\"group select field\">Frentes de colheita<i class=\"ti ti-chevron-down ml-auto text-[15px] text-[#76817B]\" data-kid=\"1-2-1-4-2-1\" data-name=\"dropdown chevron icon\"></i></div>\n</div>\n<div class=\"ml-auto\" data-kid=\"1-2-1-5\" data-name=\"clear filters control\">\n<span class=\"h-[32px] px-[14px] rounded-full bg-[#F1EFE7] text-[13px] font-semibold text-[#25312D] flex items-center gap-[6px]\" data-kid=\"1-2-1-5-1\" data-name=\"clear filters button\"><i class=\"ti ti-filter-off text-[15px]\" data-kid=\"1-2-1-5-1-1\" data-name=\"filter off icon\"></i>Limpar filtros</span>\n</div>\n</div>\n</div>\n<div class=\"px-[24px] mt-[16px] shrink-0 h-[514px] flex gap-[16px]\" data-kid=\"1-3\" data-name=\"main content sections\">\n<!-- contrato -->\n<div class=\"card w-[300px] shrink-0 p-[18px] flex flex-col\" data-kid=\"1-3-1\" data-name=\"contract indicator card\">\n<div class=\"lbl\" data-kid=\"1-3-1-1\" data-name=\"indicator card section label\">Indicador</div>\n<div class=\"mt-[6px] h-[54px] rounded-[14px] bg-[#FBFAF6] border border-[rgba(37,49,45,0.09)] flex items-center px-[12px]\" data-kid=\"1-3-1-2\" data-name=\"indicator selector dropdown\">\n<div data-kid=\"1-3-1-2-1\" data-name=\"indicator display info\">\n<div class=\"text-[14px] font-semibold text-[#25312D] leading-[18px]\" data-kid=\"1-3-1-2-1-1\" data-name=\"selected indicator name\">ATR</div>\n<div class=\"text-[12px] text-[#76817B] leading-[16px]\" data-kid=\"1-3-1-2-1-2\" data-name=\"indicator full name subtitle\">Açúcar Tota