      "html": "<style>\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .ci { font-family: \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif; font-feature-settings: \"tnum\" 1; }\n  .ci-title { font-family: \"Segoe UI Variable Display\", \"Segoe UI Semibold\", \"Segoe UI\", system-ui, sans-serif; }\n  .tab { display: flex; align-items: center; border-bottom: 2px solid transparent; color: #76817B; font-size: 14px; }\n  .tab-on { border-bottom-color: #173F35; color: #173F35; font-weight: 600; }\n  .field { height: 40px; background: #FFFFFF; border: 1px solid rgba(37,49,45,0.14); border-radius: 8px; display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: 14px; }\n  .axrow { display: grid; grid-template-columns: 62px 1fr 58px 58px; column-gap: 10px; height: 16px; }\n  .rrow { display: grid; grid-template-columns: 62px 1fr 58px 58px; column-gap: 10px; height: 36px; align-items: center; }\n  .trow { display: grid; grid-template-columns: 1fr 80px 116px 104px 104px 84px 84px; align-items: center; gap: 8px; height: 36px; }\n  .thead { display: grid; grid-template-columns: 1fr 80px 116px 104px 104px 84px 84px; align-items: center; gap: 8px; height: 40px; }\n  .thead > span, .trow > span { white-space: nowrap; }\n</style>\n<div class=\"ci w-[1440px] h-[810px] bg-[#F7F6F0] text-[#25312D] px-[24px] py-[24px] flex flex-col overflow-hidden\" data-kid=\"1\">\n<!-- masthead -->\n<div class=\"h-[48px] flex items-center justify-between shrink-0\" data-kid=\"1-1\">\n<div class=\"flex items-center gap-[16px]\" data-kid=\"1-1-1\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1\" fill=\"none\" height=\"30\" viewbox=\"0 0 22 30\" width=\"22\">\n<path d=\"M5 29C5 19.5 7.2 11.6 12.4 4.2\" stroke=\"#173F35\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M12.4 4.2C16.4 6.4 18.9 10.2 19.6 14.8C15.1 14.2 11.7 11.6 10.2 7.6\" stroke=\"#4E7966\" stroke-linejoin=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M6.6 20.4C5.1 19.7 3.7 20 2.4 20.9\" stroke=\"#C17A4A\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n</svg>\n<span class=\"ci-title text-[28px] leading-[32px] font-semibold tracking-[-0.3px] text-[#173F35]\" data-kid=\"1-1-1-2\">CANA INTELLIGENCE</span>\n<span class=\"w-px h-[22px] bg-[rgba(37,49,45,0.18)]\" data-kid=\"1-1-1-3\"></span>\n<span class=\"text-[17px] leading-[22px] font-semibold text-[#25312D]\" data-kid=\"1-1-1-4\">Fontes</span>\n</div>\n<div class=\"flex items-center gap-[16px] text-[14px] leading-[18px] text-[#76817B]\" data-kid=\"1-1-2\">\n<span data-kid=\"1-1-2-1\">Safra 2026/2027</span>\n<span class=\"w-px h-[14px] bg-[rgba(37,49,45,0.18)]\" data-kid=\"1-1-2-2\"></span>\n<span data-kid=\"1-1-2-3\">Carga do modelo 12/12/2026 05:12</span>\n</div>\n</div>\n<!-- navegação -->\n<div class=\"h-[44px] mt-[8px] flex items-stretch gap-[28px] shrink-0 border-b border-[rgba(37,49,45,0.10)]\" data-kid=\"1-2\">\n<span class=\"tab\" data-kid=\"1-2-1\">Visão geral</span>\n<span class=\"tab\" data-kid=\"1-2-2\">Evolução</span>\n<span class=\"tab tab-on\" data-kid=\"1-2-3\">Fontes</span>\n<span class=\"tab\" data-kid=\"1-2-4\">Indicadores</span>\n<span class=\"tab\" data-kid=\"1-2-5\">Qualidade</span>\n<span class=\"tab\" data-kid=\"1-2-6\">Detalhes</span>\n</div>\n<!-- filtros -->\n<div class=\"h-[64px] mt-[16px] flex items-end justify-between shrink-0\" data-kid=\"1-3\">\n<div class=\"flex items-end gap-[16px]\" data-kid=\"1-3-1\">\n<div data-kid=\"1-3-1-1\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] mb-[6px]\" data-kid=\"1-3-1-1-1\">Data inicial</div>\n<div class=\"field w-[148px] justify-between\" data-kid=\"1-3-1-1-2\">\n<span class=\"text-[#25312D]\" data-kid=\"1-3-1-1-2-1\">01/01/2026</span>\n<i class=\"ti ti-calendar text-[16px] text-[#76817B]\" data-kid=\"1-3-1-1-2-2\"></i>\n</div>\n</div>\n<div data-kid=\"1-3-1-2\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] mb-[6px]\" data-kid=\"1-3-1-2-1\">Data final</div>\n<div class=\"field w-[148px] justify-between\" data-kid=\"1-3-1-2-2\">\n<span class=\"text-[#25312D]\" data-kid=\"1-3-1-2-2-1\">31/12/2026</span>\n<i class=\"ti ti-calendar text-[16px] text-[#76817B]\" data-kid=\"1-3-1-2-2-2\"></i>\n</div>\n</div>\n<div data-kid=\"1-3-1-3\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] mb-[6px]\" data-kid=\"1-3-1-3-1\">Fonte</div>\n<div class=\"field w-[212px] justify-between\" data-kid=\"1-3-1-3-2\">\n<span class=\"text-[#25312D]\" data-kid=\"1-3-1-3-2-1\">Todas as 8 fontes</span>\n<i class=\"ti ti-chevron-down text-[16px] text-[#76817B]\" data-kid=\"1-3-1-3-2-2\"></i>\n</div>\n</div>\n</div>\n<div class=\"field w-[148px] justify-center gap-[8px] bg-transparent cursor-pointer\" data-kid=\"1-3-2\">\n<i class=\"ti ti-arrow-back-up text-[16px] text-[#4E7966]\" data-kid=\"1-3-2-1\"></i>\n<span class=\"text-[#173F35] font-semibold\" data-kid=\"1-3-2-2\">Limpar filtros</span>\n</div>\n</div>\n<!-- conteúdo -->\n<div class=\"h-[514px] mt-[16px] flex flex-col shrink-0\" data-kid=\"1-4\">\n<!-- faixa de contexto -->\n<div class=\"h-[64px] flex items-end justify-between shrink-0\" data-kid=\"1-4-1\">\n<div class=\"flex items-end gap-[24px]\" data-kid=\"1-4-1-1\">\n<div data-kid=\"1-4-1-1-1\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] mb-[6px]\" data-kid=\"1-4-1-1-1-1\">Indicador</div>\n<div class=\"field w-[212px] justify-between\" data-kid=\"1-4-1-1-1-2\">\n<span class=\"flex items-center gap-[8px]\" data-kid=\"1-4-1-1-1-2-1\">\n<span class=\"text-[#25312D] font-semibold\" data-kid=\"1-4-1-1-1-2-1-1\">ATR</span>\n<span class=\"text-[14px] text-[#76817B]\" data-kid=\"1-4-1-1-1-2-1-2\">kg/t</span>\n</span>\n<i class=\"ti ti-chevron-down text-[16px] text-[#76817B]\" data-kid=\"1-4-1-1-1-2-2\"></i>\n</div>\n</div>\n<div class=\"pb-[9px] flex items-end gap-[24px]\" data-kid=\"1-4-1-1-2\" data-name=\"frentes and status stat group\">\n<div data-kid=\"1-4-1-1-2-1\" data-name=\"frentes count stat block\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B]\" data-kid=\"1-4-1-1-2-1-1\" data-name=\"frentes with data label\">Frentes com dado</div>\n<div class=\"text-[17px] leading-[22px] font-semibold mt-[4px]\" data-kid=\"1-4-1-1-2-1-2\" data-name=\"frentes count value\">7</div>\n</div>\n<div data-kid=\"1-4-1-1-2-2\" data-name=\"status stat block\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B]\" data-kid=\"1-4-1-1-2-2-1\" data-name=\"status label text\">Status</div>\n<div class=\"text-[17px] leading-[22px] font-semibold mt-[4px] flex items-center gap-[6px]\" data-kid=\"1-4-1-1-2-2-2\" data-name=\"status value group\">\n<span class=\"w-[6px] h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-4-1-1-2-2-2-1\" data-name=\"status indicator dot\"></span>Validado\n            </div>\n</div>\n</div>\n</div>\n<div class=\"pb-[12px] flex items-center gap-[8px] text-[14px] leading-[18px] text-[#A4653B]\" data-kid=\"1-4-1-2\">\n<i class=\"ti ti-info-circle text-[16px]\" data-kid=\"1-4-1-2-1\" data-name=\"info circle icon\"></i>\n        Ponderação por TC não disponível\n      </div>\n</div>\n<!-- painéis -->\n<div class=\"h-[434px] mt-[16px] flex gap-[16px]\" data-kid=\"1-4-2\">\n<!-- faixa observada -->\n<div class=\"w-[520px] bg-white border border-[rgba(37,49,45,0.12)] rounded-[18px] p-[16px] flex flex-col\" data-kid=\"1-4-2-1\" data-name=\"observed ATR range chart card\">\n<div class=\"shrink-0\" data-kid=\"1-4-2-1-1\" data-name=\"chart card header block\">\n<div class=\"text-[17px] leading-[22px] font-semibold\" data-kid=\"1-4-2-1-1-1\" data-name=\"chart card title text\">Faixa observada de ATR por frente</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-2-1-1-2\" data-name=\"chart card subtitle text\">mínimo e máximo observados, kg/t</div>\n</div>\n<div class=\"mt-[14px] flex-1 flex flex-col\" data-kid=\"1-4-2-1-2\" data-name=\"range chart body container\">\n<!-- eixo -->\n<div class=\"axrow shrink-0\" data-kid=\"1-4-2-1-2-1\" dat