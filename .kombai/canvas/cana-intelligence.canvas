      "html": "<style>\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .ci { font-family: \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, sans-serif; font-feature-settings: \"tnum\" 1; }\n  .ci-title { font-family: \"Segoe UI Variable Display\", \"Segoe UI Semibold\", \"Segoe UI\", system-ui, sans-serif; }\n  .card { background: #FFFFFF; border-radius: 24px; box-shadow: 0 1px 2px rgba(23,63,53,0.045), 0 18px 44px -26px rgba(23,63,53,0.30); }\n  .navpill { display: flex; align-items: center; height: 36px; padding: 0 16px; border-radius: 999px; font-size: 14px; color: #76817B; }\n  .navpill.on { background: #173F35; color: #FFFFFF; font-weight: 600; }\n  .field { height: 40px; background: #FBFAF6; border: 1px solid rgba(37,49,45,0.09); border-radius: 12px; display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: 14px; color: #25312D; }\n  .lbl { font-size: 12px; line-height: 16px; color: #76817B; }\n  .kv { font-size: 14px; line-height: 20px; color: #25312D; }\n  .frow { display: grid; grid-template-columns: 104px 1fr 62px; align-items: center; gap: 12px; height: 28px; }\n</style>\n<div class=\"ci w-[1440px] h-[810px] bg-[#F7F6F0] text-[#25312D] overflow-hidden flex flex-col\" data-kid=\"1\" data-name=\"analytics dashboard page container\">\n<div class=\"px-[24px] pt-[24px] shrink-0\" data-kid=\"1-1\" data-name=\"header region with branding and navigation\">\n<div class=\"h-[48px] flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header top row\">\n<div class=\"flex items-center gap-[14px]\" data-kid=\"1-1-1-1\" data-name=\"brand identity group\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1-1\" data-name=\"abstract leaf brand icon\" fill=\"none\" height=\"30\" viewbox=\"0 0 22 30\" width=\"22\">\n<path d=\"M5 29C5 19.5 7.2 11.6 12.4 4.2\" stroke=\"#173F35\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M12.4 4.2C16.4 6.4 18.9 10.2 19.6 14.8C15.1 14.2 11.7 11.6 10.2 7.6\" stroke=\"#4E7966\" stroke-linejoin=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M6.6 20.4C5.1 19.7 3.7 20 2.4 20.9\" stroke=\"#C17A4A\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n</svg>\n<span class=\"ci-title text-[26px] leading-[30px] font-semibold tracking-[-0.4px] text-[#173F35]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name title\">CANA INTELLIGENCE</span>\n<span class=\"w-px h-[22px] bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-1-1-1-3\" data-name=\"brand separator divider\"></span>\n<span class=\"text-[16px] leading-[22px] font-semibold text-[#25312D]\" data-kid=\"1-1-1-1-4\" data-name=\"current view label text\">Visão geral</span>\n</div>\n<div class=\"flex items-center gap-[14px] text-[13px] text-[#76817B]\" data-kid=\"1-1-1-2\" data-name=\"header metadata group\">\n<span data-kid=\"1-1-1-2-1\" data-name=\"harvest season label\">Safra 2026/2027</span>\n<span class=\"w-px h-[13px] bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-1-1-2-2\" data-name=\"metadata separator divider\"></span>\n<span data-kid=\"1-1-1-2-3\" data-name=\"model load timestamp text\">Carga do modelo 12/12/2026 05:12</span>\n</div>\n</div>\n<div class=\"mt-[8px] h-[44px] flex items-center\" data-kid=\"1-1-2\" data-name=\"tab navigation row\">\n<div class=\"card flex items-center gap-[2px] p-[4px] rounded-full\" data-kid=\"1-1-2-1\" data-name=\"segmented pill tab container\">\n<span class=\"navpill on\" data-kid=\"1-1-2-1-1\" data-name=\"active overview tab pill\">Visão geral</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-2\" data-name=\"evolution tab pill\">Evolução</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-3\" data-name=\"sources tab pill\">Fontes</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-4\" data-name=\"indicators tab pill\">Indicadores</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-5\" data-name=\"quality tab pill\">Qualidade</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-6\" data-name=\"details tab pill\">Detalhes</span>\n</div>\n</div>\n</div>\n<div class=\"px-[24px] mt-[16px] shrink-0\" data-kid=\"1-2\" data-name=\"filter bar region\">\n<div class=\"card h-[64px] flex items-center gap-[12px] px-[16px]\" data-kid=\"1-2-1\" data-name=\"filter controls card\">\n<div class=\"w-[150px]\" data-kid=\"1-2-1-1\" data-name=\"initial date input group\">\n<div class=\"lbl\" data-kid=\"1-2-1-1-1\" data-name=\"initial date field label\">Data inicial</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-1-2\" data-name=\"initial date input field\"><i class=\"ti ti-calendar text-[15px] text-[#76817B]\" data-kid=\"1-2-1-1-2-1\" data-name=\"calendar icon\"></i>01/01/2026</div>\n</div>\n<div class=\"w-[150px]\" data-kid=\"1-2-1-2\" data-name=\"final date input group\">\n<div class=\"lbl\" data-kid=\"1-2-1-2-1\" data-name=\"final date field label\">Data final</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-2-2\" data-name=\"final date input field\"><i class=\"ti ti-calendar text-[15px] text-[#76817B]\" data-kid=\"1-2-1-2-2-1\" data-name=\"calendar icon\"></i>31/12/2026</div>\n</div>\n<div class=\"w-[188px]\" data-kid=\"1-2-1-3\" data-name=\"source select group\">\n<div class=\"lbl\" data-kid=\"1-2-1-3-1\" data-name=\"source field label\">Fonte</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-3-2\" data-name=\"source dropdown field\">Todas as 8 fontes<i class=\"ti ti-chevron-down ml-auto text-[15px] text-[#76817B]\" data-kid=\"1-2-1-3-2-1\" data-name=\"dropdown chevron icon\"></i></div>\n</div>\n<div class=\"w-[204px]\" data-kid=\"1-2-1-4\" data-name=\"indicator select group\">\n<div class=\"lbl\" data-kid=\"1-2-1-4-1\" data-name=\"indicator field label\">Indicador</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-4-2\" data-name=\"indicator dropdown field\">Acidez Total<span class=\"text-[#76817B]\" data-kid=\"1-2-1-4-2-1\" data-name=\"indicator code badge text\">ACIDEZ</span><i class=\"ti ti-chevron-down ml-auto text-[15px] text-[#76817B]\" data-kid=\"1-2-1-4-2-2\" data-name=\"dropdown chevron icon\"></i></div>\n</div>\n<div class=\"ml-auto\" data-kid=\"1-2-1-5\" data-name=\"filter actions group\">\n<span class=\"h-[32px] px-[14px] rounded-full bg-[#F1EFE7] text-[13px] font-semibold text-[#25312D] inline-flex items-center gap-[6px]\" data-kid=\"1-2-1-5-1\" data-name=\"clear filters button\"><i class=\"ti ti-filter-off text-[15px]\" data-kid=\"1-2-1-5-1-1\" data-name=\"filter off icon\"></i>Limpar filtros</span>\n</div>\n</div>\n</div>\n<div class=\"px-[24px] mt-[16px] shrink-0 h-[514px] flex flex-col\" data-kid=\"1-3\" data-name=\"main dashboard content region\">\n<!-- cobertura -->\n<div class=\"card h-[88px] flex items-stretch divide-x divide-[rgba(37,49,45,0.07)] shrink-0\" data-kid=\"1-3-1\" data-name=\"coverage statistics card\">\n<div class=\"flex-1 px-[22px] flex flex-col justify-center gap-[2px]\" data-kid=\"1-3-1-1\" data-name=\"days with data stat cell\">\n<div class=\"lbl\" data-kid=\"1-3-1-1-1\" data-name=\"days with data label\">Dias com dados</div>\n<div class=\"ci-title text-[28px] leading-[32px] font-semibold tracking-[-0.4px] text-[#173F35]\" data-kid=\"1-3-1-1-2\" data-name=\"days with data value\">274</div>\n</div>\n<div class=\"flex-1 px-[22px] flex flex-col justify-center gap-[2px]\" data-kid=\"1-3-1-2\" data-name=\"validated records stat cell\">\n<div class=\"lbl\" data-kid=\"1-3-1-2-1\" data-name=\"validated records label\">Registros validados</div>\n<div class=\"ci-title text-[28px] leading-[32px] font-semibold tracking-[-0.4px] text-[#173F35]\" data-kid=\"1-3-1-2-2\" data-name=\"validated records value\">16.823</div>\n</div>\n<div class=\"flex-1 px-[22px] flex flex-col justify-center gap-[2px]\" data-kid=\"1-3-1-3\" data-name=\"indicators count stat cell\">\n<div class=\"lbl\" data-kid=\"1-3-1-3-1\" data-name=\"indicators label\">Indicadores</div>\n<div class=\"ci-title text-[28px] leading-[32px] font-semibold tracking-[-0.4px] text-[#173F35]\" data-kid=\"1-3-1-3-2\" data-name=\"indicators count value\">23</div>\n</div>\n<div class=\"flex-1 px-[22px] flex flex-col justify-center gap-[2px]\" data-kid=\"1-3-1-4\" data-name=\"sources count stat cell\">\n<div class=\"lbl\" data-kid=\"1-3-1-4-1\" data-name=\"sources label\">Fontes</div>\n<div class=\"ci-title text-[28px] leading-[32px] font-semibold tracking-[-0.4px] text-[#173F35]\" data-kid=\"1-3-1-4-2\" data-name=\"sources count value\">8</div>\n</div>\n<div class=\"flex-1 px-[22px] flex flex-col justify-center gap-[2px]\" data-kid=\"1-3-1-5\" data-name=\"last measurement stat cell\">\n<div class=\"lbl\" data-kid=\"1-3-1-5-1\" data-name=\"last measurement label\">Última medição</div>\n<div class=\"ci-title text-[28px] leading-[32px] font-semibold tracking-[-0.4px] text-[#173F35]\" data-kid=\"1-3-1-5-2\" data-name=\"last measurement date value\">11/12/2026</div>\n</div>\n</div>\n<!-- contexto do indicador -->\n<div class=\"card h-[64px] mt-[16px] flex items-stretch divide-x divide-[rgba(37,49,45,0.07)] shrink-0\" data-kid=\"1-3-2\" data-name=\"indicator context card\">\n<div class=\"w-[250px] px-[18px] flex flex-col justify-center gap-[1px]\" data-kid=\"1-3-2-1\" data-name=\"selected indicator cell\">\n<div class=\"lbl\" data-kid=\"1-3-2-1-1\" data-name=\"selected indicator label\">Indicador selecionado</div>\n<div class=\"text-[15px] font-semibold text-[#25312D]\" data-kid=\"1-3-2-1-2\" data-name=\"selected indicator name value\">Acidez Total · ACIDEZ</div>\n</div>\n<div class=\"w-[120px] px-[18px] flex flex-col justify-center gap-[1px]\" data-kid=\"1-3-2-2\" data-name=\"unit cell\">\n<div class=\"lbl\" data-kid=\"1-3-2-2-1\" data-name=\"unit label\">Unidade</div>\n<div class=\"text-[15px] font-semibold text-[#25312D]\" data-kid=\"1-3-2-2-2\" data-name=\"unit value text\">mg/L</div>\n</div>\n<div class=\"flex-1 px-[18px] flex flex-col justify-center gap-[1px]\" data-kid=\"1-3-2-3\" data-name=\"aggregation cell\">\n<div class=\"lbl\" data-kid=\"1-3-2-3-1\" data-name=\"aggregation label\">Agregação</div>\n<div class=\"text-[15px] text-[#25312D]\" data-kid=\"1-3-2-3-2\" data-name=\"aggregation value text\">Média aritmética</div>\n</div>\n<div class=\"w-[120px] px-[18px] flex flex-col justify-center gap-[1px]\" data-kid=\"1-3-2-4\" data-name=\"readings cell\">\n<div class=\"lbl\" data-kid=\"1-3-2-4-1\" data-name=\"readings label\">Leituras</div>\n<div class=\"text-[15px] font-semibold text-[#25312D]\" data-kid=\"1-3-2-4-2\" data-name=\"readings count value\">800</div>\n</div>\n<div class=\"w-[180px] px-[18px] flex flex-col justify-center gap-[1px]\" data-kid=\"1-3-2-5\" data-name=\"status cell\">\n<div class=\"lbl\" data-kid=\"1-3-2-5-1\" data-name=\"status label\">Status</div>\n<div class=\"text-[15px] flex items-center gap-[6px]\" data-kid=\"1-3-2-5-2\" data-name=\"status value indicator\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-2-5-2-1\" data-name=\"status dot indicator\"></span>Validado</div>\n</div>\n</div>\n<div class=\"mt-[16px] flex gap-[16px] h-[330px]\" data-kid=\"1-3-3\" data-name=\"charts row container\">\n<!-- cobertura por fonte -->\n<div class=\"card w-[520px] p-[18px] flex flex-col\" data-kid=\"1-3-3-1\" data-name=\"coverage by source chart card\">\n<div class=\"flex items-start justify-between\" data-kid=\"1-3-3-1-1\" data-name=\"chart header row\">\n<div data-kid=\"1-3-3-1-1-1\" data-name=\"chart title group\">\n<div class=\"text-[16px] leading-[20px] font-semibold text-[#173F35]\" data-kid=\"1-3-3-1-1-1-1\" data-name=\"chart title text\">Cobertura por fonte</div>\n<div class=\"text-[13px] text-[#76817B] mt-[2px]\" data-kid=\"1-3-3-1-1-1-2\" data-name=\"chart subtitle text\">Registros de todos os indicadores</div>\n</div>\n<span class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-3-1-1-2\" data-name=\"total records value\">19.532</span>\n</div>\n<div class=\"mt-[16px] flex-1 flex flex-col justify-between\" data-kid=\"1-3-3-1-2\" data-name=\"bars list container\">\n<div class=\"frow\" data-kid=\"1-3-3-1-2-1\" data-name=\"laboratory bar row\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"bar category label\">Laboratório</span>\n<span class=\"h-[8px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-3-1-2-1-2\" data-name=\"bar track\"><span class=\"absolute left-0 top-0 h-[8px] rounded-full bg-[#A8B9A0]\" data-kid=\"1-3-3-1-2-1-2-1\" data-name=\"bar filled segment\" style=\"width:100%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-3-1-2-1-3\" data-name=\"bar value label\">9.600</span>\n</div>\n<div class=\"frow\" data-kid=\"1-3-3-1-2-2\" data-name=\"frente 11 bar row\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-3-1-2-2-1\" data-name=\"bar category label\">Frente 11</span>\n<span class=\"h-[8px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-3-1-2-2-2\" data-name=\"bar track\"><span class=\"absolute left-0 top-0 h-[8px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-3-1-2-2-2-1\" data-name=\"bar filled segment\" style=\"width:15.6%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-3-1-2-2-3\" data-name=\"bar value label\">1.496</span>\n</div>\n<div class=\"frow\" data-kid=\"1-3-3-1-2-3\" data-name=\"frente 12 bar row\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-3-1-2-3-1\" data-name=\"bar category label\">Frente 12</span>\n<span class=\"h-[8px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-3-1-2-3-2\" data-name=\"bar track\"><span class=\"absolute left-0 top-0 h-[8px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-3-1-2-3-2-1\" data-name=\"bar filled segment\" style=\"width:15.6%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-3-1-2-3-3\" data-name=\"bar value label\">1.496</span>\n</div>\n<div class=\"frow\" data-kid=\"1-3-3-1-2-4\" data-name=\"frente 13 bar row\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-3-1-2-4-1\" data-name=\"bar category label\">Frente 13</span>\n<span class=\"h-[8px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-3-1-2-4-2\" data-name=\"bar track\"><span class=\"absolute left-0 top-0 h-[8px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-3-1-2-4-2-1\" data-name=\"bar filled segment\" style=\"width:14.5%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-3-1-2-4-3\" data-name=\"bar value label\">1.396</span>\n</div>\n<div class=\"frow\" data-kid=\"1-3-3-1-2-5\" data-name=\"frente 14 bar row\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-3-1-2-5-1\" data-name=\"bar category label\">Frente 14</span>\n<span class=\"h-[8px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-3-1-2-5-2\" data-name=\"bar track\"><span class=\"absolute left-0 top-0 h-[8px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-3-1-2-5-2-1\" data-name=\"bar filled segment\" style=\"width:14.4%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-3-1-2-5-3\" data-name=\"bar value label\">1.386</span>\n</div>\n<div class=\"frow\" data-kid=\"1-3-3-1-2-6\" data-name=\"frente 23 bar row\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-3-1-2-6-1\" data-name=\"bar category label\">Frente 23</span>\n<span class=\"h-[8px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-3-1-2-6-2\" data-name=\"bar track\"><span class=\"absolute left-0 top-0 h-[8px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-3-1-2-6-2-1\" data-name=\"bar filled segment\" style=\"width:14.4%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-3-1-2-6-3\" data-name=\"bar value label\">1.386</span>\n</div>\n<div class=\"frow\" data-kid=\"1-3-3-1-2-7\" data-name=\"frente 31 bar row\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-3-1-2-7-1\" data-name=\"bar category label\">Frente 31</span>\n<span class=\"h-[8px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-3-1-2-7-2\" data-name=\"bar track\"><span class=\"absolute left-0 top-0 h-[8px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-3-1-2-7-2-1\" data-name=\"bar filled segment\" style=\"width:14.4%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-3-1-2-7-3\" data-name=\"bar value label\">1.386</span>\n</div>\n<div class=\"frow\" data-kid=\"1-3-3-1-2-8\" data-name=\"frente 41 bar row\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-3-1-2-8-1\" data-name=\"bar category label\">Frente 41</span>\n<span class=\"h-[8px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-3-1-2-8-2\" data-name=\"bar track\"><span class=\"absolute left-0 top-0 h-[8px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-3-1-2-8-2-1\" data-name=\"bar filled segment\" style=\"width:14.4%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-3-1-2-8-3\" data-name=\"bar value label\">1.386</span>\n</div>\n</div>\n</div>\n<!-- série -->\n<div class=\"card flex-1 p-[18px] flex flex-col min-w-0\" data-kid=\"1-3-3-2\" data-name=\"daily series time-series chart card\">\n<div class=\"flex items-start justify-between\" data-kid=\"1-3-3-2-1\" data-name=\"chart header row\">\n<div data-kid=\"1-3-3-2-1-1\" data-name=\"chart title group\">\n<div class=\"text-[16px] leading-[20px] font-semibold text-[#173F35]\" data-kid=\"1-3-3-2-1-1-1\" data-name=\"chart title text\">Série diária</div>\n<div class=\"text-[13px] text-[#76817B] mt-[2px]\" data-kid=\"1-3-3-2-1-1-2\" data-name=\"chart subtitle text\">800 leituras em 236 dias · janela 01/04 a 30/11/2026</div>\n</div>\n<div class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-3-2-1-2\" data-name=\"unit badge text\">mg/L</div>\n</div>\n<div class=\"mt-[12px]\" data-dynamic=\"true\" data-kid=\"1-3-3-2-2\" data-name=\"time-series line chart container\" data-reason=\"SVG chart injected into this empty container by inline JS on load\" id=\"serieAcidez3\"></div>\n</div>\n</div>\n</div>\n<div class=\"px-[24px] mt-[16px] shrink-0\" data-kid=\"1-4\" data-name=\"footer region\">\n<div class=\"h-[36px] flex items-center justify-between border-t border-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-1\" data-name=\"footer status bar\">\n<div class=\"text-[12px] text-[#76817B]\" data-kid=\"1-4-1-1\" data-name=\"data source file reference text\">Base_Usina_PowerBI_Final_v4.xlsx · Fato_Medicoes, Dim_Indicador, Dim_Calendario</div>\n<div class=\"flex items-center gap-[16px] text-[12px] text-[#76817B]\" data-kid=\"1-4-1-2\" data-name=\"footer status indicators group\">\n<span class=\"flex items-center gap-[6px]\" data-kid=\"1-4-1-2-1\" data-name=\"pending records status item\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A]\" data-kid=\"1-4-1-2-1-1\" data-name=\"status dot indicator\"></span>903 registros pendentes · 4,62%</span>\n<span class=\"flex items-center gap-[6px]\" data-kid=\"1-4-1-2-2\" data-name=\"pending indicator status item\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A]\" data-kid=\"1-4-1-2-2-1\" data-name=\"status dot indicator\"></span>1 indicador pendente</span>\n<span class=\"text-[#173F35] font-semibold underline decoration-[rgba(23,63,53,0.3)] underline-offset-[3px]\" data-kid=\"1-4-1-2-3\" data-name=\"view quality link button\">Ver qualidade</span>\n</div>\n</div>\n</div>\n</div>\n<script>\n(function () {\n  const host = document.getElementById('serieAcidez3');\n  if (!host) return;\n  const MES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];\n  const rnd = (s) => { let x = s; return () => { x = (x * 16807) % 2147483647; return (x - 1) / 2147483646; }; };\n  const r = rnd(19), start = new Date(2026, 3, 1), N = 244;\n  const data = [];\n  for (let i = 0; i < N; i++) {\n    if (r() < 0.032) { data.push(null); continue; }\n    const v = 8.98 + (r() - 0.5) * 3.4 + Math.sin(i / 21) * 0.38;\n    data.push(Math.max(6.7, Math.min(11.3, v)));\n  }\n  const W = 840, H = 236, P = { l: 34, r: 8, t: 8, b: 24 };\n  const min = 6, max = 12, iw = W - P.l - P.r, ih = H - P.t - P.b;\n  const X = (i) => P.l + iw * i / (N - 1);\n  const Y = (v) => P.t + ih * (1 - (v - min) / (max - min));\n  let s = '<svg width=\"' + W + '\" height=\"' + H + '\" viewBox=\"0 0 ' + W + ' ' + H + '\" fill=\"none\">';\n  [6, 7, 8, 9, 10, 11, 12].forEach((t) => {\n    s += '<line x1=\"' + P.l + '\" y1=\"' + Y(t).toFixed(1) + '\" x2=\"' + (W - P.r) + '\" y2=\"' + Y(t).toFixed(1) + '\" stroke=\"rgba(37,49,45,0.07)\"/>';\n    s += '<text x=\"' + (P.l - 8) + '\" y=\"' + (Y(t) + 4).toFixed(1) + '\" text-anchor=\"end\" font-size=\"12\" fill=\"#76817B\">' + t.toFixed(1).replace('.', ',') + '</text>';\n  });\n  for (let m = 0; m < 12; m++) {\n    const idx = Math.round((new Date(2026, m, 1) - start) / 86400000);\n    if (idx >= 0 && idx < N) {\n      s += '<text x=\"' + X(idx).toFixed(1) + '\" y=\"' + (H - 7) + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#76817B\">' + MES[m] + '</text>';\n    }\n  }\n  const runs = []; let cur = [];\n  data.forEach((v, i) => { if (v === null) { if (cur.length) runs.push(cur); cur = []; } else cur.push([i, v]); });\n  if (cur.length) runs.push(cur);\n  runs.forEach((run) => {\n    const line = run.map((p, k) => (k ? 'L' : 'M') + X(p[0]).toFixed(1) + ' ' + Y(p[1]).toFixed(1)).join(' ');\n    const area = line + ' L' + X(run[run.length - 1][0]).toFixed(1) + ' ' + Y(min) + ' L' + X(run[0][0]).toFixed(1) + ' ' + Y(min) + ' Z';\n    s += '<path d=\"' + area + '\" fill=\"rgba(78,121,102,0.075)\"/>';\n    s += '<path d=\"' + line + '\" stroke=\"#4E7966\" stroke-width=\"1.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>';\n  });\n  s += '<line x1=\"' + P.l + '\" y1=\"' + Y(min) + '\" x2=\"' + (W - P.r) + '\" y2=\"' + Y(min) + '\" stroke=\"rgba(37,49,45,0.14)\"/>';\n  host.innerHTML = s + '</svg>';\n})();\n</script>\n",
