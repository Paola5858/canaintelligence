      "html": "<style>\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .ci { font-family: \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, sans-serif; font-feature-settings: \"tnum\" 1; }\n  .ci-title { font-family: \"Segoe UI Variable Display\", \"Segoe UI Semibold\", \"Segoe UI\", system-ui, sans-serif; }\n  .card { background: #FFFFFF; border-radius: 24px; box-shadow: 0 1px 2px rgba(23,63,53,0.045), 0 18px 44px -26px rgba(23,63,53,0.30); }\n  .navpill { display: flex; align-items: center; height: 36px; padding: 0 16px; border-radius: 999px; font-size: 14px; color: #76817B; }\n  .navpill.on { background: #173F35; color: #FFFFFF; font-weight: 600; }\n  .field { height: 40px; background: #FBFAF6; border: 1px solid rgba(37,49,45,0.09); border-radius: 12px; display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: 14px; color: #25312D; }\n  .lbl { font-size: 12px; line-height: 16px; color: #76817B; }\n  .kv { font-size: 14px; line-height: 20px; color: #25312D; }\n  .stat { display: flex; align-items: baseline; justify-content: space-between; height: 52px; border-bottom: 1px solid rgba(37,49,45,0.06); }\n  .pend { display: grid; grid-template-columns: 84px 72px 320px 296px 196px; column-gap: 16px; align-items: center; height: 51px; border-bottom: 1px solid rgba(37,49,45,0.06); }\n  .month { display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1; }\n</style>\n<div class=\"ci w-[1440px] h-[810px] bg-[#F7F6F0] text-[#25312D] overflow-hidden flex flex-col\" data-kid=\"1\" data-name=\"quality dashboard page layout\">\n<div class=\"px-[24px] pt-[24px] shrink-0\" data-kid=\"1-1\" data-name=\"header section with title and navigation\">\n<div class=\"h-[48px] flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"brand and context bar\">\n<div class=\"flex items-center gap-[14px]\" data-kid=\"1-1-1-1\" data-name=\"brand identity group\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1-1\" data-name=\"stylized cane plant logo icon\" fill=\"none\" height=\"30\" viewbox=\"0 0 22 30\" width=\"22\">\n<path d=\"M5 29C5 19.5 7.2 11.6 12.4 4.2\" stroke=\"#173F35\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M12.4 4.2C16.4 6.4 18.9 10.2 19.6 14.8C15.1 14.2 11.7 11.6 10.2 7.6\" stroke=\"#4E7966\" stroke-linejoin=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M6.6 20.4C5.1 19.7 3.7 20 2.4 20.9\" stroke=\"#C17A4A\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n</svg>\n<span class=\"ci-title text-[26px] leading-[30px] font-semibold tracking-[-0.4px] text-[#173F35]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">CANA INTELLIGENCE</span>\n<span class=\"w-px h-[22px] bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-1-1-1-3\" data-name=\"brand separator divider\"></span>\n<span class=\"text-[16px] leading-[22px] font-semibold text-[#25312D]\" data-kid=\"1-1-1-1-4\" data-name=\"current view label\">Qualidade</span>\n</div>\n<div class=\"flex items-center gap-[14px] text-[13px] text-[#76817B]\" data-kid=\"1-1-1-2\" data-name=\"safra and data load info\">\n<span data-kid=\"1-1-1-2-1\" data-name=\"safra season text\">Safra 2026/2027</span>\n<span class=\"w-px h-[13px] bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-1-1-2-2\" data-name=\"info separator divider\"></span>\n<span data-kid=\"1-1-1-2-3\" data-name=\"dataset load timestamp\">Carga do modelo 12/12/2026 05:12</span>\n</div>\n</div>\n<div class=\"mt-[8px] h-[44px] flex items-center\" data-kid=\"1-1-2\" data-name=\"view tab navigation row\">\n<div class=\"card flex items-center gap-[2px] p-[4px] rounded-full\" data-kid=\"1-1-2-1\" data-name=\"segmented pill navigation container\">\n<span class=\"navpill\" data-kid=\"1-1-2-1-1\" data-name=\"overview view nav pill\">Visão geral</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-2\" data-name=\"evolution view nav pill\">Evolução</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-3\" data-name=\"sources view 