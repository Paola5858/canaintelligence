      "html": "<style>\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n*{box-sizing:border-box}\nbody{margin:0}\n.ci{font-family:\"Segoe UI Variable Text\",\"Segoe UI\",system-ui,sans-serif;font-feature-settings:\"tnum\" 1;color:#25312D}\n.disp{font-family:\"Segoe UI Variable Display\",\"Segoe UI Semibold\",\"Segoe UI\",sans-serif}\n.lbl{font-size:12px;line-height:16px;color:#76817B}\n.sep{width:1px;height:11px;background:rgba(37,49,45,.16);display:inline-block}\n.dot{width:6px;height:6px;border-radius:50%;display:inline-block;flex:none}\n.ic{font-size:16px;display:inline-flex;align-items:center;justify-content:center}\n.ic i{font-size:1em;line-height:1}\n.code{font-family:Consolas,\"Cascadia Mono\",monospace;font-size:12px;line-height:16px;color:#25312D;white-space:pre}\n.btn{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 14px;border-radius:9px;border:1px solid rgba(37,49,45,.14);font-size:13px}\n.btn-primary{background:#173F35;border-color:#173F35;color:#fff;font-weight:600}\n.frow{display:flex;align-items:center;height:36px;border-top:1px solid rgba(37,49,45,.07)}\n</style>\n<div class=\"ci\" data-kid=\"1\" data-name=\"page layout container\" style=\"width:1440px;height:768px;position:relative;background:#EEF1EA;overflow:hidden\">\n<div data-kid=\"1-1\" data-name=\"overlay scrim background\" style=\"position:absolute;inset:0;background:rgba(23,63,53,.34)\"></div>\n<div data-kid=\"1-2\" data-name=\"right-side detail panel\" style=\"position:absolute;top:0;right:0;bottom:0;width:720px;background:#fff;border-radius:24px 0 0 24px;box-shadow:-30px 0 70px -34px rgba(23,63,53,.55);display:flex;flex-direction:column\">\n<!-- cabeçalho do painel -->\n<div data-kid=\"1-2-1\" data-name=\"panel header bar\" style=\"height:72px;padding:0 24px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(37,49,45,.08)\">\n<div data-kid=\"1-2-1-1\" data-name=\"panel title block\">\n<div class=\"disp\" data-kid=\"1-2-1-1-1\" data-name=\"panel title heading\" style=\"font-size:18px;line-height:22px;font-weight:600;color:#173F35\">Como chegamos aqui?</div>\n<div data-kid=\"1-2-1-1-2\" data-name=\"panel subtitle metadata\" style=\"font-size:12px;line-height:16px;color:#76817B;margin-top:2px\">ATR · 117,23 kg/t · 903 leituras em 237 dias · 7 frentes · Validado</div>\n</div>\n<span class=\"ic\" data-kid=\"1-2-1-2\" data-name=\"close panel button\" style=\"width:28px;height:28px;border-radius:7px;border:1px solid rgba(37,49,45,.12);color:#76817B\"><i class=\"ti ti-x\" data-kid=\"1-2-1-2-1\" data-name=\"close X icon\"></i></span>\n</div>\n<!-- abas -->\n<div data-kid=\"1-2-2\" data-name=\"tab navigation bar\" style=\"height:36px;padding:0 24px;display:flex;align-items:flex-end;gap:22px;border-bottom:1px solid rgba(37,49,45,.08)\">\n<span data-kid=\"1-2-2-1\" data-name=\"inactive lineage tab\" style=\"font-size:13px;color:#76817B;padding-bottom:9px\">Linhagem</span>\n<span data-kid=\"1-2-2-2\" data-name=\"active visual contract tab\" style=\"font-size:13px;font-weight:600;color:#173F35;padding-bottom:8px;border-bottom:2px solid #173F35\">Contrato do visual</span>\n<span data-kid=\"1-2-2-3\" data-name=\"inactive records tab\" style=\"font-size:13px;color:#76817B;padding-bottom:9px\">Registros</span>\n</div>\n<!-- corpo -->\n<div data-kid=\"1-2-3\" data-name=\"panel body content\" style=\"height:612px;padding:20px 24px;display:flex;flex-direction:column\">\n<!-- formula -->\n<div data-kid=\"1-2-3-1\" data-name=\"applied formula section\">\n<div class=\"lbl\" data-kid=\"1-2-3-1-1\" data-name=\"formula label\">Fórmula aplicada</div>\n<div data-kid=\"1-2-3-1-2\" data-name=\"formula code block\" style=\"margin-top:4px;background:#FBFAF6;border:1px solid rgba(37,49,45,.09);border-radius:10px;padding:8px 12px\">\n<div class=\"code\" data-kid=\"1-2-3-1-2-1\" data-name=\"formula first line code\">Media Aritmetica Nao Ponderada =</div>\n<div class=\"code\" data-kid=\"1-2-3-1-2-2\" data-name=\"formula second line code\">CALCULATE ( AVERAGE ( Fato_Medicoes[Valor] ),</div>\n<div class=\"code\" data-kid=\"1-2-3-1-2-3\" data-name=\"formula third line code\">            Dim_Indicador[Codigo] = \"ATR\" )</div>\n</div>\n</div>\n<!-- contrato de 9 campos -->\n<div data-kid=\"1-2-3-2\" data-name=\"visual contract field list\" style=\"margin-top:10px\">\n<div class=\"frow\" data-kid=\"1-2-3-2-1\" data-name=\"contract row for decision question\" style=\"border-top:none\">\n<span class=\"lbl\" data-kid=\"1-2-3-2-1-1\" data-name=\"contract row label\" style=\"width:156px;flex:none\">Pergunta de decisão</span>\n<span data-kid=\"1-2-3-2-1-2\" data-name=\"contract row value\" style=\"font-size:13px\">O ATR do período se afasta da média observada?</span>\n</div>\n<div class=\"frow\" data-kid=\"1-2-3-2-2\" data-name=\"contract row for audience and level\">\n<span class=\"lbl\" data-kid=\"1-2-3-2-2-1\" data-name=\"contract row label\" style=\"width:156px;flex:none\">Público e nível</span>\n<span data-kid=\"1-2-3-2-2-2\" data-name=\"contract row value\" style=\"font-size:13px\">Gerência · nível tático · 7 frentes</span>\n</div>\n<div class=\"frow\" data-kid=\"1-2-3-2-3\" data-name=\"contract row for period and granularity\">\n<span class=\"lbl\" data-kid=\"1-2-3-2-3-1\" data-name=\"contract row label\" style=\"width:156px;flex:none\">Período e granularidade</span>\n<span data-kid=\"1-2-3-2-3-2\" data-name=\"contract row value\" style=\"font-size:13px\">01/01–31/12/2026 · diária e consolidado do período</span>\n</div>\n<div class=\"frow\" data-kid=\"1-2-3-2-4\" data-name=\"contract row for indicator and source\">\n<span class=\"lbl\" data-kid=\"1-2-3-2-4-1\" data-name=\"contract row label\" style=\"width:156px;flex:none\">Indicador, unidade, fonte</span>\n<span data-kid=\"1-2-3-2-4-2\" data-name=\"contract row value\" style=\"font-size:13px\">ATR · kg/t · frentes de colheita</span>\n</div>\n<div class=\"frow\" data-kid=\"1-2-3-2-5\" data-name=\"contract row for aggregation method\">\n<span class=\"lbl\" data-kid=\"1-2-3-2-5-1\" data-name=\"contract row label\" style=\"width:156px;flex:none\">Agregação</span>\n<span data-kid=\"1-2-3-2-5-2\" data-name=\"contract row value\" style=\"font-size:13px\">Média aritmética não ponderada · DP diário 5,10 · n 903</span>\n</div>\n<div class=\"frow\" data-kid=\"1-2-3-2-6\" data-name=\"contract row for target and tolerance\">\n<span class=\"lbl\" data-kid=\"1-2-3-2-6-1\" data-name=\"contract row label\" style=\"width:156px;flex:none\">Meta, limite, tolerância</span>\n<span data-kid=\"1-2-3-2-6-2\" data-name=\"contract row value\" style=\"font-size:13px;color:#C17A4A\">Não definidos na fonte</span>\n</div>\n<div class=\"frow\" data-kid=\"1-2-3-2-7\" data-name=\"contract row for desired direction\">\n<span class=\"lbl\" data-kid=\"1-2-3-2-7-1\" data-name=\"contract row label\" style=\"width:156px;flex:none\">Direção desejável</span>\n<span data-kid=\"1-2-3-2-7-2\" data-name=\"contract row value\" style=\"font-size:13px\">Depende do contexto</span>\n</div>\n<div class=\"frow\" data-kid=\"1-2-3-2-8\" data-name=\"contract row for action on deviation\">\n<span class=\"lbl\" data-kid=\"1-2-3-2-8-1\" data-name=\"contract row label\" style=\"width:156px;flex:none\">Ação em desvio</span>\n<span data-kid=\"1-2-3-2-8-2\" data-name=\"contract row value\" style=\"font-size:13px\">Abrir registros da frente e do dia</span>\n</div>\n<div class=\"frow\" data-kid=\"1-2-3-2-9\" data-name=\"contract row for removed visual\">\n<span class=\"lbl\" data-kid=\"1-2-3-2-9-1\" data-name=\"contract row label\" style=\"width:156px;flex:none\">Visual removido</span>\n<span data-kid=\"1-2-3-2-9-2\" data-name=\"contract row value\" style=\"font-size:13px\">Comparativo de frentes em dot plot, movido para Frentes</span>\n</div>\n</div>\n<!-- inclusoes, exclusoes, limitacoes -->\n<div data-kid=\"1-2-3-3\" data-name=\"limitations section container\" style=\"margin-top:10px;display:flex;flex-direction:column\">\n<div data-kid=\"1-2-3-3-1\" data-name=\"inclusions row\" style=\"height:30px;display:flex;align-items:center;gap:10px;border-top:1px solid rgba(37,49,45,.07)\">\n<span class=\"lbl\" data-kid=\"1-2-3-3-1-1\" data-name=\"inclusions row label\" style=\"width:52px;flex:none\">Inclui</span>\n<span data-kid=\"1-2-3-3-1-2\" data-name=\"inclusions row value\" style=\"font-size:12px\">903 leituras de ATR em 7 frentes, de 04/01 a 11/12/2026</span>\n</div>\n<div data-kid=\"1-2-3-3-2\" data-name=\"exclusions row\" style=\"height:30px;display:flex;align-items:center;gap:10px;border-top:1px solid rgba(37,49,45,.07)\">\n<span class=\"lbl\" data-kid=\"1-2-3-3-2-1\" data-name=\"exclusions row label\" style=\"width:52px;flex:none\">Exclui</span>\n<span data-kid=\"1-2-3-3-2-2\" data-name=\"exclusions row value\" style=\"font-size:12px\">105 dias sem leitura de ATR; nenhuma linha removida da base</span>\n</div>\n<div data-kid=\"1-2-3-3-3\" data-name=\"limitations row\" style=\"height:30px;display:flex;align-items:center;gap:10px;border-top:1px solid rgba(37,49,45,.07)\">\n<span class=\"lbl\" data-kid=\"1-2-3-3-3-1\" data-name=\"limitations row label\" style=\"width:52px;flex:none\">Limita</span>\n<span data-kid=\"1-2-3-3-3-2\" data-name=\"limitations row value\" style=\"font-size:12px;color:#C17A4A\">Ponderação por TC indisponível (P_TC_01); DP sobre médias diárias; sem meta</span>\n</div>\n</div>\n<div data-kid=\"1-2-3-4\" data-name=\"footer action bar\" style=\"margin-top:auto;display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(37,49,45,.07);padding-top:10px\">\n<span data-kid=\"1-2-3-4-1\" data-name=\"authorized scope note\" style=\"font-size:12px;color:#76817B\">Recorte autorizado para o nível tático</span>\n<span data-kid=\"1-2-3-4-2\" data-name=\"view records link\" style=\"font-size:13px;font-weight:600;color:#173F35;text-decoration:underline;text-decoration-color:rgba(23,63,53,.28);text-underline-offset:3px\">Ver os 903 registros</span>\n</div>\n</div>\n<!-- rodapé -->\n<div data-kid=\"1-2-4\" data-name=\"panel footer bar\" style=\"height:48px;padding:0 24px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(37,49,45,.08)\">\n<div data-kid=\"1-2-4-1\" data-name=\"footer lineage status text\" style=\"font-size:12px;color:#76817B;display:flex;align-items:center;gap:8px\">\n<span class=\"dot\" data-kid=\"1-2-4-1-1\" data-name=\"status indicator dot\" style=\"background:#4E7966\"></span>\nOPEN_KPI_LINEAGE · ATR · filtros preservados · 13/11/2026 19:12\n</div>\n<div data-kid=\"1-2-4-2\" data-name=\"footer action buttons group\" style=\"display:flex;align-items:center;gap:8px\">\n<span class=\"btn\" data-kid=\"1-2-4-2-1\" data-name=\"export data button\"><i class=\"ti ti-download\" data-kid=\"1-2-4-2-1-1\" data-name=\"download icon\" style=\"font-size:14px\"></i>Exportar</span>\n<span class=\"btn btn-primary\" data-kid=\"1-2-4-2-2\" data-name=\"close panel primary button\">Fechar</span>\n</div>\n</div>\n</div>\n</div>",
