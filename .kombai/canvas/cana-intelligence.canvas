      "html": "<style>\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .ci { font-family: \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, sans-serif; font-feature-settings: \"tnum\" 1; }\n  .ci-title { font-family: \"Segoe UI Variable Display\", \"Segoe UI Semibold\", \"Segoe UI\", system-ui, sans-serif; }\n  .card { background: #FFFFFF; border-radius: 24px; box-shadow: 0 1px 2px rgba(23,63,53,0.045), 0 18px 44px -26px rgba(23,63,53,0.30); }\n  .navpill { display: flex; align-items: center; height: 36px; padding: 0 16px; border-radius: 999px; font-size: 14px; color: #76817B; }\n  .navpill.on { background: #173F35; color: #FFFFFF; font-weight: 600; }\n  .field { height: 40px; background: #FBFAF6; border: 1px solid rgba(37,49,45,0.09); border-radius: 12px; display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: 14px; color: #25312D; }\n  .lbl { font-size: 12px; line-height: 16px; color: #76817B; }\n  .kv { font-size: 14px; line-height: 20px; color: #25312D; }\n  .row-fonte { display: grid; grid-template-columns: 96px 1fr 56px; align-items: center; gap: 12px; height: 34px; }\n</style>\n<div class=\"ci w-[1440px] h-[810px] bg-[#F7F6F0] text-[#25312D] overflow-hidden flex flex-col\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- cabeçalho -->\n<div class=\"px-[24px] pt-[24px] shrink-0\" data-kid=\"1-1\" data-name=\"header section\">\n<div class=\"h-[48px] flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header top bar\">\n<div class=\"flex items-center gap-[14px]\" data-kid=\"1-1-1-1\" data-name=\"brand identity group\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1-1\" data-name=\"brand leaf logo icon\" fill=\"none\" height=\"30\" viewbox=\"0 0 22 30\" width=\"22\">\n<path d=\"M5 29C5 19.5 7.2 11.6 12.4 4.2\" stroke=\"#173F35\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M12.4 4.2C16.4 6.4 18.9 10.2 19.6 14.8C15.1 14.2 11.7 11.6 10.2 7.6\" stroke=\"#4E7966\" stroke-linejoin=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M6.6 20.4C5.1 19.7 3.7 20 2.4 20.9\" stroke=\"#C17A4A\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n</svg>\n<span class=\"ci-title text-[26px] leading-[30px] font-semibold tracking-[-0.4px] text-[#173F35]\" data-kid=\"1-1-1-1-2\" data-name=\"brand product name\">CANA INTELLIGENCE</span>\n<span class=\"w-px h-[22px] bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-1-1-1-3\" data-name=\"vertical separator divider\"></span>\n<span class=\"text-[16px] leading-[22px] font-semibold text-[#25312D]\" data-kid=\"1-1-1-1-4\" data-name=\"section title label\">Visão geral</span>\n</div>\n<div class=\"flex items-center gap-[14px] text-[13px] text-[#76817B]\" data-kid=\"1-1-1-2\" data-name=\"season metadata group\">\n<span data-kid=\"1-1-1-2-1\" data-name=\"season label text\">Safra 2026/2027</span>\n<span class=\"w-px h-[13px] bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-1-1-2-2\" data-name=\"vertical separator divider\"></span>\n<span data-kid=\"1-1-1-2-3\" data-name=\"model load timestamp text\">Carga do modelo 12/12/2026 05:12</span>\n</div>\n</div>\n<!-- navegação -->\n<div class=\"mt-[8px] h-[44px] flex items-center\" data-kid=\"1-1-2\" data-name=\"tab navigation bar\">\n<div class=\"card flex items-center gap-[2px] p-[4px] rounded-full\" data-kid=\"1-1-2-1\" data-name=\"tab navigation pill container\">\n<span class=\"navpill on\" data-kid=\"1-1-2-1-1\" data-name=\"active tab overview\">Visão geral</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-2\" data-name=\"inactive tab evolution\">Evolução</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-3\" data-name=\"inactive tab sources\">Fontes</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-4\" data-name=\"inactive tab indicators\">Indicadores</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-5\" data-name=\"inactive tab quality\">Qualidade</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-6\" data-name=\"inactive tab details\">Detalhes</span>\n</div>\n</div>\n</div>\n<!-- filtros -->\n<div class=\"px-[24px] mt-[16px] shrink-0\" data-kid=\"1-2\" data-name=\"filters section\">\n<div class=\"card h-[64px] flex items-center gap-[12px] px-[16px]\" data-kid=\"1-2-1\" data-name=\"filters toolbar card\">\n<div class=\"w-[150px]\" data-kid=\"1-2-1-1\" data-name=\"start date filter field\">\n<div class=\"lbl\" data-kid=\"1-2-1-1-1\" data-name=\"start date label\">Data inicial</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-1-2\" data-name=\"start date picker field\"><i class=\"ti ti-calendar text-[15px] text-[#76817B]\" data-kid=\"1-2-1-1-2-1\" data-name=\"calendar icon\"></i>01/01/2026</div>\n</div>\n<div class=\"w-[150px]\" data-kid=\"1-2-1-2\" data-name=\"end date filter field\">\n<div class=\"lbl\" data-kid=\"1-2-1-2-1\" data-name=\"end date label\">Data final</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-2-2\" data-name=\"end date picker field\"><i class=\"ti ti-calendar text-[15px] text-[#76817B]\" data-kid=\"1-2-1-2-2-1\" data-name=\"calendar icon\"></i>31/12/2026</div>\n</div>\n<div class=\"w-[188px]\" data-kid=\"1-2-1-3\" data-name=\"source filter field\">\n<div class=\"lbl\" data-kid=\"1-2-1-3-1\" data-name=\"source label\">Fonte</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-3-2\" data-name=\"source dropdown field\">Todas as 8 fontes<i class=\"ti ti-chevron-down ml-auto text-[15px] text-[#76817B]\" data-kid=\"1-2-1-3-2-1\" data-name=\"dropdown chevron icon\"></i></div>\n</div>\n<div class=\"w-[204px]\" data-kid=\"1-2-1-4\" data-name=\"indicator filter field\">\n<div class=\"lbl\" data-kid=\"1-2-1-4-1\" data-name=\"indicator label\">Indicador</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-4-2\" data-name=\"indicator dropdown field\">Acidez Total<span class=\"text-[#76817B]\" data-kid=\"1-2-1-4-2-1\" data-name=\"indicator code label\">ACIDEZ</span><i class=\"ti ti-chevron-down ml-auto text-[15px] text-[#76817B]\" data-kid=\"1-2-1-4-2-2\" data-name=\"dropdown chevron icon\"></i></div>\n</div>\n<div class=\"ml-auto\" data-kid=\"1-2-1-5\" data-name=\"clear filters button wrapper\">\n<span class=\"h-[32px] px-[14px] rounded-full bg-[#F1EFE7] text-[13px] font-semibold text-[#25312D] flex items-center gap-[6px]\" data-kid=\"1-2-1-5-1\" data-name=\"clear filters button\"><i class=\"ti ti-filter-off text-[15px]\" data-kid=\"1-2-1-5-1-1\" data-name=\"filter off icon\"></i>Limpar filtros</span>\n</div>\n</div>\n</div>\n<!-- conteúdo -->\n<div class=\"px-[24px] mt-[16px] shrink-0 h-[514px] flex flex-col\" data-kid=\"1-3\" data-name=\"main content area\">\n<!-- faixa de cobertura -->\n<div class=\"card h-[92px] flex items-stretch divide-x divide-[rgba(37,49,45,0.07)] shrink-0\" data-kid=\"1-3-1\" data-name=\"coverage stats bar\">\n<div class=\"flex-1 px-[22px] flex flex-col justify-center gap-[3px]\" data-kid=\"1-3-1-1\" data-name=\"stat card days with data\">\n<div class=\"lbl\" data-kid=\"1-3-1-1-1\" data-name=\"stat label days with data\">Dias com dados</div>\n<div class=\"ci-title text-[30px] leading-[34px] font-semibold tracking-[-0.5px] text-[#173F35]\" data-kid=\"1-3-1-1-2\" data-name=\"stat value days with data\">274</div>\n</div>\n<div class=\"flex-1 px-[22px] flex flex-col justify-center gap-[3px]\" data-kid=\"1-3-1-2\" data-name=\"stat card records validated\">\n<div class=\"lbl\" data-kid=\"1-3-1-2-1\" data-name=\"stat label records validated\">Registros validados</div>\n<div class=\"ci-title text-[30px] leading-[34px] font-semibold tracking-[-0.5px] text-[#173F35]\" data-kid=\"1-3-1-2-2\" data-name=\"stat value records validated\">16.823</div>\n</div>\n<div class=\"flex-1 px-[22px] flex flex-col justify-center gap-[3px]\" data-kid=\"1-3-1-3\" data-name=\"stat card indicators\">\n<div class=\"lbl\" data-kid=\"1-3-1-3-1\" data-name=\"stat label indicators\">Indicadores</div>\n<div class=\"ci-title text-[30px] leading-[34px] font-semibold tracking-[-0.5px] text-[#173F35]\" data-kid=\"1-3-1-3-2\" data-name=\"stat value indicators\">23</div>\n</div>\n<div class=\"flex-1 px-[22px] flex flex-col justify-center gap-[3px]\" data-kid=\"1-3-1-4\" data-name=\"stat card sources\">\n<div class=\"lbl\" data-kid=\"1-3-1-4-1\" data-name=\"stat label sources\">Fontes</div>\n<div class=\"ci-title text-[30px] leading-[34px] font-semibold tracking-[-0.5px] text-[#173F35]\" data-kid=\"1-3-1-4-2\" data-name=\"stat value sources\">8</div>\n</div>\n<div class=\"flex-1 px-[22px] flex flex-col justify-center gap-[3px]\" data-kid=\"1-3-1-5\" data-name=\"stat card last measurement\">\n<div class=\"lbl\" data-kid=\"1-3-1-5-1\" data-name=\"stat label last measurement\">Última medição</div>\n<div class=\"ci-title text-[30px] leading-[34px] font-semibold tracking-[-0.5px] text-[#173F35]\" data-kid=\"1-3-1-5-2\" data-name=\"stat value last measurement date\">11/12/2026</div>\n</div>\n</div>\n<div class=\"mt-[16px] flex gap-[16px] h-[406px]\" data-kid=\"1-3-2\" data-name=\"lower content row\">\n<!-- contrato do indicador -->\n<div class=\"card w-[300px] shrink-0 p-[18px] flex flex-col\" data-kid=\"1-3-2-1\" data-name=\"indicator detail card\">\n<div class=\"lbl\" data-kid=\"1-3-2-1-1\" data-name=\"indicator label\">Indicador</div>\n<div class=\"mt-[6px] h-[54px] rounded-[14px] bg-[#FBFAF6] border border-[rgba(37,49,45,0.09)] flex items-center px-[12px] gap-[8px]\" data-kid=\"1-3-2-1-2\" data-name=\"indicator selector field\">\n<div class=\"min-w-0\" data-kid=\"1-3-2-1-2-1\" data-name=\"indicator name group\">\n<div class=\"text-[14px] font-semibold text-[#25312D] leading-[18px]\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"indicator name text\">Acidez Total</div>\n<div class=\"text-[12px] text-[#76817B] leading-[16px]\" data-kid=\"1-3-2-1-2-1-2\" data-name=\"indicator code text\">ACIDEZ</div>\n</div>\n<i class=\"ti ti-chevron-down ml-auto text-[15px] text-[#76817B]\" data-kid=\"1-3-2-1-2-2\" data-name=\"dropdown chevron icon\"></i>\n</div>\n<div class=\"mt-[18px] grid grid-cols-2 gap-x-[12px] gap-y-[16px]\" data-kid=\"1-3-2-1-3\" data-name=\"indicator details grid\">\n<div data-kid=\"1-3-2-1-3-1\" data-name=\"field unit\">\n<div class=\"lbl\" data-kid=\"1-3-2-1-3-1-1\" data-name=\"unit label\">Unidade</div>\n<div class=\"kv font-semibold\" data-kid=\"1-3-2-1-3-1-2\" data-name=\"unit value\">mg/L</div>\n</div>\n<div data-kid=\"1-3-2-1-3-2\" data-name=\"field status\">\n<div class=\"lbl\" data-kid=\"1-3-2-1-3-2-1\" data-name=\"status label\">Status</div>\n<div class=\"kv flex items-center gap-[6px]\" data-kid=\"1-3-2-1-3-2-2\" data-name=\"status value group\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-2-1-3-2-2-1\" data-name=\"status indicator dot\"></span>Validado</div>\n</div>\n<div data-kid=\"1-3-2-1-3-3\" data-name=\"field aggregation\">\n<div class=\"lbl\" data-kid=\"1-3-2-1-3-3-1\" data-name=\"aggregation label\">Agregação</div>\n<div class=\"kv\" data-kid=\"1-3-2-1-3-3-2\" data-name=\"aggregation value\">Média aritmética</div>\n</div>\n<div data-kid=\"1-3-2-1-3-4\" data-name=\"field readings\">\n<div class=\"lbl\" data-kid=\"1-3-2-1-3-4-1\" data-name=\"readings label\">Leituras</div>\n<div class=\"kv font-semibold\" data-kid=\"1-3-2-1-3-4-2\" data-name=\"readings value\">800</div>\n</div>\n</div>\n<div class=\"mt-[18px] h-px bg-[rgba(37,49,45,0.08)]\" data-kid=\"1-3-2-1-4\" data-name=\"divider line\"></div>\n<div class=\"mt-[14px]\" data-kid=\"1-3-2-1-5\" data-name=\"field category\">\n<div class=\"lbl\" data-kid=\"1-3-2-1-5-1\" data-name=\"category label\">Categoria</div>\n<div class=\"kv\" data-kid=\"1-3-2-1-5-2\" data-name=\"category value\">Análise laboratorial</div>\n</div>\n<div class=\"mt-[14px]\" data-kid=\"1-3-2-1-6\" data-name=\"field observation window\">\n<div class=\"lbl\" data-kid=\"1-3-2-1-6-1\" data-name=\"observation window label\">Janela observada</div>\n<div class=\"kv\" data-kid=\"1-3-2-1-6-2\" data-name=\"observation window value\">01/04/2026 – 30/11/2026</div>\n</div>\n<div class=\"mt-auto flex items-center gap-[8px] text-[12px] text-[#76817B]\" data-kid=\"1-3-2-1-7\" data-name=\"measured by lab footer\">\n<i class=\"ti ti-flask text-[14px]\" data-kid=\"1-3-2-1-7-1\" data-name=\"flask icon\"></i>\n<span data-kid=\"1-3-2-1-7-2\" data-name=\"measured by lab text\">Medido por Laboratório</span>\n</div>\n</div>\n<!-- série -->\n<div class=\"card w-[684px] p-[18px] flex flex-col min-w-0\" data-kid=\"1-3-2-2\" data-name=\"daily series chart card\">\n<div class=\"flex items-start justify-between\" data-kid=\"1-3-2-2-1\" data-name=\"chart header\">\n<div data-kid=\"1-3-2-2-1-1\" data-name=\"chart title group\">\n<div class=\"text-[16px] leading-[20px] font-semibold text-[#173F35]\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"chart title text\">Série diária</div>\n<div class=\"text-[13px] text-[#76817B] mt-[2px]\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"chart subtitle text\">800 leituras em 236 dias</div>\n</div>\n<div class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-2-2-1-2\" data-name=\"chart unit label\">mg/L</div>\n</div>\n<div class=\"mt-[12px]\" data-dynamic=\"true\" data-kid=\"1-3-2-2-2\" data-name=\"charted area container\" data-reason=\"SVG chart rendered and injected by script\" id=\"serieAcidez\"></div>\n</div>\n<!-- cobertura por fonte -->\n<div class=\"card w-[376px] p-[18px] flex flex-col min-w-0\" data-kid=\"1-3-2-3\" data-name=\"coverage by source card\">\n<div class=\"flex items-start justify-between\" data-kid=\"1-3-2-3-1\" data-name=\"coverage header\">\n<div data-kid=\"1-3-2-3-1-1\" data-name=\"coverage title group\">\n<div class=\"text-[16px] leading-[20px] font-semibold text-[#173F35]\" data-kid=\"1-3-2-3-1-1-1\" data-name=\"coverage title text\">Cobertura por fonte</div>\n<div class=\"text-[13px] text-[#76817B] mt-[2px]\" data-kid=\"1-3-2-3-1-1-2\" data-name=\"coverage subtitle text\">Registros de todos os indicadores</div>\n</div>\n<span class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-2-3-1-2\" data-name=\"total records label\">19.532</span>\n</div>\n<div class=\"mt-[14px] flex-1 flex flex-col justify-between\" data-kid=\"1-3-2-3-2\" data-name=\"coverage bars list\">\n<div class=\"row-fonte\" data-kid=\"1-3-2-3-2-1\" data-name=\"source row Laboratorio\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-2-3-2-1-1\" data-name=\"source name Laboratorio\">Laboratório</span>\n<span class=\"h-[6px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-2-3-2-1-2\" data-name=\"progress bar container\"><span class=\"absolute left-0 top-0 h-[6px] rounded-full bg-[#A8B9A0]\" data-kid=\"1-3-2-3-2-1-2-1\" data-name=\"progress bar fill\" style=\"width:100%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-2-3-2-1-3\" data-name=\"source count value\">9.600</span>\n</div>\n<div class=\"row-fonte\" data-kid=\"1-3-2-3-2-2\" data-name=\"source row Frente 11\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-2-3-2-2-1\" data-name=\"source name Frente 11\">Frente 11</span>\n<span class=\"h-[6px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-2-3-2-2-2\" data-name=\"progress bar container\"><span class=\"absolute left-0 top-0 h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-2-3-2-2-2-1\" data-name=\"progress bar fill\" style=\"width:15.6%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-2-3-2-2-3\" data-name=\"source count value\">1.496</span>\n</div>\n<div class=\"row-fonte\" data-kid=\"1-3-2-3-2-3\" data-name=\"source row Frente 12\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-2-3-2-3-1\" data-name=\"source name Frente 12\">Frente 12</span>\n<span class=\"h-[6px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-2-3-2-3-2\" data-name=\"progress bar container\"><span class=\"absolute left-0 top-0 h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-2-3-2-3-2-1\" data-name=\"progress bar fill\" style=\"width:15.6%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-2-3-2-3-3\" data-name=\"source count value\">1.496</span>\n</div>\n<div class=\"row-fonte\" data-kid=\"1-3-2-3-2-4\" data-name=\"source row Frente 13\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-2-3-2-4-1\" data-name=\"source name Frente 13\">Frente 13</span>\n<span class=\"h-[6px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-2-3-2-4-2\" data-name=\"progress bar container\"><span class=\"absolute left-0 top-0 h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-2-3-2-4-2-1\" data-name=\"progress bar fill\" style=\"width:14.5%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-2-3-2-4-3\" data-name=\"source count value\">1.396</span>\n</div>\n<div class=\"row-fonte\" data-kid=\"1-3-2-3-2-5\" data-name=\"source row Frente 14\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-2-3-2-5-1\" data-name=\"source name Frente 14\">Frente 14</span>\n<span class=\"h-[6px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-2-3-2-5-2\" data-name=\"progress bar container\"><span class=\"absolute left-0 top-0 h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-2-3-2-5-2-1\" data-name=\"progress bar fill\" style=\"width:14.4%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-2-3-2-5-3\" data-name=\"source count value\">1.386</span>\n</div>\n<div class=\"row-fonte\" data-kid=\"1-3-2-3-2-6\" data-name=\"source row Frente 23\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-2-3-2-6-1\" data-name=\"source name Frente 23\">Frente 23</span>\n<span class=\"h-[6px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-2-3-2-6-2\" data-name=\"progress bar container\"><span class=\"absolute left-0 top-0 h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-2-3-2-6-2-1\" data-name=\"progress bar fill\" style=\"width:14.4%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-2-3-2-6-3\" data-name=\"source count value\">1.386</span>\n</div>\n<div class=\"row-fonte\" data-kid=\"1-3-2-3-2-7\" data-name=\"source row Frente 31\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-2-3-2-7-1\" data-name=\"source name Frente 31\">Frente 31</span>\n<span class=\"h-[6px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-2-3-2-7-2\" data-name=\"progress bar container\"><span class=\"absolute left-0 top-0 h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-2-3-2-7-2-1\" data-name=\"progress bar fill\" style=\"width:14.4%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-2-3-2-7-3\" data-name=\"source count value\">1.386</span>\n</div>\n<div class=\"row-fonte\" data-kid=\"1-3-2-3-2-8\" data-name=\"source row Frente 41\">\n<span class=\"text-[14px] text-[#25312D]\" data-kid=\"1-3-2-3-2-8-1\" data-name=\"source name Frente 41\">Frente 41</span>\n<span class=\"h-[6px] rounded-full bg-[#EFEDE5] relative\" data-kid=\"1-3-2-3-2-8-2\" data-name=\"progress bar container\"><span class=\"absolute left-0 top-0 h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-2-3-2-8-2-1\" data-name=\"progress bar fill\" style=\"width:14.4%\"></span></span>\n<span class=\"text-[14px] text-right font-semibold text-[#25312D]\" data-kid=\"1-3-2-3-2-8-3\" data-name=\"source count value\">1.386</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- rodapé -->\n<div class=\"px-[24px] mt-[16px] shrink-0\" data-kid=\"1-4\" data-name=\"footer section\">\n<div class=\"h-[36px] flex items-center justify-between border-t border-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-1\" data-name=\"footer bar\">\n<div class=\"text-[12px] text-[#76817B]\" data-kid=\"1-4-1-1\" data-name=\"data source file text\">Base_Usina_PowerBI_Final_v4.xlsx · Fato_Medicoes, Dim_Indicador, Dim_Calendario</div>\n<div class=\"flex items-center gap-[16px] text-[12px] text-[#76817B]\" data-kid=\"1-4-1-2\" data-name=\"footer status group\">\n<span class=\"flex items-center gap-[6px]\" data-kid=\"1-4-1-2-1\" data-name=\"pending records status\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A]\" data-kid=\"1-4-1-2-1-1\" data-name=\"status dot\"></span>903 registros pendentes · 4,62%</span>\n<span class=\"flex items-center gap-[6px]\" data-kid=\"1-4-1-2-2\" data-name=\"pending indicator status\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A]\" data-kid=\"1-4-1-2-2-1\" data-name=\"status dot\"></span>1 indicador pendente</span>\n<span class=\"text-[#173F35] font-semibold underline decoration-[rgba(23,63,53,0.3)] underline-offset-[3px]\" data-kid=\"1-4-1-2-3\" data-name=\"view quality link\">Ver qualidade</span>\n</div>\n</div>\n</div>\n</div>\n<script>\n(function () {\n  const host = document.getElementById('serieAcidez');\n  if (!host) return;\n\n  const W = 648, H = 300, P = { l: 34, r: 8, t: 10, b: 26 };\n  const rnd = (s) => { let x = s; return () => { x = (x * 16807) % 2147483647; return (x - 1) / 2147483646; }; };\n  const r = rnd(19);\n  const start = new Date(2026, 3, 1), N = 244;\n  const MES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];\n\n  const days = [], data = [];\n  for (let i = 0; i < N; i++) {\n    const d = new Date(start.getTime() + i * 86400000);\n    days.push(d);\n    if (r() < 0.032) { data.push(null); continue; }\n    const v = 8.98 + (r() - 0.5) * 3.4 + Math.sin(i / 21) * 0.38;\n    data.push(Math.max(6.7, Math.min(11.3, v)));\n  }\n\n  const min = 6, max = 12;\n  const iw = W - P.l - P.r, ih = H - P.t - P.b;\n  const X = (i) => P.l + iw * i / (N - 1);\n  const Y = (v) => P.t + ih * (1 - (v - min) / (max - min));\n\n  let svg = '<svg width=\"' + W + '\" height=\"' + H + '\" viewBox=\"0 0 ' + W + ' ' + H + '\" fill=\"none\">';\n  for (let t = min; t <= max; t++) {\n    const yy = Y(t);\n    svg += '<line x1=\"' + P.l + '\" y1=\"' + yy.toFixed(1) + '\" x2=\"' + (W - P.r) + '\" y2=\"' + yy.toFixed(1) + '\" stroke=\"rgba(37,49,45,0.07)\" stroke-width=\"1\"/>';\n    svg += '<text x=\"' + (P.l - 8) + '\" y=\"' + (yy + 4).toFixed(1) + '\" text-anchor=\"end\" font-size=\"12\" fill=\"#76817B\">' + t.toFixed(1).replace('.', ',') + '</text>';\n  }\n  days.forEach((d, i) => {\n    if (i === 0 || d.getDate() === 1) {\n      svg += '<text x=\"' + X(i).toFixed(1) + '\" y=\"' + (H - 7) + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#76817B\">' + MES[d.getMonth()] + '</text>';\n    }\n  });\n\n  const runs = []; let cur = [];\n  data.forEach((v, i) => { if (v === null) { if (cur.length) runs.push(cur); cur = []; } else { cur.push([i, v]); } });\n  if (cur.length) runs.push(cur);\n\n  runs.forEach((run) => {\n    const line = run.map((p, k) => (k ? 'L' : 'M') + X(p[0]).toFixed(1) + ' ' + Y(p[1]).toFixed(1)).join(' ');\n    const area = line + ' L' + X(run[run.length - 1][0]).toFixed(1) + ' ' + Y(min) + ' L' + X(run[0][0]).toFixed(1) + ' ' + Y(min) + ' Z';\n    svg += '<path d=\"' + area + '\" fill=\"rgba(78,121,102,0.075)\"/>';\n    svg += '<path d=\"' + line + '\" stroke=\"#4E7966\" stroke-width=\"1.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>';\n  });\n\n  svg += '<line x1=\"' + P.l + '\" y1=\"' + Y(min) + '\" x2=\"' + (W - P.r) + '\" y2=\"' + Y(min) + '\" stroke=\"rgba(37,49,45,0.14)\" stroke-width=\"1\"/>';\n  svg += '</svg>';\n  host.innerHTML = svg;\n})();\n</script>\n",
