        "x": 29260,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n*{box-sizing:border-box}\nbody{margin:0}\n.ci{font-family:\"Segoe UI Variable Text\",\"Segoe UI\",system-ui,sans-serif;font-feature-settings:\"tnum\" 1;color:#25312D}\n.disp{font-family:\"Segoe UI Variable Display\",\"Segoe UI Semibold\",\"Segoe UI\",sans-serif}\n.lbl{font-size:12px;line-height:16px;color:#76817B}\n.dot{width:6px;height:6px;border-radius:50%;display:inline-block;flex:none}\n.ic{font-size:16px;display:inline-flex;align-items:center;justify-content:center}\n.ic i{font-size:1em;line-height:1}\n.btn{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 16px;border-radius:9px;border:1px solid rgba(37,49,45,.14);font-size:13px}\n.btn-primary{background:#173F35;border-color:#173F35;color:#fff;font-weight:600}\n.opt{height:48px;display:flex;align-items:center;gap:12px;border:1px solid rgba(37,49,45,.12);border-radius:12px;padding:0 14px}\n.opt.on{background:#F5F8F4;border-color:#173F35}\n.radio{width:16px;height:16px;border-radius:50%;border:1.5px solid rgba(37,49,45,.30);display:flex;align-items:center;justify-content:center;flex:none}\n.radio.on{border-color:#173F35}\n.radio.on span{width:8px;height:8px;border-radius:50%;background:#173F35}\n.check{width:16px;height:16px;border-radius:4px;background:#173F35;color:#fff;display:flex;align-items:center;justify-content:center;flex:none}\n.check i{font-size:11px}\n</style>\n<div class=\"ci\" data-kid=\"1\" data-name=\"modal dialog overlay page\" style=\"width:1440px;height:810px;position:relative;background:#EEF1EA;overflow:hidden\">\n<div data-kid=\"1-1\" data-name=\"modal dark backdrop\" style=\"position:absolute;inset:0;background:rgba(23,63,53,.34)\"></div>\n<div data-kid=\"1-2\" data-name=\"modal dialog card\" style=\"position:absolute;left:360px;top:60px;width:720px;background:#fff;border-radius:20px;box-shadow:0 30px 80px -30px rgba(23,63,53,.55),0 2px 6px rgba(23,63,53,.10);padding:24px;display:flex;flex-direction:column\">\n<!-- cabeçalho -->\n<div data-kid=\"1-2-1\" data-name=\"modal header bar\" style=\"height:48px;display:flex;align-items:flex-start;justify-content:space-between\">\n<div data-kid=\"1-2-1-1\" data-name=\"modal title group\">\n<div class=\"disp\" data-kid=\"1-2-1-1-1\" data-name=\"modal title text\" style=\"font-size:17px;line-height:21px;font-weight:600;color:#173F35\">Exportar ATR</div>\n<div data-kid=\"1-2-1-1-2\" data-name=\"modal subtitle description\" style=\"font-size:12px;line-height:16px;color:#76817B;margin-top:2px\">Período, filtros e referências herdados do recorte ativo</div>\n</div>\n<span class=\"ic\" data-kid=\"1-2-1-2\" data-name=\"close button icon container\" style=\"width:28px;height:28px;border-radius:7px;border:1px solid rgba(37,49,45,.12);color:#76817B\"><i class=\"ti ti-x\" data-kid=\"1-2-1-2-1\" data-name=\"close X icon\"></i></span>\n</div>\n<!-- formato -->\n<div data-kid=\"1-2-2\" data-name=\"export format section\" style=\"margin-top:8px\">\n<div class=\"lbl\" data-kid=\"1-2-2-1\" data-name=\"format section label\" style=\"font-weight:600;color:#25312D\">Formato</div>\n<div data-kid=\"1-2-2-2\" data-name=\"format radio option list\" style=\"margin-top:6px;display:flex;flex-direction:column;gap:8px\">\n<div class=\"opt on\" data-kid=\"1-2-2-2-1\" data-name=\"Excel format radio option (selected)\">\n<span class=\"radio on\" data-kid=\"1-2-2-2-1-1\" data-name=\"selected radio button circle\"><span data-kid=\"1-2-2-2-1-1-1\" data-name=\"radio button inner dot\"></span></span>\n<div data-kid=\"1-2-2-2-1-2\" data-name=\"Excel option text group\" style=\"flex:1;min-width:0\">\n<div data-kid=\"1-2-2-2-1-2-1\" data-name=\"Excel option name\" style=\"font-size:13px;font-weight:600\">Excel</div>\n<div data-kid=\"1-2-2-2-1-2-2\" data-name=\"Excel option description\" style=\"font-size:12px;color:#76817B\">Abas Resumo, Registros e Auditoria</div>\n</div>\n<span data-kid=\"1-2-2-2-1-3\" data-name=\"Excel file extension label\" style=\"font-size:12px;color:#76817B\">.xlsx</span>\n</div>\n<div class=\"opt\" data-kid=\"1-2-2-2-2\" data-name=\"PDF format radio option\">\n<span class=\"radio\" data-kid=\"1-2-2-2-2-1\" data-name=\"unselected radio button circle\"><span data-kid=\"1-2-2-2-2-1-1\" data-name=\"radio button inner dot placeholder\"></span></span>\n<div data-kid=\"1-2-2-2-2-2\" data-name=\"PDF option text group\" style=\"flex:1;min-width:0\">\n<div data-kid=\"1-2-2-2-2-2-1\" data-name=\"PDF option name\" style=\"font-size:13px\">PDF</div>\n<div data-kid=\"1-2-2-2-2-2-2\" data-name=\"PDF option description\" style=\"font-size:12px;color:#76817B\">Resumo, gráfico e ressalvas no mesmo documento</div>\n</div>\n<span data-kid=\"1-2-2-2-2-3\" data-name=\"PDF file extension label\" style=\"font-size:12px;color:#76817B\">.pdf</span>\n</div>\n<div class=\"opt\" data-kid=\"1-2-2-2-3\" data-name=\"CSV format radio option\">\n<span class=\"radio\" data-kid=\"1-2-2-2-3-1\" data-name=\"unselected radio button circle\"><span data-kid=\"1-2-2-2-3-1-1\" data-name=\"radio button inner dot placeholder\"></span></span>\n<div data-kid=\"1-2-2-2-3-2\" data-name=\"CSV option text group\" style=\"flex:1;min-width:0\">\n<div data-kid=\"1-2-2-2-3-2-1\" data-name=\"CSV option name\" style=\"font-size:13px\">CSV</div>\n<div data-kid=\"1-2-2-2-3-2-2\" data-name=\"CSV option description\" style=\"font-size:12px;color:#76817B\">Conjunto tabular autorizado, sem abas</div>\n</div>\n<span data-kid=\"1-2-2-2-3-3\" data-name=\"CSV file extension label\" style=\"font-size:12px;color:#76817B\">.csv</span>\n</div>\n</div>\n</div>\n<!-- escopo herdado -->\n<div data-kid=\"1-2-3\" data-name=\"inherited scope section\" style=\"margin-top:14px\">\n<div class=\"lbl\" data-kid=\"1-2-3-1\" data-name=\"scope section label\" style=\"font-weight:600;color:#25312D\">Escopo herdado</div>\n<div data-kid=\"1-2-3-2\" data-name=\"scope detail grid\" style=\"margin-top:6px;display:grid;grid-template-columns:1fr 1fr;gap:10px 22px\">\n<div data-kid=\"1-2-3-2-1\" data-name=\"scope detail field group\">\n<div class=\"lbl\" data-kid=\"1-2-3-2-1-1\" data-name=\"period field label\">Período</div>\n<div data-kid=\"1-2-3-2-1-2\" data-name=\"period field value\" style=\"font-size:13px;line-height:18px;font-weight:600\">01/01/2026 – 31/12/2026</div>\n</div>\n<div data-kid=\"1-2-3-2-2\" data-name=\"granularity detail field group\">\n<div class=\"lbl\" data-kid=\"1-2-3-2-2-1\" data-name=\"granularity field label\">Granularidade</div>\n<div data-kid=\"1-2-3-2-2-2\" data-name=\"granularity field value\" style=\"font-size:13px;line-height:18px\">Diária e consolidado do período</div>\n</div>\n<div data-kid=\"1-2-3-2-3\" data-name=\"indicator source detail field group\">\n<div class=\"lbl\" data-kid=\"1-2-3-2-3-1\" data-name=\"indicator and source field label\">Indicador e fonte</div>\n<div data-kid=\"1-2-3-2-3-2\" data-name=\"indicator and source field value\" style=\"font-size:13px;line-height:18px\">ATR · kg/t · 7 frentes</div>\n</div>\n<div data-kid=\"1-2-3-2-4\" data-name=\"references detail field group\">\n<div class=\"lbl\" data-kid=\"1-2-3-2-4-1\" data-name=\"references field label\">Referências</div>\n<div data-kid=\"1-2-3-2-4-2\" data-name=\"references field warning value\" style=\"font-size:13px;line-height:18px;color:#C17A4A\">0 de 4 definidas na fonte</div>\n</div>\n<div data-kid=\"1-2-3-2-5\" data-name=\"rule version detail field group\">\n<div class=\"lbl\" data-kid=\"1-2-3-2-5-1\" data-name=\"rule version field label\">Versão da regra</div>\n<div data-kid=\"1-2-3-2-5-2\" data-name=\"rule version field value\" style=\"font-size:13px;line-height:18px\">Não informada pelo modelo</div>\n</div>\n<div data-kid=\"1-2-3-2-6\" data-name=\"effective permission detail field group\">\n<div class=\"lbl\" data-kid=\"1-2-3-2-6-1\" data-name=\"effective permission field label\">Permissão efetiva</div>\n<div data-kid=\"1-2-3-2-6-2\" data-name=\"effective permission field value\" s