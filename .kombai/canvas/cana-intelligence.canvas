      "html": "<style>\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .ci { font-family: \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif; font-feature-settings: \"tnum\" 1; }\n  .ci-title { font-family: \"Segoe UI Variable Display\", \"Segoe UI Semibold\", \"Segoe UI\", system-ui, sans-serif; }\n  .tab { display: flex; align-items: center; border-bottom: 2px solid transparent; color: #76817B; font-size: 14px; }\n  .tab-on { border-bottom-color: #173F35; color: #173F35; font-weight: 600; }\n  .field { height: 40px; background: #FFFFFF; border: 1px solid rgba(37,49,45,0.14); border-radius: 8px; display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: 14px; }\n  .prow { display: grid; align-items: center; gap: 14px; grid-template-columns: 84px 64px 1fr 1.2fr 236px; }\n</style>\n<div class=\"ci w-[1440px] h-[810px] bg-[#F7F6F0] text-[#25312D] px-[24px] py-[24px] flex flex-col overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- masthead -->\n<div class=\"h-[48px] flex items-center justify-between shrink-0\" data-kid=\"1-1\" data-name=\"masthead header bar\">\n<div class=\"flex items-center gap-[16px]\" data-kid=\"1-1-1\" data-name=\"brand identity group\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1\" data-name=\"brand logo icon\" fill=\"none\" height=\"30\" viewbox=\"0 0 22 30\" width=\"22\">\n<path d=\"M5 29C5 19.5 7.2 11.6 12.4 4.2\" stroke=\"#173F35\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M12.4 4.2C16.4 6.4 18.9 10.2 19.6 14.8C15.1 14.2 11.7 11.6 10.2 7.6\" stroke=\"#4E7966\" stroke-linejoin=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M6.6 20.4C5.1 19.7 3.7 20 2.4 20.9\" stroke=\"#C17A4A\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n</svg>\n<span class=\"ci-title text-[28px] leading-[32px] font-semibold tracking-[-0.3px] text-[#173F35]\" data-kid=\"1-1-1-2\" data-name=\"brand name headline\">CANA INTELLIGENCE</span>\n<span class=\"w-px h-[22px] bg-[rgba(37,49,45,0.18)]\" data-kid=\"1-1-1-3\" data-name=\"brand section divider\"></span>\n<span class=\"text-[17px] leading-[22px] font-semibold text-[#25312D]\" data-kid=\"1-1-1-4\" data-name=\"current section label\">Qualidade</span>\n</div>\n<div class=\"flex items-center gap-[16px] text-[14px] leading-[18px] text-[#76817B]\" data-kid=\"1-1-2\" data-name=\"header status info group\">\n<span data-dynamic=\"true\" data-kid=\"1-1-2-1\" data-name=\"harvest season label\" data-reason=\"harvest period and model load date dynamically updated\">Safra 2026/2027</span>\n<span class=\"w-px h-[14px] bg-[rgba(37,49,45,0.18)]\" data-kid=\"1-1-2-2\" data-name=\"header info divider\"></span>\n<span data-dynamic=\"true\" data-kid=\"1-1-2-3\" data-name=\"model load timestamp\" data-reason=\"model load timestamp dynamically updated\">Carga do modelo 12/12/2026 05:12</span>\n</div>\n</div>\n<!-- navegação -->\n<div class=\"h-[44px] mt-[8px] flex items-stretch gap-[28px] shrink-0 border-b border-[rgba(37,49,45,0.10)]\" data-kid=\"1-2\" data-name=\"main navigation tab bar\">\n<span class=\"tab\" data-kid=\"1-2-1\" data-name=\"Visão geral navigation tab\">Visão geral</span>\n<span class=\"tab\" data-kid=\"1-2-2\" data-name=\"Evolução navigation tab\">Evolução</span>\n<span class=\"tab\" data-kid=\"1-2-3\" data-name=\"Fontes navigation tab\">Fontes</span>\n<span class=\"tab\" data-kid=\"1-2-4\" data-name=\"Indicadores navigation tab\">Indicadores</span>\n<span class=\"tab tab-on\" data-kid=\"1-2-5\" data-name=\"Qualidade active navigation tab\">Qualidade</span>\n<span class=\"tab\" data-kid=\"1-2-6\" data-name=\"Detalhes navigation tab\">Detalhes</span>\n</div>\n<!-- filtros -->\n<div class=\"h-[64px] mt-[16px] flex items-end justify-between shrink-0\" data-kid=\"1-3\" data-name=\"filters control bar\">\n<div class=\"flex items-end gap-[16px]\" data-kid=\"1-3-1\" data-name=\"date and select filters group\">\n<div data-kid=\"1-3-1-1\" data-name=\"initial date filter\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] mb-[6px]\" data-kid=\"1-3-1-1-1\" data-name=\"initial date label\">Data inicial</div>\n<div class=\"field w-[148px] justify-between\" data-kid=\"1-3-1-1-2\" data-name=\"initial date picker field\">\n<span class=\"text-[#25312D]\" data-kid=\"1-3-1-1-2-1\" data-name=\"initial date value\">01/01/2026</span>\n<i class=\"ti ti-calendar text-[16px] text-[#76817B]\" data-kid=\"1-3-1-1-2-2\" data-name=\"calendar icon\"></i>\n</div>\n</div>\n<div data-kid=\"1-3-1-2\" data-name=\"final date filter\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] mb-[6px]\" data-kid=\"1-3-1-2-1\" data-name=\"final date label\">Data final</div>\n<div class=\"field w-[148px] justify-between\" data-kid=\"1-3-1-2-2\" data-name=\"final date picker field\">\n<span class=\"text-[#25312D]\" data-kid=\"1-3-1-2-2-1\" data-name=\"final date value\">31/12/2026</span>\n<i class=\"ti ti-calendar text-[16px] text-[#76817B]\" data-kid=\"1-3-1-2-2-2\" data-name=\"calendar icon\"></i>\n</div>\n</div>\n<div data-kid=\"1-3-1-3\" data-name=\"font select filter\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] mb-[6px]\" data-kid=\"1-3-1-3-1\" data-name=\"font filter label\">Fonte</div>\n<div class=\"field w-[188px] justify-between\" data-kid=\"1-3-1-3-2\" data-name=\"font dropdown field\">\n<span class=\"text-[#25312D]\" data-kid=\"1-3-1-3-2-1\" data-name=\"font dropdown value\">Todas as 8 fontes</span>\n<i class=\"ti ti-chevron-down text-[16px] text-[#76817B]\" data-kid=\"1-3-1-3-2-2\" data-name=\"chevron down dropdown icon\"></i>\n</div>\n</div>\n<div data-kid=\"1-3-1-4\" data-name=\"status select filter\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] mb-[6px]\" data-kid=\"1-3-1-4-1\" data-name=\"status filter label\">Status</div>\n<div class=\"field w-[196px] justify-between\" data-kid=\"1-3-1-4-2\" data-name=\"status dropdown field\">\n<span class=\"text-[#25312D]\" data-kid=\"1-3-1-4-2-1\" data-name=\"status dropdown value\">Todos os 3 status</span>\n<i class=\"ti ti-chevron-down text-[16px] text-[#76817B]\" data-kid=\"1-3-1-4-2-2\" data-name=\"chevron down dropdown icon\"></i>\n</div>\n</div>\n</div>\n<div class=\"field w-[148px] justify-center gap-[8px] bg-transparent cursor-pointer\" data-kid=\"1-3-2\" data-name=\"clear filters button\">\n<i class=\"ti ti-arrow-back-up text-[16px] text-[#4E7966]\" data-kid=\"1-3-2-1\" data-name=\"clear filters arrow icon\"></i>\n<span class=\"text-[#173F35] font-semibold\" data-kid=\"1-3-2-2\" data-name=\"clear filters label\">Limpar filtros</span>\n</div>\n</div>\n<!-- conteúdo -->\n<div class=\"h-[514px] mt-[16px] flex flex-col shrink-0\" data-kid=\"1-4\" data-name=\"main content area\">\n<!-- resumo aberto -->\n<div class=\"h-[88px] bg-white border border-[rgba(37,49,45,0.12)] rounded-[18px] flex items-stretch overflow-hidden shrink-0\" data-kid=\"1-4-1\" data-name=\"resolved summary card\">\n<div class=\"flex-1 px-[20px] flex flex-col justify-center\" data-kid=\"1-4-1-1\" data-name=\"summary metrics card\">\n<div class=\"text-[28px] leading-[32px] font-semibold tracking-[-0.2px] text-[#173F35]\" data-dynamic=\"true\" data-kid=\"1-4-1-1-1\" data-name=\"total records metric\" data-reason=\"record count dynamically fetched from data\">19.532</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-1-1-2\" data-name=\"total records label\">Registros no total</div>\n</div>\n<div class=\"w-px my-[14px] bg-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-1-2\" data-name=\"summary metric divider\"></div>\n<div class=\"flex-1 px-[20px] flex flex-col justify-center\" data-dynamic=\"true\" data-kid=\"1-4-1-3\" data-name=\"summary metrics card\" data-reason=\"dynamic summary container\">\n<div class=\"text-[28px] leading-[32px] font-semibold tracking-[-0.2px] text-[#173F35] flex items-center gap-[8px]\" data-dynamic=\"true\" data-kid=\"1-4-1-3-1\" data-name=\"pending records metric\" data-reason=\"pending record count dynamically fetched\">\n<span class=\"w-[7px] h-[7px] rounded-full bg-[#C17A4A] mt-[4px]\" data-dynamic=\"true\" data-kid=\"1-4-1-3-1-1\" data-name=\"pending status dot\" data-reason=\"status indicator dynamically updated\"></span>903\n        </div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-1-3-2\" data-name=\"pending records label\">Registros pendentes</div>\n</div>\n<div class=\"w-px my-[14px] bg-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-1-4\" data-name=\"summary metric divider\"></div>\n<div class=\"flex-1 px-[20px] flex flex-col justify-center\" data-dynamic=\"true\" data-kid=\"1-4-1-5\" data-name=\"summary metrics card\" data-reason=\"dynamic summary container\">\n<div class=\"text-[28px] leading-[32px] font-semibold tracking-[-0.2px] text-[#173F35]\" data-dynamic=\"true\" data-kid=\"1-4-1-5-1\" data-name=\"pending percentage metric\" data-reason=\"calculated dynamically from data\">4,62%</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-1-5-2\" data-name=\"pending percentage label\">Percentual da base pendente</div>\n</div>\n<div class=\"w-px my-[14px] bg-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-1-6\" data-name=\"summary metric divider\"></div>\n<div class=\"flex-1 px-[20px] flex flex-col justify-center\" data-dynamic=\"true\" data-kid=\"1-4-1-7\" data-name=\"summary metrics card\" data-reason=\"dynamic summary container\">\n<div class=\"text-[28px] leading-[32px] font-semibold tracking-[-0.2px] text-[#173F35]\" data-dynamic=\"true\" data-kid=\"1-4-1-7-1\" data-name=\"adjusted scale records count\" data-reason=\"calculated dynamically from data\">1.585</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-1-7-2\" data-name=\"adjusted scale records label\">Registros com ajuste de escala</div>\n</div>\n<div class=\"w-px my-[14px] bg-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-1-8\" data-name=\"summary metric divider\"></div>\n<div class=\"flex-1 px-[20px] flex flex-col justify-center\" data-dynamic=\"true\" data-kid=\"1-4-1-9\" data-name=\"summary metrics card\" data-reason=\"dynamic summary container\">\n<div class=\"text-[28px] leading-[32px] font-semibold tracking-[-0.2px] text-[#173F35]\" data-dynamic=\"true\" data-kid=\"1-4-1-9-1\" data-name=\"preserved exact copies count\" data-reason=\"calculated dynamically from data\">135</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-1-9-2\" data-name=\"preserved copies label\">Cópias exatas preservadas</div>\n</div>\n</div>\n<!-- faixa: cobertura mensal e status -->\n<div class=\"h-[168px] mt-[16px] flex gap-[16px] shrink-0\" data-kid=\"1-4-2\" data-name=\"monitoring bar section\">\n<div class=\"w-[896px] bg-white border border-[rgba(37,49,45,0.12)] rounded-[18px] p-[14px] flex flex-col overflow-hidden\" data-dynamic=\"true\" data-kid=\"1-4-2-1\" data-name=\"monthly coverage chart card\" data-reason=\"dynamic chart data container\">\n<div class=\"flex items-baseline justify-between shrink-0\" data-kid=\"1-4-2-1-1\" data-name=\"chart header row\">\n<div class=\"text-[17px] leading-[22px] font-semibold\" data-kid=\"1-4-2-1-1-1\" data-name=\"chart title\">Registros por mês</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B]\" data-dynamic=\"true\" data-kid=\"1-4-2-1-1-2\" data-name=\"chart summary text\" data-reason=\"summary count dynamically calculated\">19.532 registros em 2026</div>\n</div>\n<div class=\"flex-1 min-h-0 mt-[6px] relative overflow-hidden\" data-kid=\"1-4-2-1-2\" data-name=\"chart container\">\n<canvas data-dynamic=\"true\" data-kid=\"1-4-2-1-2-1\" data-name=\"monthly records bar chart\" data-reason=\"dynamically rendered by Chart.js script\" id=\"coberturaChart\"></canvas>\n</div>\n</div>\n<div class=\"w-[480px] bg-white border border-[rgba(37,49,45,0.12)] rounded-[18px] p-[14px] flex flex-col overflow-hidden\" data-dynamic=\"true\" data-kid=\"1-4-2-2\" data-name=\"status bar rows container\" data-reason=\"dynamic status bars\">\n<div class=\"flex items-baseline justify-between shrink-0\" data-kid=\"1-4-2-2-1\" data-name=\"status card header\">\n<div class=\"text-[17px] leading-[22px] font-semibold\" data-kid=\"1-4-2-2-1-1\" data-name=\"status card title\">Status de validação</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B]\" data-dynamic=\"true\" data-kid=\"1-4-2-2-1-2\" data-name=\"status count label\" data-reason=\"status count dynamically calculated\">3 status</div>\n</div>\n<div class=\"flex-1 min-h-0 mt-[10px] flex flex-col justify-center gap-[12px]\" data-dynamic=\"true\" data-kid=\"1-4-2-2-2\" data-name=\"status bar rows container\" data-reason=\"dynamic status bars\">\n<div class=\"flex items-center gap-[10px]\" data-kid=\"1-4-2-2-2-1\" data-name=\"normalized label\">\n<span class=\"w-[92px] shrink-0 text-[14px] leading-[18px] text-[#25312D]\" data-kid=\"1-4-2-2-2-1-1\" data-name=\"validated label\">Validado</span>\n<div class=\"flex-1 h-[8px] rounded-full bg-[rgba(37,49,45,0.06)] overflow-hidden\" data-kid=\"1-4-2-2-2-1-2\" data-name=\"validated progress bar track\">\n<div class=\"h-full rounded-full bg-[#4E7966]\" data-dynamic=\"true\" data-kid=\"1-4-2-2-2-1-2-1\" data-name=\"validated progress bar fill\" data-reason=\"bar width dynamically calculated from data percentage\" style=\"width:100%\"></div>\n</div>\n<span class=\"w-[60px] shrink-0 text-right text-[14px] leading-[18px] font-semibold text-[#25312D] tabular-nums\" data-dynamic=\"true\" data-kid=\"1-4-2-2-2-1-3\" data-name=\"validated count value\" data-reason=\"count dynamically calculated from data\">16.823</span>\n</div>\n<div class=\"flex items-center gap-[10px]\" data-kid=\"1-4-2-2-2-2\" data-name=\"normalized progress bar track\">\n<span class=\"w-[92px] shrink-0 text-[14px] leading-[18px] text-[#25312D]\" data-kid=\"1-4-2-2-2-2-1\" data-name=\"normalized label\">Normalizado</span>\n<div class=\"flex-1 h-[8px] rounded-full bg-[rgba(37,49,45,0.06)] overflow-hidden\" data-kid=\"1-4-2-2-2-2-2\" data-name=\"normalized progress bar track\">\n<div class=\"h-full rounded-full bg-[#A8B9A0]\" data-dynamic=\"true\" data-kid=\"1-4-2-2-2-2-2-1\" data-name=\"normalized progress bar fill\" data-reason=\"bar width dynamically calculated from data percentage\" style=\"width:10.74%\"></div>\n</div>\n<span class=\"w-[60px] shrink-0 text-right text-[14px] leading-[18px] font-semibold text-[#25312D] tabular-nums\" data-dynamic=\"true\" data-kid=\"1-4-2-2-2-2-3\" data-name=\"normalized count value\" data-reason=\"count dynamically calculated from data\">1.806</span>\n</div>\n<div class=\"flex items-center gap-[10px]\" data-dynamic=\"true\" data-kid=\"1-4-2-2-2-3\" data-name=\"normalized count value\" data-reason=\"count dynamically calculated from data\">\n<span class=\"w-[92px] shrink-0 text-[14px] leading-[18px] text-[#25312D]\" data-kid=\"1-4-2-2-2-3-1\" data-name=\"pending label\">Pendente</span>\n<div class=\"flex-1 h-[8px] rounded-full bg-[rgba(37,49,45,0.06)] overflow-hidden\" data-kid=\"1-4-2-2-2-3-2\" data-name=\"pending progress bar track\">\n<div class=\"h-full rounded-full bg-[#C17A4A]\" data-dynamic=\"true\" data-kid=\"1-4-2-2-2-3-2-1\" data-name=\"pending progress bar fill\" data-reason=\"bar width dynamically calculated from data percentage\" style=\"width:5.37%\"></div>\n</div>\n<span class=\"w-[60px] shrink-0 text-right text-[14px] leading-[18px] font-semibold text-[#25312D] tabular-nums\" data-dynamic=\"true\" data-kid=\"1-4-2-2-2-3-3\" data-name=\"pending count value\" data-reason=\"count dynamically calculated from data\">903</span>\n</div>\n</div>\n</div>\n</div>\n<!-- pendências -->\n<div class=\"h-[226px] mt-[16px] bg-white border border-[rgba(37,49,45,0.12)] rounded-[18px] p-[14px] flex flex-col shrink-0 overflow-hidden\" data-kid=\"1-4-3\" data-name=\"pendencies section card\">\n<div class=\"flex items-baseline justify-between shrink-0 h-[20px]\" data-kid=\"1-4-3-1\" data-name=\"pendencies header row\">\n<div class=\"text-[17px] leading-[22px] font-semibold\" data-kid=\"1-4-3-1-1\" data-name=\"pendencies title\">Pendências registradas</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B]\" data-kid=\"1-4-3-1-2\" data-name=\"pendencies source label\">Pendencias_Validacao</div>\n</div>\n<div class=\"prow h-[32px] mt-[6px] text-[14px] leading-[18px] font-semibold text-[#76817B] border-b border-[rgba(37,49,45,0.10)] shrink-0\" data-kid=\"1-4-3-2\" data-name=\"pendencies table header row\">\n<span data-kid=\"1-4-3-2-1\" data-name=\"pendency ID column header\">Pendência</span>\n<span data-kid=\"1-4-3-2-2\" data-name=\"indicator column header\">Indicador</span>\n<span data-kid=\"1-4-3-2-3\" data-name=\"problem column header\">Problema</span>\n<span data-kid=\"1-4-3-2-4\" data-name=\"recommended action column header\">Ação recomendada</span>\n<span data-kid=\"1-4-3-2-5\" data-name=\"situation column header\">Situação</span>\n</div>\n<div class=\"prow h-[34px] text-[14px] leading-[16px] border-b border-[rgba(37,49,45,0.06)]\" data-kid=\"1-4-3-3\" data-name=\"PC pendency row\">\n<span class=\"text-[#76817B]\" data-kid=\"1-4-3-3-1\" data-name=\"PC pendency ID\">P_PC_01</span>\n<span class=\"text-[#25312D] font-semibold\" data-kid=\"1-4-3-3-2\" data-name=\"PC indicator name\">PC</span>\n<span class=\"text-[#25312D]\" data-kid=\"1-4-3-3-3\" data-name=\"PC problem description\">Origem das escalas heterogêneas (x1, x1000, x10000)</span>\n<span class=\"text-[#25312D]\" data-kid=\"1-4-3-3-4\" data-name=\"PC recommended action\">Homologar a parametrização das frentes para enviar sinal em %</span>\n<span class=\"flex items-start gap-[6px] text-[#25312D]\" data-kid=\"1-4-3-3-5\" data-name=\"PC situation indicator\"><span class=\"w-[6px] h-[6px] mt-[5px] rounded-full bg-[#76817B] shrink-0\" data-kid=\"1-4-3-3-5-1\" data-name=\"PC situation status dot\"></span>Resolvida na Fato,<br data-kid=\"1-4-3-3-5-2\" data-name=\"situation line break\"/>aberta no legado</span>\n</div>\n<div class=\"prow h-[34px] text-[14px] leading-[16px] border-b border-[rgba(37,49,45,0.06)]\" data-kid=\"1-4-3-4\" data-name=\"ArCana pendency row\">\n<span class=\"text-[#76817B]\" data-kid=\"1-4-3-4-1\" data-name=\"ArCana pendency ID\">P_AR_01</span>\n<span class=\"text-[#25312D] font-semibold\" data-kid=\"1-4-3-4-2\" data-name=\"ArCana indicator name\">ArCana</span>\n<span class=\"text-[#25312D]\" data-kid=\"1-4-3-4-3\" data-name=\"ArCana problem description\">Variação de escala na recepção de cana</span>\n<span class=\"text-[#25312D]\" data-kid=\"1-4-3-4-4\" data-name=\"ArCana recommended action\">Ajustar a integração LIMS/SAP para gravar em escala percentual</span>\n<span class=\"flex items-start gap-[6px] text-[#25312D]\" data-kid=\"1-4-3-4-5\" data-name=\"ArCana situation indicator\"><span class=\"w-[6px] h-[6px] mt-[5px] rounded-full bg-[#76817B] shrink-0\" data-kid=\"1-4-3-4-5-1\" data-name=\"ArCana situation status dot\"></span>Resolvida na Fato,<br data-kid=\"1-4-3-4-5-2\" data-name=\"situation line break\"/>aberta no legado</span>\n</div>\n<div class=\"prow h-[34px] text-[14px] leading-[16px] border-b border-[rgba(37,49,45,0.06)]\" data-kid=\"1-4-3-5\" data-name=\"TC pendency row\">\n<span class=\"text-[#76817B]\" data-kid=\"1-4-3-5-1\" data-name=\"TC pendency ID\">P_TC_01</span>\n<span class=\"text-[#25312D] font-semibold\" data-kid=\"1-4-3-5-2\" data-name=\"TC indicator name\">TC</span>\n<span class=\"text-[#25312D]\" data-kid=\"1-4-3-5-3\" data-name=\"TC problem description\">Definição técnica e unidade do indicador não confirmadas</span>\n<span class=\"text-[#25312D]\" data-kid=\"1-4-3-5-4\" data-name=\"TC recommended action\">Confirmar com a equipe de processo a unidade e a regra de agregação</span>\n<span class=\"flex items-center gap-[6px] text-[#25312D]\" data-kid=\"1-4-3-5-5\" data-name=\"TC situation indicator\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A] shrink-0\" data-kid=\"1-4-3-5-5-1\" data-name=\"TC open status dot\"></span>Aberta</span>\n</div>\n<div class=\"prow h-[34px] text-[14px] leading-[16px]\" data-kid=\"1-4-3-6\" data-name=\"Umidade pendency row\">\n<span class=\"text-[#76817B]\" data-kid=\"1-4-3-6-1\" data-name=\"Umidade pendency ID\">P_UMB_01</span>\n<span class=\"text-[#25312D] font-semibold\" data-kid=\"1-4-3-6-2\" data-name=\"Umidade indicator name\">Umidade</span>\n<span class=\"text-[#25312D]\" data-kid=\"1-4-3-6-3\" data-name=\"Umidade problem description\">UMIDADE_LAB gravada como fração decimal 0-1</span>\n<span class=\"text-[#25312D]\" data-kid=\"1-4-3-6-4\" data-name=\"Umidade recommended action\">Configurar o formato de exibição como porcentagem no Power BI</span>\n<span class=\"flex items-center gap-[6px] text-[#25312D]\" data-kid=\"1-4-3-6-5\" data-name=\"Umidade situation indicator\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#76817B] shrink-0\" data-kid=\"1-4-3-6-5-1\" data-name=\"Umidade documented status dot\"></span>Documentada, pronta para o PBI</span>\n</div>\n</div>\n</div>\n<!-- rodapé -->\n<div class=\"h-[36px] mt-[16px] shrink-0 flex items-center justify-between border-t border-[rgba(37,49,45,0.10)] pt-[8px]\" data-kid=\"1-5\" data-name=\"footer bar\">\n<div class=\"text-[12px] leading-[16px] text-[#76817B]\" data-kid=\"1-5-1\" data-name=\"footer source attribution text\">\n      Fonte: Base_Usina_PowerBI_Final_v4.xlsx · Auditoria_Dados, Pendencias_Validacao, Resumo_Qualidade\n    </div>\n<div class=\"flex items-center gap-[16px] text-[14px] leading-[18px] text-[#76817B]\" data-kid=\"1-5-2\" data-name=\"footer action bar\">\n<span data-kid=\"1-5-2-1\" data-name=\"footer records summary text\">135 cópias exatas preservadas</span>\n<span class=\"text-[#173F35] font-semibold underline underline-offset-[3px] decoration-[#A8B9A0]\" data-kid=\"1-5-2-2\" data-name=\"view records link\">Ver registros</span>\n</div>\n</div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\"></script>\n<script>\n  const MESES = [\"jan\", \"fev\", \"mar\", \"abr\", \"mai\", \"jun\", \"jul\", \"ago\", \"set\", \"out\", \"nov\", \"dez\"];\n  const REG = [330, 385, 330, 2190, 2135, 2080, 2256, 2278, 2267, 2189, 2773, 319];\n  const DIAS = [8, 7, 8, 30, 31, 30, 30, 31, 30, 31, 30, 8];\n  const INDS = [11, 11, 11, 23, 23, 23, 23, 23, 23, 23, 23, 11];\n  const MESFULL = [\"Janeiro\",\"Fevereiro\",\"Março\",\"Abril\",\"Maio\",\"Junho\",\"Julho\",\"Agosto\",\"Setembro\",\"Outubro\",\"Novembro\",\"Dezembro\"];\n\n  new Chart(document.getElementById(\"coberturaChart\"), {\n    type: \"bar\",\n    data: {\n      labels: MESES,\n      datasets: [{\n        data: REG,\n        backgroundColor: \"#4E7966\",\n        hoverBackgroundColor: \"#173F35\",\n        borderRadius: 3,\n        borderSkipped: false,\n        categoryPercentage: 0.74,\n        barPercentage: 0.92\n      }]\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      animation: false,\n      layout: { padding: { top: 4, right: 0, bottom: 0, left: 0 } },\n      plugins: {\n        legend: { display: false },\n        tooltip: {\n          backgroundColor: \"#25312D\",\n          titleColor: \"#FFFFFF\",\n          bodyColor: \"#FFFFFF\",\n          padding: 12,\n          cornerRadius: 8,\n          displayColors: false,\n          titleFont: { size: 14, weight: \"600\", family: \"Segoe UI\" },\n          bodyFont: { size: 14, family: \"Segoe UI\" },\n          callbacks: {\n            title: (items) => MESFULL[items[0].dataIndex] + \" 2026\",\n            label: (item) => item.parsed.y.toLocaleString(\"pt-BR\") + \" registros\",\n            afterLabel: (item) => DIAS[item.dataIndex] + \" dias com dados, \" + INDS[item.dataIndex] + \" indicadores\"\n          }\n        }\n      },\n      scales: {\n        x: {\n          grid: { display: false },\n          border: { display: false },\n          ticks: { color: \"#76817B\", font: { size: 14, family: \"Segoe UI\" } }\n        },\n        y: {\n          min: 0,\n          max: 3000,\n          border: { display: false },\n          grid: { color: \"rgba(37,49,45,0.08)\", drawTicks: false },\n          ticks: {\n            color: \"#76817B\",\n            font: { size: 14, family: \"Segoe UI\" },\n            stepSize: 1500,\n            padding: 8,\n            callback: (v) => (v === 0 ? \"0\" : v.toLocaleString(\"pt-BR\"))\n          }\n        }\n      }\n    }\n  });\n</script>",
