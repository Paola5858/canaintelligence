s=\"field w-[300px] justify-between\" data-kid=\"1-5-1-1-1-2\" data-name=\"indicator selection dropdown\">\n<span class=\"flex items-center gap-[8px]\" data-kid=\"1-5-1-1-1-2-1\" data-name=\"indicator value label\">\n<span class=\"text-[#25312D] font-semibold\" data-dynamic=\"true\" data-kid=\"1-5-1-1-1-2-1-1\" data-name=\"indicator name\" data-reason=\"metric values re-render when indicator selection changes\">Acidez Total</span>\n<span class=\"text-[14px] text-[#76817B]\" data-kid=\"1-5-1-1-1-2-1-2\" data-name=\"indicator code\">ACIDEZ</span>\n</span>\n<i class=\"ti ti-chevron-down text-[16px] text-[#76817B]\" data-kid=\"1-5-1-1-1-2-2\" data-name=\"chevron down icon\"></i>\n</div>\n</div>\n<div class=\"pb-[9px] flex items-end gap-[24px]\" data-kid=\"1-5-1-1-2\" data-name=\"indicator metadata group\">\n<div data-kid=\"1-5-1-1-2-1\" data-name=\"unit field\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B]\" data-kid=\"1-5-1-1-2-1-1\" data-name=\"unit label\">Unidade</div>\n<div class=\"text-[17px] leading-[22px] font-semibold mt-[4px]\" data-kid=\"1-5-1-1-2-1-2\" data-name=\"unit value\">mg/L</div>\n</div>\n<div data-kid=\"1-5-1-1-2-2\" data-name=\"aggregation field\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] flex items-center gap-[6px]\" data-kid=\"1-5-1-1-2-2-1\" data-name=\"aggregation label with info icon\">\n              Agregação\n              <i class=\"ti ti-info-circle text-[14px] text-[#76817B]\" data-kid=\"1-5-1-1-2-2-1-1\" data-name=\"info circle icon\"></i>\n</div>\n<div class=\"text-[17px] leading-[22px] font-semibold mt-[4px]\" data-kid=\"1-5-1-1-2-2-2\" data-name=\"aggregation value\">Média aritmética</div>\n</div>\n<div data-kid=\"1-5-1-1-2-3\" data-name=\"readings field\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B]\" data-kid=\"1-5-1-1-2-3-1\" data-name=\"readings label\">Leituras</div>\n<div class=\"text-[17px] leading-[22px] font-semibold mt-[4px]\" data-kid=\"1-5-1-1-2-3-2\" data-name=\"readings value\">800<