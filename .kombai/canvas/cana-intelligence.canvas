      "html": "<style>\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .ci { font-family: \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, sans-serif; font-feature-settings: \"tnum\" 1; }\n  .ci-title { font-family: \"Segoe UI Variable Display\", \"Segoe UI Semibold\", \"Segoe UI\", system-ui, sans-serif; }\n  .card { background: #FFFFFF; border-radius: 24px; box-shadow: 0 1px 2px rgba(23,63,53,0.045), 0 18px 44px -26px rgba(23,63,53,0.30); }\n  .navpill { display: flex; align-items: center; height: 36px; padding: 0 16px; border-radius: 999px; font-size: 14px; color: #76817B; }\n  .navpill.on { background: #173F35; color: #FFFFFF; font-weight: 600; }\n  .field { height: 40px; background: #FBFAF6; border: 1px solid rgba(37,49,45,0.09); border-radius: 12px; display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: 14px; color: #25312D; }\n  .lbl { font-size: 12px; line-height: 16px; color: #76817B; }\n  .kv { font-size: 14px; line-height: 20px; color: #25312D; }\n  .cmp { display: flex; align-items: center; justify-content: space-between; height: 34px; border-bottom: 1px solid rgba(37,49,45,0.06); }\n</style>\n<div class=\"ci w-[1440px] h-[810px] bg-[#F7F6F0] text-[#25312D] overflow-hidden flex flex-col\" data-kid=\"1\" data-name=\"analysis dashboard page container\">\n<div class=\"px-[24px] pt-[24px] shrink-0\" data-kid=\"1-1\" data-name=\"dashboard header section\">\n<div class=\"h-[48px] flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header top row\">\n<div class=\"flex items-center gap-[14px]\" data-kid=\"1-1-1-1\" data-name=\"brand identity group\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1-1\" data-name=\"stylized cane leaf logo icon\" fill=\"none\" height=\"30\" viewbox=\"0 0 22 30\" width=\"22\">\n<path d=\"M5 29C5 19.5 7.2 11.6 12.4 4.2\" stroke=\"#173F35\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M12.4 4.2C16.4 6.4 18.9 10.2 19.6 14.8C15.1 14.2 11.7 11.6 10.2 7.6\" stroke=\"#4E7966\" stroke-linejoin=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M6.6 20.4C5.1 19.7 3.7 20 2.4 20.9\" stroke=\"#C17A4A\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n</svg>\n<span class=\"ci-title text-[26px] leading-[30px] font-semibold tracking-[-0.4px] text-[#173F35]\" data-kid=\"1-1-1-1-2\" data-name=\"brand title text\">CANA INTELLIGENCE</span>\n<span class=\"w-px h-[22px] bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-1-1-1-3\" data-name=\"vertical separator divider\"></span>\n<span class=\"text-[16px] leading-[22px] font-semibold text-[#25312D]\" data-kid=\"1-1-1-1-4\" data-name=\"current view name label\">Evolução</span>\n</div>\n<div class=\"flex items-center gap-[14px] text-[13px] text-[#76817B]\" data-kid=\"1-1-1-2\" data-name=\"header metadata group\">\n<span data-kid=\"1-1-1-2-1\" data-name=\"growing season label\">Safra 2026/2027</span>\n<span class=\"w-px h-[13px] bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-1-1-2-2\" data-name=\"vertical separator divider\"></span>\n<span data-kid=\"1-1-1-2-3\" data-name=\"model load timestamp text\">Carga do modelo 12/12/2026 05:12</span>\n</div>\n</div>\n<div class=\"mt-[8px] h-[44px] flex items-center\" data-kid=\"1-1-2\" data-name=\"section navigation row\">\n<div class=\"card flex items-center gap-[2px] p-[4px] rounded-full\" data-kid=\"1-1-2-1\" data-name=\"segmented tab navigation\">\n<span class=\"navpill\" data-kid=\"1-1-2-1-1\" data-name=\"overview tab\">Visão geral</span>\n<span class=\"navpill on\" data-kid=\"1-1-2-1-2\" data-name=\"evolution tab active\">Evolução</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-3\" data-name=\"sources tab\">Fontes</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-4\" data-name=\"indicators tab\">Indicadores</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-5\" data-name=\"quality tab\">Qualidade</span>\n<span class=\"navpill\" data-kid=\"1-1-2-1-6\" data-name=\"details tab\">Detalhes</span>\n</div>\n</div>\n</div>\n<div class=\"px-[24px] mt-[16px] shrink-0\" data-kid=\"1-2\" data-name=\"filter bar section\">\n<div class=\"card h-[64px] flex items-center gap-[12px] px-[16px]\" data-kid=\"1-2-1\" data-name=\"filter bar card\">\n<div class=\"w-[150px]\" data-kid=\"1-2-1-1\" data-name=\"start date field group\">\n<div class=\"lbl\" data-kid=\"1-2-1-1-1\" data-name=\"start date label\">Data inicial</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-1-2\" data-name=\"start date input field\"><i class=\"ti ti-calendar text-[15px] text-[#76817B]\" data-kid=\"1-2-1-1-2-1\" data-name=\"calendar icon\"></i>01/01/2026</div>\n</div>\n<div class=\"w-[150px]\" data-kid=\"1-2-1-2\" data-name=\"end date field group\">\n<div class=\"lbl\" data-kid=\"1-2-1-2-1\" data-name=\"end date label\">Data final</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-2-2\" data-name=\"end date input field\"><i class=\"ti ti-calendar text-[15px] text-[#76817B]\" data-kid=\"1-2-1-2-2-1\" data-name=\"calendar icon\"></i>11/12/2026</div>\n</div>\n<div class=\"w-[188px]\" data-kid=\"1-2-1-3\" data-name=\"data source field group\">\n<div class=\"lbl\" data-kid=\"1-2-1-3-1\" data-name=\"data source label\">Fonte</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-3-2\" data-name=\"source selector dropdown field\">Todas as 8 fontes<i class=\"ti ti-chevron-down ml-auto text-[15px] text-[#76817B]\" data-kid=\"1-2-1-3-2-1\" data-name=\"dropdown chevron icon\"></i></div>\n</div>\n<div class=\"w-[188px]\" data-kid=\"1-2-1-4\" data-name=\"indicator field group\">\n<div class=\"lbl\" data-kid=\"1-2-1-4-1\" data-name=\"indicator label\">Indicador</div>\n<div class=\"field mt-[2px] h-[34px] px-[10px] text-[13px]\" data-kid=\"1-2-1-4-2\" data-name=\"indicator selector dropdown field\">ATR<span class=\"text-[#76817B]\" data-kid=\"1-2-1-4-2-1\" data-name=\"indicator secondary text\">ATR</span><i class=\"ti ti-chevron-down ml-auto text-[15px] text-[#76817B]\" data-kid=\"1-2-1-4-2-2\" data-name=\"dropdown chevron icon\"></i></div>\n</div>\n<div class=\"ml-auto\" data-kid=\"1-2-1-5\" data-name=\"filter clear action area\">\n<span class=\"h-[32px] px-[14px] rounded-full bg-[#F1EFE7] text-[13px] font-semibold text-[#25312D] flex items-center gap-[6px]\" data-kid=\"1-2-1-5-1\" data-name=\"clear filters button\"><i class=\"ti ti-filter-off text-[15px]\" data-kid=\"1-2-1-5-1-1\" data-name=\"filter off icon\"></i>Limpar filtros</span>\n</div>\n</div>\n</div>\n<div class=\"px-[24px] mt-[16px] shrink-0 h-[514px] flex gap-[16px]\" data-kid=\"1-3\" data-name=\"main content section\">\n<!-- contrato -->\n<div class=\"card w-[300px] shrink-0 p-[18px] flex flex-col\" data-kid=\"1-3-1\" data-name=\"indicator contract card\">\n<div class=\"lbl\" data-kid=\"1-3-1-1\" data-name=\"contract indicator label\">Indicador</div>\n<div class=\"mt-[6px] h-[54px] rounded-[14px] bg-[#FBFAF6] border border-[rgba(37,49,45,0.09)] flex items-center px-[12px]\" data-kid=\"1-3-1-2\" data-name=\"contract indicator selector field\">\n<div data-kid=\"1-3-1-2-1\" data-name=\"contract indicator info group\">\n<div class=\"text-[14px] font-semibold text-[#25312D] leading-[18px]\" data-kid=\"1-3-1-2-1-1\" data-name=\"indicate ATR title\">ATR</div>\n<div class=\"text-[12px] text-[#76817B] leading-[16px]\" data-kid=\"1-3-1-2-1-2\" data-name=\"contract indicator full name text\">Açúcar Total Recuperável · ATR</div>\n</div>\n<i class=\"ti ti-chevron-down ml-auto text-[15px] text-[#76817B]\" data-kid=\"1-3-1-2-2\" data-name=\"dropdown chevron icon\"></i>\n</div>\n<div class=\"mt-[18px] grid grid-cols-2 gap-x-[12px] gap-y-[16px]\" data-kid=\"1-3-1-3\" data-name=\"contract key-value grid\">\n<div data-kid=\"1-3-1-3-1\" data-name=\"unit field group\">\n<div class=\"lbl\" data-kid=\"1-3-1-3-1-1\" data-name=\"unit label\">Unidade</div>\n<div class=\"kv font-semibold\" data-kid=\"1-3-1-3-1-2\" data-name=\"unit value text\">kg/t</div>\n</div>\n<div data-kid=\"1-3-1-3-2\" data-name=\"status field group\">\n<div class=\"lbl\" data-kid=\"1-3-1-3-2-1\" data-name=\"status label\">Status</div>\n<div class=\"kv flex items-center gap-[6px]\" data-kid=\"1-3-1-3-2-2\" data-name=\"validated status group\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-3-1-3-2-2-1\" data-name=\"green status dot\"></span>Validado</div>\n</div>\n<div data-kid=\"1-3-1-3-3\" data-name=\"readings field group\">\n<div class=\"lbl\" data-kid=\"1-3-1-3-3-1\" data-name=\"readings label\">Leituras</div>\n<div class=\"kv font-semibold\" data-kid=\"1-3-1-3-3-2\" data-name=\"readings count value\">903</div>\n</div>\n<div data-kid=\"1-3-1-3-4\" data-name=\"fronts with data field group\">\n<div class=\"lbl\" data-kid=\"1-3-1-3-4-1\" data-name=\"fronts with data label\">Frentes com dado</div>\n<div class=\"kv font-semibold\" data-kid=\"1-3-1-3-4-2\" data-name=\"fronts with data value\">7</div>\n</div>\n</div>\n<div class=\"mt-[18px] h-px bg-[rgba(37,49,45,0.08)]\" data-kid=\"1-3-1-4\" data-name=\"card divider line\"></div>\n<div class=\"mt-[14px]\" data-kid=\"1-3-1-5\" data-name=\"aggregation field group\">\n<div class=\"lbl\" data-kid=\"1-3-1-5-1\" data-name=\"aggregation label\">Agregação</div>\n<div class=\"text-[13px] leading-[18px] text-[#C17A4A] mt-[2px] flex items-start gap-[6px]\" data-kid=\"1-3-1-5-2\" data-name=\"aggregation warning group\">\n<span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A] mt-[6px] shrink-0\" data-kid=\"1-3-1-5-2-1\" data-name=\"orange warning dot\"></span>\n<span data-kid=\"1-3-1-5-2-2\" data-name=\"aggregation warning text\">Ponderação por TC não disponível</span>\n</div>\n</div>\n<div class=\"mt-[14px]\" data-kid=\"1-3-1-6\" data-name=\"category field group\">\n<div class=\"lbl\" data-kid=\"1-3-1-6-1\" data-name=\"category label\">Categoria</div>\n<div class=\"kv\" data-kid=\"1-3-1-6-2\" data-name=\"category value text\">Qualidade da cana</div>\n</div>\n<div class=\"mt-[14px]\" data-kid=\"1-3-1-7\" data-name=\"group field group\">\n<div class=\"lbl\" data-kid=\"1-3-1-7-1\" data-name=\"group label\">Grupo</div>\n<div class=\"kv\" data-kid=\"1-3-1-7-2\" data-name=\"group value text\">Frente de colheita</div>\n</div>\n<div class=\"mt-[14px]\" data-kid=\"1-3-1-8\" data-name=\"observed window field group\">\n<div class=\"lbl\" data-kid=\"1-3-1-8-1\" data-name=\"observed window label\">Janela observada</div>\n<div class=\"kv\" data-kid=\"1-3-1-8-2\" data-name=\"observed window value text\">04/01/2026 – 11/12/2026</div>\n</div>\n<div class=\"mt-auto pt-[14px] border-t border-[rgba(37,49,45,0.08)] text-[12px] leading-[16px] text-[#76817B]\" data-kid=\"1-3-1-9\" data-name=\"card footer note text\">\n        Média exibida: aritmética, não ponderada\n      </div>\n</div>\n<div class=\"flex-1 flex flex-col gap-[16px] min-w-0\" data-kid=\"1-3-2\" data-name=\"charts column container\">\n<!-- série diária -->\n<div class=\"card h-[286px] p-[18px] flex flex-col\" data-kid=\"1-3-2-1\" data-name=\"daily series chart card\">\n<div class=\"flex items-start justify-between\" data-kid=\"1-3-2-1-1\" data-name=\"chart header row\">\n<div data-kid=\"1-3-2-1-1-1\" data-name=\"chart title group\">\n<div class=\"text-[16px] leading-[20px] font-semibold text-[#173F35]\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"daily series chart title\">Série diária</div>\n<div class=\"text-[13px] text-[#76817B] mt-[2px]\" data-kid=\"1-3-2-1-1-1-2\" data-name=\"daily series subtitle text\">903 leituras em 342 dias corridos</div>\n</div>\n<div class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-2-1-1-2\" data-name=\"chart y-axis unit label\">kg/t</div>\n</div>\n<div class=\"mt-[10px]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2\" data-name=\"daily series line chart container\" data-reason=\"SVG line chart rendered and injected by script via innerHTML\" id=\"serieATR\"></div>\n</div>\n<div class=\"flex gap-[16px] h-[212px]\" data-kid=\"1-3-2-2\" data-name=\"bottom charts row\">\n<!-- média mensal -->\n<div class=\"card w-[620px] p-[18px] flex flex-col\" data-kid=\"1-3-2-2-1\" data-name=\"monthly average chart card\">\n<div class=\"flex items-start justify-between\" data-kid=\"1-3-2-2-1-1\" data-name=\"chart header row\">\n<div data-kid=\"1-3-2-2-1-1-1\" data-name=\"chart title group\">\n<div class=\"text-[16px] leading-[20px] font-semibold text-[#173F35]\" data-kid=\"1-3-2-2-1-1-1-1\" data-name=\"monthly average chart title\">Média mensal</div>\n<div class=\"text-[13px] text-[#76817B] mt-[2px]\" data-kid=\"1-3-2-2-1-1-1-2\" data-name=\"monthly average subtitle text\">Média aritmética das leituras do mês</div>\n</div>\n<div class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"chart y-axis unit label\">kg/t</div>\n</div>\n<div class=\"mt-[8px]\" data-dynamic=\"true\" data-kid=\"1-3-2-2-1-2\" data-name=\"monthly average line chart container\" data-reason=\"SVG line chart rendered and injected by script via innerHTML\" id=\"mensalATR\"></div>\n</div>\n<!-- comparação -->\n<div class=\"card w-[440px] p-[18px] flex flex-col\" data-kid=\"1-3-2-2-2\" data-name=\"period comparison card\">\n<div class=\"flex items-start justify-between\" data-kid=\"1-3-2-2-2-1\" data-name=\"comparison header row\">\n<div data-kid=\"1-3-2-2-2-1-1\" data-name=\"comparison title group\">\n<div class=\"text-[16px] leading-[20px] font-semibold text-[#173F35]\" data-kid=\"1-3-2-2-2-1-1-1\" data-name=\"comparison chart title\">Comparação de períodos</div>\n<div class=\"text-[13px] text-[#76817B] mt-[2px]\" data-kid=\"1-3-2-2-2-1-1-2\" data-name=\"comparison date range subtitle\">03/10 – 11/12/2026 contra 24/07 – 02/10/2026</div>\n</div>\n<div class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"comparison y-axis unit label\">kg/t</div>\n</div>\n<div class=\"mt-[10px]\" data-kid=\"1-3-2-2-2-2\" data-name=\"comparison metrics list\">\n<div class=\"cmp\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"current period average row\">\n<span class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-2-2-2-2-1-1\" data-name=\"current period average label\">Média do período</span>\n<span class=\"text-[14px] font-semibold text-[#25312D]\" data-kid=\"1-3-2-2-2-2-1-2\" data-name=\"current period average value\">116,84</span>\n</div>\n<div class=\"cmp\" data-kid=\"1-3-2-2-2-2-2\" data-name=\"previous period average row\">\n<span class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-2-2-2-2-2-1\" data-name=\"previous period average label\">Média do período anterior</span>\n<span class=\"text-[14px] font-semibold text-[#25312D]\" data-kid=\"1-3-2-2-2-2-2-2\" data-name=\"previous period average value\">116,12</span>\n</div>\n<div class=\"cmp\" data-kid=\"1-3-2-2-2-2-3\" data-name=\"absolute difference row\">\n<span class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-2-2-2-2-3-1\" data-name=\"absolute difference label\">Diferença absoluta</span>\n<span class=\"text-[14px] font-semibold text-[#25312D]\" data-kid=\"1-3-2-2-2-2-3-2\" data-name=\"absolute difference value\">+0,72</span>\n</div>\n<div class=\"cmp border-b-0\" data-kid=\"1-3-2-2-2-2-4\" data-name=\"percent variation row\">\n<span class=\"text-[13px] text-[#76817B]\" data-kid=\"1-3-2-2-2-2-4-1\" data-name=\"percent variation label\">Variação percentual</span>\n<span class=\"text-[14px] font-semibold text-[#25312D]\" data-kid=\"1-3-2-2-2-2-4-2\" data-name=\"percent variation value\">+0,62%</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"px-[24px] mt-[16px] shrink-0\" data-kid=\"1-4\" data-name=\"dashboard footer section\">\n<div class=\"h-[36px] flex items-center justify-between border-t border-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-1\" data-name=\"footer status bar\">\n<div class=\"text-[12px] text-[#76817B]\" data-kid=\"1-4-1-1\" data-name=\"data source file info text\">Base_Usina_PowerBI_Final_v4.xlsx · Fato_Medicoes, Dim_Indicador, Dim_Calendario</div>\n<div class=\"flex items-center gap-[16px] text-[12px] text-[#76817B]\" data-kid=\"1-4-1-2\" data-name=\"footer status indicators group\">\n<span class=\"flex items-center gap-[6px]\" data-kid=\"1-4-1-2-1\" data-name=\"pending records status item\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A]\" data-kid=\"1-4-1-2-1-1\" data-name=\"orange status dot\"></span>903 registros pendentes · 4,62%</span>\n<span class=\"flex items-center gap-[6px]\" data-kid=\"1-4-1-2-2\" data-name=\"pending indicator status item\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A]\" data-kid=\"1-4-1-2-2-1\" data-name=\"orange status dot\"></span>1 indicador pendente</span>\n<span class=\"text-[#173F35] font-semibold underline decoration-[rgba(23,63,53,0.3)] underline-offset-[3px]\" data-kid=\"1-4-1-2-3\" data-name=\"view quality link\">Ver qualidade</span>\n</div>\n</div>\n</div>\n</div>\n<script>\n(function () {\n  const MES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];\n  const rnd = (s) => { let x = s; return () => { x = (x * 16807) % 2147483647; return (x - 1) / 2147483646; }; };\n\n  function frame(W, H, P, min, max, ticks, labels, fmt) {\n    const iw = W - P.l - P.r, ih = H - P.t - P.b;\n    const Y = (v) => P.t + ih * (1 - (v - min) / (max - min));\n    let s = '<svg width=\"' + W + '\" height=\"' + H + '\" viewBox=\"0 0 ' + W + ' ' + H + '\" fill=\"none\">';\n    ticks.forEach((t) => {\n      const yy = Y(t);\n      s += '<line x1=\"' + P.l + '\" y1=\"' + yy.toFixed(1) + '\" x2=\"' + (W - P.r) + '\" y2=\"' + yy.toFixed(1) + '\" stroke=\"rgba(37,49,45,0.07)\" stroke-width=\"1\"/>';\n      s += '<text x=\"' + (P.l - 8) + '\" y=\"' + (yy + 4).toFixed(1) + '\" text-anchor=\"end\" font-size=\"12\" fill=\"#76817B\">' + fmt(t) + '</text>';\n    });\n    labels.forEach((lb) => {\n      s += '<text x=\"' + lb.x.toFixed(1) + '\" y=\"' + (H - 7) + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#76817B\">' + lb.t + '</text>';\n    });\n    s += '<line x1=\"' + P.l + '\" y1=\"' + Y(min) + '\" x2=\"' + (W - P.r) + '\" y2=\"' + Y(min) + '\" stroke=\"rgba(37,49,45,0.14)\" stroke-width=\"1\"/>';\n    return { head: s, Y: Y, iw: iw, ih: ih };\n  }\n\n  function drawRuns(svg, data, X, Y, min, color, width) {\n    const runs = []; let cur = [];\n    data.forEach((v, i) => { if (v === null) { if (cur.length) runs.push(cur); cur = []; } else { cur.push([i, v]); } });\n    if (cur.length) runs.push(cur);\n    runs.forEach((run) => {\n      const line = run.map((p, k) => (k ? 'L' : 'M') + X(p[0]).toFixed(1) + ' ' + Y(p[1]).toFixed(1)).join(' ');\n      const area = line + ' L' + X(run[run.length - 1][0]).toFixed(1) + ' ' + Y(min) + ' L' + X(run[0][0]).toFixed(1) + ' ' + Y(min) + ' Z';\n      svg.push('<path d=\"' + area + '\" fill=\"rgba(78,121,102,0.06)\"/>');\n      svg.push('<path d=\"' + line + '\" stroke=\"' + color + '\" stroke-width=\"' + width + '\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>');\n    });\n    return svg;\n  }\n\n  // série diária ATR\n  const host = document.getElementById('serieATR');\n  if (host) {\n    const W = 1040, H = 196, P = { l: 40, r: 8, t: 8, b: 24 };\n    const r = rnd(41), start = new Date(2026, 0, 4), N = 342;\n    const data = [], labels = [];\n    for (let i = 0; i < N; i++) {\n      const d = new Date(start.getTime() + i * 86400000);\n      if (r() < 0.09) { data.push(null); continue; }\n      const v = 117 + (r() - 0.5) * 13 + Math.sin(i / 26) * 2.4;\n      data.push(Math.max(104.5, Math.min(131, v)));\n    }\n    const min = 100, max = 135;\n    const f = frame(W, H, P, min, max, [100, 110, 120, 130], [], (t) => t.toFixed(0));\n    const X = (i) => P.l + f.iw * i / (N - 1);\n    for (let m = 0; m < 12; m++) {\n      const d0 = new Date(2026, m, 1);\n      const idx = Math.round((d0 - start) / 86400000);\n      if (idx > 0 && idx < N) labels.push({ x: X(idx), t: MES[m] });\n    }\n    const f2 = frame(W, H, P, min, max, [100, 110, 120, 130], labels, (t) => t.toFixed(0));\n    const parts = drawRuns([], data, X, f2.Y, min, '#4E7966', 1.1);\n    host.innerHTML = f2.head + parts.join('') + '</svg>';\n  }\n\n  // média mensal\n  const host2 = document.getElementById('mensalATR');\n  if (host2) {\n    const W = 584, H = 122, P = { l: 40, r: 8, t: 8, b: 22 };\n    const vals = [116.2, 115.1, 116.8, 117.4, 118.2, 117.1, 116.6, 117.9, 116.3, 116.9, 117.6, 116.8];\n    const min = 112, max = 122, iw = W - P.l - P.r, ih = H - P.t - P.b;\n    const X = (i) => P.l + iw * i / (vals.length - 1);\n    const Y = (v) => P.t + ih * (1 - (v - min) / (max - min));\n    let s = '<svg width=\"' + W + '\" height=\"' + H + '\" viewBox=\"0 0 ' + W + ' ' + H + '\" fill=\"none\">';\n    [112, 117, 122].forEach((t) => {\n      const yy = Y(t);\n      s += '<line x1=\"' + P.l + '\" y1=\"' + yy.toFixed(1) + '\" x2=\"' + (W - P.r) + '\" y2=\"' + yy.toFixed(1) + '\" stroke=\"rgba(37,49,45,0.07)\"/>';\n      s += '<text x=\"' + (P.l - 8) + '\" y=\"' + (yy + 4).toFixed(1) + '\" text-anchor=\"end\" font-size=\"12\" fill=\"#76817B\">' + t + '</text>';\n    });\n    const line = vals.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join(' ');\n    s += '<path d=\"' + line + '\" stroke=\"#4E7966\" stroke-width=\"1.6\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>';\n    vals.forEach((v, i) => {\n      s += '<circle cx=\"' + X(i).toFixed(1) + '\" cy=\"' + Y(v).toFixed(1) + '\" r=\"2.6\" fill=\"#FFFFFF\" stroke=\"#173F35\" stroke-width=\"1.4\"/>';\n      s += '<text x=\"' + X(i).toFixed(1) + '\" y=\"' + (H - 7) + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#76817B\">' + MES[i] + '</text>';\n    });\n    host2.innerHTML = s + '</svg>';\n  }\n})();\n</script>\n",
