x;display:flex;flex-direction:column\">\n<div data-kid=\"1-5-2-2-1\" data-name=\"reconciliation card header\" style=\"height:32px;display:flex;align-items:flex-start;justify-content:space-between\">\n<span data-kid=\"1-5-2-2-1-1\" data-name=\"reconciliation card title\" style=\"font-size:16px;line-height:20px;font-weight:600;color:#173F35\">Registros por status</span>\n<span data-kid=\"1-5-2-2-1-2\" data-name=\"reconciliation base status text\" style=\"font-size:12px;color:#76817B\">base completa</span>\n</div>\n<div data-kid=\"1-5-2-2-2\" data-name=\"reconciliation independent indicator caption\" style=\"font-size:12px;line-height:15px;color:#76817B\">Independente do indicador selecionado</div>\n<div data-kid=\"1-5-2-2-3\" data-name=\"status distribution chart container\" style=\"margin-top:6px\">\n<svg aria-label=\"Base completa por status: 16.823 validados, 1.806 normalizados e 903 pendentes somam 19.532 registros\" data-kid=\"1-5-2-2-3-1\" data-name=\"records by status horizontal bar chart\" fill=\"none\" height=\"118\" role=\"img\" viewbox=\"0 0 324 118\" width=\"324\"><rect fill=\"#4E7966\" height=\"18\" rx=\"3\" width=\"146.4\" x=\"80.0\" y=\"4\"></rect><text fill=\"#76817B\" font-size=\"12\" x=\"0\" y=\"17\">Validado</text><text fill=\"#25312D\" font-size=\"13\" font-weight=\"600\" text-anchor=\"end\" x=\"324\" y=\"17\">16.823</text><rect fill=\"#A8B9A0\" height=\"18\" rx=\"3\" width=\"15.7\" x=\"226.4\" y=\"30\"></rect><text fill=\"#76817B\" font-size=\"12\" x=\"0\" y=\"43\">Normalizado</text><text fill=\"#25312D\" font-size=\"13\" font-weight=\"600\" text-anchor=\"end\" x=\"324\" y=\"43\">1.806</text><rect fill=\"#C17A4A\" height=\"18\" rx=\"3\" width=\"7.9\" x=\"242.1\" y=\"56\"></rect><text fill=\"#76817B\" font-size=\"12\" x=\"0\" y=\"69\">Pendente</text><text fill=\"#25312D\" font-size=\"13\" font-weight=\"600\" text-anchor=\"end\" x=\"324\" y=\"69\">903</text><rect fill=\"#173F35\" height=\"18\" rx=\"3\" width=\"170.0\" x=\"80.0\" y=\"82\"></rect><tex