      "html": "<style>\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .ci { font-family: \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, sans-serif; font-feature-settings: \"tnum\" 1; }\n  .ci-title { font-family: \"Segoe UI Variable Display\", \"Segoe UI Semibold\", \"Segoe UI\", system-ui, sans-serif; }\n  .tab { display: flex; align-items: center; border-bottom: 2px solid transparent; color: #76817B; font-size: 14px; }\n  .tab-on { border-bottom-color: #173F35; color: #173F35; font-weight: 600; }\n  .field { height: 40px; background: #FFFFFF; border: 1px solid rgba(37,49,45,0.14); border-radius: 8px; display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: 14px; }\n  .stat-cell { display: flex; flex-direction: column; justify-content: center; padding: 0 24px; }\n</style>\n<div class=\"ci w-[1440px] h-[810px] bg-[#F7F6F0] text-[#25312D] px-[24px] py-[24px] flex flex-col overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- masthead -->\n<div class=\"h-[48px] flex items-center justify-between shrink-0\" data-kid=\"1-1\" data-name=\"masthead top bar\">\n<div class=\"flex items-center gap-[16px]\" data-kid=\"1-1-1\" data-name=\"brand identity group\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1\" data-name=\"brand leaf logo icon\" fill=\"none\" height=\"30\" viewbox=\"0 0 22 30\" width=\"22\">\n<path d=\"M5 29C5 19.5 7.2 11.6 12.4 4.2\" stroke=\"#173F35\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M12.4 4.2C16.4 6.4 18.9 10.2 19.6 14.8C15.1 14.2 11.7 11.6 10.2 7.6\" stroke=\"#4E7966\" stroke-linejoin=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M6.6 20.4C5.1 19.7 3.7 20 2.4 20.9\" stroke=\"#C17A4A\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n</svg>\n<span class=\"ci-title text-[28px] leading-[32px] font-semibold tracking-[-0.3px] text-[#173F35]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">CANA INTELLIGENCE</span>\n<span class=\"w-px h-[22px] bg-[rgba(37,49,45,0.18)]\" data-kid=\"1-1-1-3\" data-name=\"vertical divider line\"></span>\n<span class=\"text-[17px] leading-[22px] font-semibold text-[#25312D]\" data-kid=\"1-1-1-4\" data-name=\"active section label\">Indicadores</span>\n</div>\n<div class=\"flex items-center gap-[16px] text-[14px] leading-[18px] text-[#76817B]\" data-kid=\"1-1-2\" data-name=\"season and model status group\">\n<span data-kid=\"1-1-2-1\" data-name=\"harvest season label\">Safra 2026/2027</span>\n<span class=\"w-px h-[14px] bg-[rgba(37,49,45,0.18)]\" data-kid=\"1-1-2-2\" data-name=\"vertical divider line\"></span>\n<span data-kid=\"1-1-2-3\" data-name=\"model load timestamp text\">Carga do modelo 12/12/2026 05:12</span>\n</div>\n</div>\n<!-- navegação -->\n<div class=\"h-[44px] mt-[8px] flex items-stretch gap-[28px] shrink-0 border-b border-[rgba(37,49,45,0.10)]\" data-kid=\"1-2\" data-name=\"section tab navigation\">\n<span class=\"tab\" data-kid=\"1-2-1\" data-name=\"overview tab\">Visão geral</span>\n<span class=\"tab\" data-kid=\"1-2-2\" data-name=\"evolution tab\">Evolução</span>\n<span class=\"tab\" data-kid=\"1-2-3\" data-name=\"sources tab\">Fontes</span>\n<span class=\"tab tab-on\" data-kid=\"1-2-4\" data-name=\"active indicators tab\">Indicadores</span>\n<span class=\"tab\" data-kid=\"1-2-5\" data-name=\"quality tab\">Qualidade</span>\n<span class=\"tab\" data-kid=\"1-2-6\" data-name=\"details tab\">Detalhes</span>\n</div>\n<!-- filtros -->\n<div class=\"h-[64px] mt-[16px] flex items-end justify-between shrink-0\" data-kid=\"1-3\" data-name=\"filter controls row\">\n<div class=\"flex items-end gap-[16px]\" data-kid=\"1-3-1\" data-name=\"date and source filter group\">\n<div data-kid=\"1-3-1-1\" data-name=\"start date filter field\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] mb-[6px]\" data-kid=\"1-3-1-1-1\" data-name=\"start date label\">Data inicial</div>\n<div class=\"field w-[148px] justify-between\" data-kid=\"1-3-1-1-2\" data-name=\"start date input field\">\n<span class=\"text-[#25312D]\" data-kid=\"1-3-1-1-2-1\" data-name=\"start date value text\">01/01/2026</span>\n<i class=\"ti ti-calendar text-[16px] text-[#76817B]\" data-kid=\"1-3-1-1-2-2\" data-name=\"calendar icon\"></i>\n</div>\n</div>\n<div data-kid=\"1-3-1-2\" data-name=\"end date filter field\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] mb-[6px]\" data-kid=\"1-3-1-2-1\" data-name=\"end date label\">Data final</div>\n<div class=\"field w-[148px] justify-between\" data-kid=\"1-3-1-2-2\" data-name=\"end date input field\">\n<span class=\"text-[#25312D]\" data-kid=\"1-3-1-2-2-1\" data-name=\"end date value text\">31/12/2026</span>\n<i class=\"ti ti-calendar text-[16px] text-[#76817B]\" data-kid=\"1-3-1-2-2-2\" data-name=\"calendar icon\"></i>\n</div>\n</div>\n<div data-kid=\"1-3-1-3\" data-name=\"source filter field\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B] mb-[6px]\" data-kid=\"1-3-1-3-1\" data-name=\"source label\">Fonte</div>\n<div class=\"field w-[212px] justify-between\" data-kid=\"1-3-1-3-2\" data-name=\"source selection field\">\n<span class=\"text-[#25312D]\" data-kid=\"1-3-1-3-2-1\" data-name=\"source value text\">Todas as 8 fontes</span>\n<i class=\"ti ti-chevron-down text-[16px] text-[#76817B]\" data-kid=\"1-3-1-3-2-2\" data-name=\"chevron down icon\"></i>\n</div>\n</div>\n</div>\n<div class=\"field w-[148px] justify-center gap-[8px] bg-transparent border-[rgba(37,49,45,0.14)] cursor-pointer\" data-kid=\"1-3-2\" data-name=\"clear filters button\">\n<i class=\"ti ti-arrow-back-up text-[16px] text-[#4E7966]\" data-kid=\"1-3-2-1\" data-name=\"return arrow icon\"></i>\n<span class=\"font-semibold text-[#173F35]\" data-kid=\"1-3-2-2\" data-name=\"clear filters button text\">Limpar filtros</span>\n</div>\n</div>\n<!-- conteúdo -->\n<div class=\"h-[514px] mt-[16px] flex flex-col shrink-0\" data-kid=\"1-4\" data-name=\"main content area\">\n<!-- contrato do indicador -->\n<div class=\"h-[96px] bg-white border border-[rgba(37,49,45,0.12)] rounded-[18px] px-[16px] py-[16px] flex flex-col shrink-0\" data-kid=\"1-4-1\" data-name=\"indicator contract card\">\n<div class=\"h-[40px] flex items-center justify-between\" data-kid=\"1-4-1-1\" data-name=\"contract detail header row\">\n<div class=\"flex items-center gap-[24px]\" data-kid=\"1-4-1-1-1\" data-name=\"contract detail fields group\">\n<div class=\"field w-[280px] justify-between\" data-kid=\"1-4-1-1-1-1\" data-name=\"indicator selector field\">\n<span class=\"flex items-center gap-[8px]\" data-kid=\"1-4-1-1-1-1-1\" data-name=\"indicator name group\">\n<span class=\"text-[#25312D] font-semibold\" data-kid=\"1-4-1-1-1-1-1-1\" data-name=\"indicator name text\">Acidez Total</span>\n<span class=\"text-[14px] text-[#76817B]\" data-kid=\"1-4-1-1-1-1-1-2\" data-name=\"indicator code text\">ACIDEZ</span>\n</span>\n<i class=\"ti ti-chevron-down text-[16px] text-[#76817B]\" data-kid=\"1-4-1-1-1-1-2\" data-name=\"chevron down icon\"></i>\n</div>\n<div class=\"flex items-center h-[40px]\" data-kid=\"1-4-1-1-1-2\" data-name=\"indicator metrics group\">\n<div class=\"w-px h-[32px] bg-[rgba(37,49,45,0.10)] mr-[24px]\" data-kid=\"1-4-1-1-1-2-1\" data-name=\"vertical divider line\"></div>\n<div class=\"flex items-end gap-[32px]\" data-kid=\"1-4-1-1-1-2-2\" data-name=\"metric values row\">\n<div data-kid=\"1-4-1-1-1-2-2-1\" data-name=\"unit metric cell\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B]\" data-kid=\"1-4-1-1-1-2-2-1-1\" data-name=\"unit metric label\">Unidade</div>\n<div class=\"text-[17px] leading-[22px] font-semibold mt-[2px]\" data-kid=\"1-4-1-1-1-2-2-1-2\" data-name=\"unit metric value text\">mg/L</div>\n</div>\n<div data-kid=\"1-4-1-1-1-2-2-2\" data-name=\"aggregation metric cell\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B]\" data-kid=\"1-4-1-1-1-2-2-2-1\" data-name=\"aggregation metric label\">Agregação</div>\n<div class=\"text-[17px] leading-[22px] font-semibold mt-[2px]\" data-kid=\"1-4-1-1-1-2-2-2-2\" data-name=\"aggregation metric value text\">Média aritmética</div>\n</div>\n<div data-kid=\"1-4-1-1-1-2-2-3\" data-name=\"status metric cell\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B]\" data-kid=\"1-4-1-1-1-2-2-3-1\" data-name=\"status metric label\">Status</div>\n<div class=\"text-[17px] leading-[22px] font-semibold mt-[2px] flex items-center gap-[6px]\" data-kid=\"1-4-1-1-1-2-2-3-2\" data-name=\"status value with indicator dot\">\n<span class=\"w-[6px] h-[6px] rounded-full bg-[#4E7966]\" data-kid=\"1-4-1-1-1-2-2-3-2-1\" data-name=\"validated status indicator dot\"></span>Validado\n                </div>\n</div>\n<div data-kid=\"1-4-1-1-1-2-2-4\" data-name=\"readings metric cell\">\n<div class=\"text-[14px] leading-[16px] text-[#76817B]\" data-kid=\"1-4-1-1-1-2-2-4-1\" data-name=\"readings metric label\">Leituras</div>\n<div class=\"text-[17px] leading-[22px] font-semibold mt-[2px]\" data-kid=\"1-4-1-1-1-2-2-4-2\" data-name=\"readings value text\">800</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B]\" data-kid=\"1-4-1-1-2\" data-name=\"single source attribution text\">Fonte única: Laboratório</div>\n</div>\n<div class=\"flex items-center gap-[32px] mt-[6px] text-[14px] leading-[18px]\" data-kid=\"1-4-1-2\" data-name=\"description and observation row\">\n<span class=\"text-[#76817B]\" data-kid=\"1-4-1-2-1\" data-name=\"description label and value\">Descrição <span class=\"text-[#25312D] ml-[6px]\" data-kid=\"1-4-1-2-1-1\" data-name=\"description value text\">Acidez do Processo</span></span>\n<span class=\"w-px h-[12px] bg-[rgba(37,49,45,0.14)]\" data-kid=\"1-4-1-2-2\" data-name=\"vertical divider line\"></span>\n<span class=\"text-[#76817B]\" data-kid=\"1-4-1-2-3\" data-name=\"technical observation label and value\">Observação técnica <span class=\"text-[#25312D] ml-[6px]\" data-kid=\"1-4-1-2-3-1\" data-name=\"observation value text\">Controle de contaminação e degradação</span></span>\n</div>\n</div>\n<!-- estatísticas permitidas -->\n<div class=\"h-[72px] mt-[16px] shrink-0 bg-white border border-[rgba(37,49,45,0.12)] rounded-[18px] flex items-stretch overflow-hidden\" data-kid=\"1-4-2\" data-name=\"summary statistics card\">\n<div class=\"flex-1 flex items-stretch\" data-kid=\"1-4-2-1\" data-name=\"statistics cells container\">\n<div class=\"stat-cell flex-1\" data-kid=\"1-4-2-1-1\" data-name=\"average stat cell\">\n<div class=\"text-[28px] leading-[32px] font-semibold tracking-[-0.2px] text-[#173F35]\" data-kid=\"1-4-2-1-1-1\" data-name=\"average stat value\">8,98</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-2-1-1-2\" data-name=\"average stat label\">Média em mg/L</div>\n</div>\n<div class=\"w-px my-[14px] bg-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-2-1-2\" data-name=\"vertical divider line\"></div>\n<div class=\"stat-cell flex-1\" data-kid=\"1-4-2-1-3\" data-name=\"median stat cell\">\n<div class=\"text-[28px] leading-[32px] font-semibold tracking-[-0.2px] text-[#173F35]\" data-kid=\"1-4-2-1-3-1\" data-name=\"median stat value\">8,98</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-2-1-3-2\" data-name=\"median stat label\">Mediana em mg/L</div>\n</div>\n<div class=\"w-px my-[14px] bg-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-2-1-4\" data-name=\"vertical divider line\"></div>\n<div class=\"stat-cell flex-1\" data-kid=\"1-4-2-1-5\" data-name=\"minimum stat cell\">\n<div class=\"text-[28px] leading-[32px] font-semibold tracking-[-0.2px] text-[#173F35]\" data-kid=\"1-4-2-1-5-1\" data-name=\"minimum stat value\">6,50</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-2-1-5-2\" data-name=\"minimum stat label\">Mínimo observado</div>\n</div>\n<div class=\"w-px my-[14px] bg-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-2-1-6\" data-name=\"vertical divider line\"></div>\n<div class=\"stat-cell flex-1\" data-kid=\"1-4-2-1-7\" data-name=\"maximum stat cell\">\n<div class=\"text-[28px] leading-[32px] font-semibold tracking-[-0.2px] text-[#173F35]\" data-kid=\"1-4-2-1-7-1\" data-name=\"maximum stat value\">11,49</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-2-1-7-2\" data-name=\"maximum stat label\">Máximo observado</div>\n</div>\n<div class=\"w-px my-[14px] bg-[rgba(37,49,45,0.10)]\" data-kid=\"1-4-2-1-8\" data-name=\"vertical divider line\"></div>\n<div class=\"stat-cell flex-1\" data-kid=\"1-4-2-1-9\" data-name=\"readings stat cell\">\n<div class=\"text-[28px] leading-[32px] font-semibold tracking-[-0.2px] text-[#173F35]\" data-kid=\"1-4-2-1-9-1\" data-name=\"readings stat value\">800</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-2-1-9-2\" data-name=\"readings stat label\">Leituras em 236 dias</div>\n</div>\n</div>\n</div>\n<!-- painéis -->\n<div class=\"flex gap-[16px] mt-[16px] h-[314px]\" data-kid=\"1-4-3\" data-name=\"charts panel group\">\n<div class=\"w-[896px] bg-white border border-[rgba(37,49,45,0.12)] rounded-[18px] p-[16px] flex flex-col\" data-kid=\"1-4-3-1\" data-name=\"trend line chart card\">\n<div class=\"flex items-start justify-between shrink-0\" data-kid=\"1-4-3-1-1\" data-name=\"line chart header\">\n<div data-kid=\"1-4-3-1-1-1\" data-name=\"line chart title group\">\n<div class=\"text-[17px] leading-[22px] font-semibold\" data-kid=\"1-4-3-1-1-1-1\" data-name=\"line chart title\">Acidez Total</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-3-1-1-1-2\" data-name=\"line chart subtitle\">Média diária em mg/L, 01/04/2026 a 30/11/2026</div>\n</div>\n<div class=\"flex items-center gap-[16px] text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-3-1-1-2\" data-name=\"chart legend group\">\n<span class=\"flex items-center gap-[8px]\" data-kid=\"1-4-3-1-1-2-1\" data-name=\"daily legend item\"><span class=\"w-[18px] h-[2px] bg-[#7C9E8B]\" data-kid=\"1-4-3-1-1-2-1-1\" data-name=\"daily legend color line\"></span>Diário</span>\n<span class=\"flex items-center gap-[8px]\" data-kid=\"1-4-3-1-1-2-2\" data-name=\"monthly average legend item\"><span class=\"w-[18px] h-[3px] bg-[#173F35]\" data-kid=\"1-4-3-1-1-2-2-1\" data-name=\"monthly average legend color line\"></span>Média mensal</span>\n</div>\n</div>\n<div class=\"flex-1 mt-[8px] relative\" data-kid=\"1-4-3-1-2\" data-name=\"line chart canvas container\">\n<canvas data-dynamic=\"true\" data-kid=\"1-4-3-1-2-1\" data-name=\"daily acid trend line chart\" data-reason=\"chart rendered by Chart.js from RAW data\" id=\"serieInd\"></canvas>\n</div>\n</div>\n<div class=\"w-[480px] bg-white border border-[rgba(37,49,45,0.12)] rounded-[18px] p-[16px] flex flex-col\" data-kid=\"1-4-3-2\" data-name=\"histogram distribution chart card\">\n<div class=\"flex items-start justify-between shrink-0\" data-kid=\"1-4-3-2-1\" data-name=\"histogram chart header\">\n<div data-kid=\"1-4-3-2-1-1\" data-name=\"histogram title group\">\n<div class=\"text-[17px] leading-[22px] font-semibold\" data-kid=\"1-4-3-2-1-1-1\" data-name=\"histogram title\">Distribuição dos valores</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] mt-[2px]\" data-kid=\"1-4-3-2-1-1-2\" data-name=\"histogram subtitle\">Contagem de leituras por faixa, 14 faixas</div>\n</div>\n<div class=\"text-[14px] leading-[18px] text-[#76817B] text-right\" data-kid=\"1-4-3-2-1-2\" data-name=\"histogram y-axis unit label\">mg/L</div>\n</div>\n<div class=\"flex-1 mt-[8px] relative\" data-kid=\"1-4-3-2-2\" data-name=\"histogram canvas container\">\n<canvas data-dynamic=\"true\" data-kid=\"1-4-3-2-2-1\" data-name=\"value distribution histogram chart\" data-reason=\"chart rendered by Chart.js from COUNTS data\" id=\"histInd\"></canvas>\n</div>\n</div>\n</div>\n</div>\n<!-- rodapé -->\n<div class=\"h-[36px] mt-[16px] shrink-0 flex items-center justify-between border-t border-[rgba(37,49,45,0.10)] pt-[8px]\" data-kid=\"1-5\" data-name=\"footer bar\">\n<div class=\"text-[12px] leading-[16px] text-[#76817B]\" data-kid=\"1-5-1\" data-name=\"footer data source attribution\">\n      Fonte: Base_Usina_PowerBI_Final_v4.xlsx · Dim_Indicador, Fato_Medicoes\n    </div>\n<div class=\"flex items-center gap-[16px] text-[14px] leading-[18px] text-[#76817B]\" data-kid=\"1-5-2\" data-name=\"footer status and action group\">\n<span class=\"flex items-center gap-[6px]\" data-kid=\"1-5-2-1\" data-name=\"pending records status item\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A]\" data-kid=\"1-5-2-1-1\" data-name=\"warning status dot\"></span>903 registros pendentes</span>\n<span class=\"flex items-center gap-[6px]\" data-kid=\"1-5-2-2\" data-name=\"pending indicator status item\"><span class=\"w-[6px] h-[6px] rounded-full bg-[#C17A4A]\" data-kid=\"1-5-2-2-1\" data-name=\"warning status dot\"></span>1 indicador pendente</span>\n<span class=\"text-[#173F35] font-semibold underline underline-offset-[3px] decoration-[#A8B9A0]\" data-kid=\"1-5-2-3\" data-name=\"view quality link\">Ver qualidade</span>\n</div>\n</div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\"></script>\n<script>\n  const RAW_D = [\"04-01\",\"04-02\",\"04-03\",\"04-04\",\"04-05\",\"04-06\",\"04-07\",\"04-08\",\"04-09\",\"04-10\",\"04-11\",\"04-12\",\"04-13\",\"04-14\",\"04-15\",\"04-16\",\"04-17\",\"04-18\",\"04-19\",\"04-20\",\"04-22\",\"04-23\",\"04-24\",\"04-25\",\"04-26\",\"04-27\",\"04-28\",\"04-29\",\"04-30\",\"05-01\",\"05-02\",\"05-03\",\"05-04\",\"05-05\",\"05-06\",\"05-07\",\"05-08\",\"05-09\",\"05-10\",\"05-11\",\"05-12\",\"05-13\",\"05-14\",\"05-15\",\"05-16\",\"05-17\",\"05-18\",\"05-19\",\"05-20\",\"05-21\",\"05-22\",\"05-23\",\"05-24\",\"05-25\",\"05-26\",\"05-27\",\"05-28\",\"05-29\",\"05-30\",\"05-31\",\"06-01\",\"06-02\",\"06-03\",\"06-04\",\"06-05\",\"06-06\",\"06-07\",\"06-08\",\"06-09\",\"06-10\",\"06-11\",\"06-12\",\"06-13\",\"06-14\",\"06-15\",\"06-16\",\"06-17\",\"06-18\",\"06-19\",\"06-20\",\"06-21\",\"06-22\",\"06-23\",\"06-24\",\"06-25\",\"06-26\",\"06-27\",\"06-28\",\"06-29\",\"06-30\",\"07-01\",\"07-02\",\"07-04\",\"07-05\",\"07-06\",\"07-07\",\"07-08\",\"07-09\",\"07-10\",\"07-11\",\"07-12\",\"07-13\",\"07-14\",\"07-15\",\"07-16\",\"07-17\",\"07-18\",\"07-19\",\"07-20\",\"07-21\",\"07-22\",\"07-23\",\"07-24\",\"07-25\",\"07-26\",\"07-27\",\"07-28\",\"07-29\",\"07-30\",\"07-31\",\"08-01\",\"08-02\",\"08-03\",\"08-04\",\"08-05\",\"08-07\",\"08-08\",\"08-09\",\"08-10\",\"08-11\",\"08-12\",\"08-13\",\"08-14\",\"08-15\",\"08-16\",\"08-17\",\"08-18\",\"08-19\",\"08-20\",\"08-21\",\"08-22\",\"08-23\",\"08-24\",\"08-25\",\"08-26\",\"08-27\",\"08-29\",\"08-30\",\"08-31\",\"09-01\",\"09-02\",\"09-03\",\"09-04\",\"09-05\",\"09-06\",\"09-07\",\"09-09\",\"09-10\",\"09-11\",\"09-12\",\"09-13\",\"09-14\",\"09-15\",\"09-16\",\"09-17\",\"09-18\",\"09-19\",\"09-20\",\"09-21\",\"09-22\",\"09-23\",\"09-24\",\"09-26\",\"09-27\",\"09-28\",\"09-29\",\"09-30\",\"10-01\",\"10-02\",\"10-03\",\"10-04\",\"10-05\",\"10-06\",\"10-07\",\"10-08\",\"10-09\",\"10-10\",\"10-11\",\"10-12\",\"10-13\",\"10-14\",\"10-15\",\"10-16\",\"10-17\",\"10-18\",\"10-19\",\"10-20\",\"10-21\",\"10-22\",\"10-23\",\"10-24\",\"10-25\",\"10-26\",\"10-27\",\"10-28\",\"10-30\",\"10-31\",\"11-01\",\"11-02\",\"11-03\",\"11-04\",\"11-05\",\"11-06\",\"11-08\",\"11-09\",\"11-10\",\"11-11\",\"11-12\",\"11-13\",\"11-14\",\"11-15\",\"11-16\",\"11-17\",\"11-18\",\"11-19\",\"11-20\",\"11-21\",\"11-22\",\"11-23\",\"11-24\",\"11-25\",\"11-26\",\"11-27\",\"11-28\",\"11-29\",\"11-30\"];\n  const RAW_V = [8.623,9.365,8.66,9.173,8.491,10.83,9.03,9.23,8.477,8.883,9.036,9.105,8.815,8.63,9.16,8.995,11.29,8.595,8.667,8.073,10.46,9.178,8.428,10.43,7.82,10.29,8.826,10.28,9.867,9.678,9.723,9.617,8.883,8.887,10.137,8.207,8.152,7.19,9.607,9.485,8.491,8.945,7.06,9.04,8.237,10.66,8.785,9.212,8.516,7.455,10.523,9.445,8.703,7.565,9.038,7.91,8.248,8.858,11.105,11.35,8.73,9.248,9.275,7.29,8.036,10.03,8.37,8.383,9.332,7.885,8.673,8.28,9.0,10.42,9.51,9.842,8.854,10.775,9.097,7.6,11.4,8.857,8.165,8.84,8.043,7.02,8.848,9.727,8.927,10.747,10.192,9.42,10.387,9.575,9.17,9.64,9.588,6.965,9.617,9.555,7.583,7.862,8.703,10.467,7.86,7.44,9.285,10.195,10.3,8.422,9.36,8.84,9.76,9.45,9.038,9.276,10.312,9.502,9.433,9.555,8.23,7.26,8.318,8.97,10.357,8.142,10.84,7.695,10.96,8.72,10.213,8.385,9.434,9.305,8.232,9.046,8.088,8.6,8.697,8.847,9.035,9.65,7.772,7.41,9.203,7.957,9.268,7.897,7.921,8.97,9.007,8.497,8.947,9.147,9.246,9.45,9.042,7.13,9.377,9.398,8.435,8.645,9.65,8.775,8.8,7.925,9.033,8.044,9.215,8.762,9.53,10.16,10.56,9.11,10.21,9.158,9.083,8.705,7.838,8.565,8.752,7.93,8.55,7.5,9.677,9.522,8.116,7.69,9.257,9.04,9.74,9.264,7.56,7.1,8.638,9.22,8.338,8.893,9.055,8.773,8.325,9.672,9.533,8.853,8.155,9.29,8.107,9.707,10.05,8.907,7.99,9.428,7.795,9.412,9.54,9.61,10.225,8.888,7.785,8.93,10.21,9.615,7.9,9.65,9.518,9.535,8.255,8.165,8.37,9.873,8.102,9.76,8.133,7.705,7.19,8.247];\n  const RAW_N = [3,2,2,3,8,3,3,4,3,4,5,4,2,5,1,4,1,4,3,4,1,5,10,3,2,1,5,1,4,4,3,3,3,3,4,3,4,3,4,2,7,2,1,4,3,2,2,6,5,2,4,2,4,2,5,1,4,5,2,1,1,6,4,2,5,4,4,3,5,2,3,3,3,3,3,6,5,2,3,1,1,7,2,4,4,1,4,3,3,3,4,1,3,4,1,2,4,2,3,2,3,5,3,3,2,1,2,6,1,5,2,3,3,3,6,5,5,5,7,4,3,2,4,1,3,6,3,2,1,2,3,2,5,6,4,5,4,4,3,3,2,2,4,2,3,3,6,3,9,2,3,3,3,6,10,4,6,1,4,5,2,2,3,2,1,4,3,5,4,4,2,4,1,4,3,6,3,4,5,2,4,3,3,2,6,4,5,3,3,4,3,5,3,1,5,2,4,3,2,3,2,4,6,3,2,1,3,3,2,3,1,4,2,5,5,4,2,5,4,5,1,4,1,4,8,2,4,2,3,4,4,7,4,2,1,4];\n\n  const MES = { \"04\": \"abr\", \"05\": \"mai\", \"06\": \"jun\", \"07\": \"jul\", \"08\": \"ago\", \"09\": \"set\", \"10\": \"out\", \"11\": \"nov\" };\n  const obs = {};\n  RAW_D.forEach((d, i) => { obs[d] = { v: RAW_V[i], n: RAW_N[i] }; });\n\n  const labels = [], values = [], counts = [];\n  let cur = new Date(Date.UTC(2026, 3, 1));\n  const end = new Date(Date.UTC(2026, 10, 30));\n  while (cur <= end) {\n    const mm = String(cur.getUTCMonth() + 1).padStart(2, \"0\");\n    const dd = String(cur.getUTCDate()).padStart(2, \"0\");\n    const k = mm + \"-\" + dd;\n    labels.push(k);\n    values.push(obs[k] ? obs[k].v : null);\n    counts.push(obs[k] ? obs[k].n : 0);\n    cur = new Date(cur.getTime() + 86400000);\n  }\n\n  const MONTHLY = { \"04\": 8.98, \"05\": 8.986, \"06\": 9.025, \"07\": 9.3, \"08\": 8.71, \"09\": 9.082, \"10\": 8.748, \"11\": 9.043 };\n  const monthlyLine = new Array(labels.length).fill(null);\n  const monthIdx = {};\n  labels.forEach((l, i) => {\n    const mm = l.slice(0, 2);\n    if (!monthIdx[mm]) { monthIdx[mm] = []; }\n    monthIdx[mm].push(i);\n  });\n  Object.keys(monthIdx).forEach((mm) => {\n    const idxs = monthIdx[mm];\n    monthlyLine[Math.round((idxs[0] + idxs[idxs.length - 1]) / 2)] = MONTHLY[mm];\n  });\n\n  const tooltipBase = {\n    backgroundColor: \"#25312D\",\n    titleColor: \"#FFFFFF\",\n    bodyColor: \"#FFFFFF\",\n    padding: 12,\n    cornerRadius: 8,\n    displayColors: false,\n    titleFont: { size: 14, weight: \"600\", family: \"Segoe UI\" },\n    bodyFont: { size: 14, family: \"Segoe UI\" }\n  };\n\n  new Chart(document.getElementById(\"serieInd\"), {\n    type: \"line\",\n    data: {\n      labels: labels,\n      datasets: [\n        {\n          label: \"Diário\",\n          data: values,\n          borderColor: \"#7C9E8B\",\n          backgroundColor: \"rgba(78,121,102,0.05)\",\n          borderWidth: 1.5,\n          fill: true,\n          tension: 0,\n          spanGaps: false,\n          pointRadius: 0,\n          pointHoverRadius: 3,\n          pointHoverBackgroundColor: \"#173F35\",\n          pointHoverBorderColor: \"#FFFFFF\",\n          pointHoverBorderWidth: 2\n        },\n        {\n          label: \"Média mensal\",\n          data: monthlyLine,\n          borderColor: \"#173F35\",\n          borderWidth: 2.5,\n          fill: false,\n          tension: 0,\n          spanGaps: true,\n          pointRadius: 0,\n          pointHoverRadius: 0\n        }\n      ]\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      animation: false,\n      layout: { padding: { top: 4, right: 2, bottom: 0, left: 0 } },\n      interaction: { mode: \"index\", intersect: false },\n      plugins: {\n        legend: { display: false },\n        tooltip: Object.assign({}, tooltipBase, {\n          callbacks: {\n            title: (items) => {\n              const k = items[0].label;\n              return k.slice(3) + \"/\" + k.slice(0, 2) + \"/2026\";\n            },\n            label: (item) => item.parsed.y.toFixed(2).replace(\".\", \",\") + \" mg/L\",\n            afterLabel: (item) => counts[item.dataIndex] + (counts[item.dataIndex] === 1 ? \" leitura\" : \" leituras\")\n          }\n        })\n      },\n      scales: {\n        x: {\n          grid: { display: false },\n          border: { display: false },\n          ticks: {\n            color: \"#76817B\",\n            font: { size: 14, family: \"Segoe UI\" },\n            maxRotation: 0,\n            autoSkip: false,\n            callback: function (val) {\n              const l = this.getLabelForValue(val);\n              return l.endsWith(\"-01\") ? MES[l.slice(0, 2)] : null;\n            }\n          }\n        },\n        y: {\n          min: 6,\n          max: 12,\n          border: { display: false },\n          grid: { color: \"rgba(37,49,45,0.08)\", drawTicks: false },\n          ticks: {\n            color: \"#76817B\",\n            font: { size: 14, family: \"Segoe UI\" },\n            stepSize: 1,\n            padding: 8,\n            callback: (v) => v.toFixed(1).replace(\".\", \",\")\n          }\n        }\n      }\n    }\n  });\n\n  const EDGES = [6.5,6.856,7.213,7.569,7.926,8.282,8.639,8.995,9.351,9.708,10.064,10.421,10.777,11.134,11.49];\n  const COUNTS = [55,61,58,67,54,57,50,58,52,57,63,58,51,59];\n  const fmt = (v) => v.toFixed(2).replace(\".\", \",\");\n\n  new Chart(document.getElementById(\"histInd\"), {\n    type: \"bar\",\n    data: {\n      labels: EDGES.slice(0, -1).map(fmt),\n      datasets: [{\n        data: COUNTS,\n        backgroundColor: \"#4E7966\",\n        hoverBackgroundColor: \"#173F35\",\n        borderRadius: 2,\n        barPercentage: 0.86,\n        categoryPercentage: 0.92\n      }]\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      animation: false,\n      layout: { padding: { top: 4, right: 2, bottom: 0, left: 0 } },\n      plugins: {\n        legend: { display: false },\n        tooltip: Object.assign({}, tooltipBase, {\n          callbacks: {\n            title: (items) => {\n              const i = items[0].dataIndex;\n              return fmt(EDGES[i]) + \" a \" + fmt(EDGES[i + 1]) + \" mg/L\";\n            },\n            label: (item) => item.parsed.y + \" leituras\"\n          }\n        })\n      },\n      scales: {\n        x: {\n          grid: { display: false },\n          border: { display: false },\n          ticks: {\n            color: \"#76817B\",\n            font: { size: 14, family: \"Segoe UI\" },\n            maxRotation: 0,\n            autoSkip: false,\n            callback: function (val, idx) { return idx % 2 === 0 ? this.getLabelForValue(val) : null; }\n          }\n        },\n        y: {\n          min: 0,\n          max: 80,\n          border: { display: false },\n          grid: { color: \"rgba(37,49,45,0.08)\", drawTicks: false },\n          ticks: {\n            color: \"#76817B\",\n            font: { size: 14, family: \"Segoe UI\" },\n            stepSize: 20,\n            padding: 8\n          }\n        }\n      }\n    }\n  });\n</script>",
