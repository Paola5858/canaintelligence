data-name=\"breadcrumb current item label\" style=\"font-size:13px;font-weight:600\">ATR</span>\n</div>\n<div data-kid=\"1-3-2\" data-name=\"period and measurement stats group\" style=\"display:flex;align-items:center;gap:10px;font-size:13px;color:#76817B\">\n<span data-kid=\"1-3-2-1\" data-name=\"measurement period text\">Período 04/01/2026 – 11/12/2026</span>\n<span class=\"sep\" data-kid=\"1-3-2-2\" data-name=\"vertical separator line\"></span>\n<span data-kid=\"1-3-2-3\" data-name=\"applied sources count text\">8 fontes aplicadas</span>\n<span class=\"sep\" data-kid=\"1-3-2-4\" data-name=\"vertical separator line\"></span>\n<span data-kid=\"1-3-2-5\" data-name=\"measured days count text\">274 de 342 dias com medição</span>\n</div>\n</div>\n<!-- escada de contexto -->\n<div class=\"card\" data-kid=\"1-4\" data-name=\"context hierarchy staircase card\" style=\"height:84px;display:flex;align-items:stretch;margin-top:8px;overflow:hidden\">\n<div data-kid=\"1-4-1\" data-name=\"level 1 focus unit cell\" style=\"flex:1;min-width:0;padding:10px 18px;display:flex;flex-direction:column;justify-content:center;gap:3px;background:#F3F6F2\">\n<div data-kid=\"1-4-1-1\" data-name=\"level label and focus badge row\" style=\"display:flex;align-items:center;justify-content:space-between\">\n<span class=\"lbl\" data-kid=\"1-4-1-1-1\" data-name=\"level 1 label text\">Nível 1 · Unidade e safra</span>\n<span class=\"lbl\" data-kid=\"1-4-1-1-2\" data-name=\"in focus status badge\" style=\"color:#173F35;font-weight:600\">Em foco</span>\n</div>\n<div data-kid=\"1-4-1-2\" data-name=\"focus unit and season title\" style=\"font-size:15px;line-height:20px;font-weight:600;color:#173F35\">Unidade Cana · Safra 2026/2027</div>\n<div class=\"cellmeta\" data-kid=\"1-4-1-3\" data-name=\"level 1 meta stats row\"><span data-kid=\"1-4-1-3-1\" data-name=\"readings count text\">19.532 leituras</span><span class=\"sep\" data-kid=\"1-4-1-3-2\" data-name=\"vertical separator line\"></span><span data-kid=\"1-4-1-3-3\" data-name=\"sources count text\">8 fontes</span><span class=\"sep\" data-kid=\"1-4-1-3-4\" data-name=\"vertical separator line\"></span><span data-kid=\"1-4-1-3-5\" data-name=\"indicators count text\">23 indicadores</span></div>\n</div>\n<div data-kid=\"1-4-2\" data-name=\"vertical divider line\" style=\"width:1px;background:rgba(37,49,45,.08)\"></div>\n<div data-kid=\"1-4-3\" data-name=\"level 2 source group cell\" style=\"flex:1;min-width:0;padding:10px 18px;display:flex;flex-direction:column;justify-content:center;gap:3px\">\n<div data-kid=\"1-4-3-1\" data-name=\"level label and action row\" style=\"display:flex;align-items:center;justify-content:space-between\">\n<span class=\"lbl\" data-kid=\"1-4-3-1-1\" data-name=\"level 2 label text\">Nível 2 · Grupo de fonte</span>\n<span class=\"lbl\" data-kid=\"1-4-3-1-2\" data-name=\"descend to level 2 action\" style=\"display:flex;align-items:center;gap:4px;color:#173F35\">Descer <i class=\"ti ti-chevron-right\" data-kid=\"1-4-3-1-2-1\" data-name=\"chevron right glyph\" style=\"font-size:12px\"></i></span>\n</div>\n<div data-kid=\"1-4-3-2\" data-name=\"level 2 current value title\" style=\"font-size:15px;line-height:20px;font-weight:600\">Todos os grupos</div>\n<div class=\"cellmeta\" data-kid=\"1-4-3-3\" data-name=\"level 2 meta stats row\"><span data-kid=\"1-4-3-3-1\" data-name=\"frentes count text\">Frentes 9.932</span><span class=\"sep\" data-kid=\"1-4-3-3-2\" data-name=\"vertical separator line\"></span><span data-kid=\"1-4-3-3-3\" data-name=\"laboratory count text\">Laboratório 9.600</span><span class=\"sep\" data-kid=\"1-4-3-3-4\" data-name=\"vertical separator line\"></span><span data-kid=\"1-4-3-3-5\" data-name=\"common indicators count text\">0 indicadores comuns</span></div>\n</div>\n<div data-kid=\"1-4-4\" data-name=\"vertical divider line\" style=\"width:1px;background:rgba(37,49,45,.08)\"></div>\n<div data-kid=\"1-4-5\" data-name=\"level 3 indicator cell\" style=\"flex:1;min-width:0;padding:10px