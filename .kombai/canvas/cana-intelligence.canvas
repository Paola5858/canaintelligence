      "html": "<style>\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n*{box-sizing:border-box}\nbody{margin:0}\n.ci{font-family:\"Segoe UI Variable Text\",\"Segoe UI\",system-ui,sans-serif;font-feature-settings:\"tnum\" 1;color:#25312D}\n.disp{font-family:\"Segoe UI Variable Display\",\"Segoe UI Semibold\",\"Segoe UI\",sans-serif}\n.card{background:#fff;border-radius:24px;box-shadow:0 1px 2px rgba(23,63,53,.045),0 18px 44px -26px rgba(23,63,53,.30)}\n.navpill{display:flex;align-items:center;height:32px;padding:0 15px;border-radius:999px;font-size:14px;line-height:1;color:#76817B;white-space:nowrap}\n.navpill.on{background:#173F35;color:#fff;font-weight:600}\n.lbl{font-size:12px;line-height:16px;color:#76817B}\n.link{color:#173F35;font-weight:600;text-decoration:underline;text-decoration-color:rgba(23,63,53,.28);text-underline-offset:3px;font-size:13px}\n.sep{width:1px;height:11px;background:rgba(37,49,45,.16);display:inline-block}\n.dot{width:6px;height:6px;border-radius:50%;display:inline-block;flex:none}\n.ic{font-size:16px;display:inline-flex;align-items:center;justify-content:center}\n.ic i{font-size:1em;line-height:1}\n.cellmeta{font-size:13px;line-height:16px;color:#76817B;display:flex;align-items:center;gap:7px}\n.btn{display:inline-flex;align-items:center;gap:7px;height:30px;padding:0 12px;border-radius:9px;border:1px solid rgba(37,49,45,.14);font-size:13px;color:#25312D;white-space:nowrap}\n.btn-primary{background:#173F35;border-color:#173F35;color:#fff;font-weight:600}\n.seg{display:inline-flex;align-items:center;gap:2px;height:30px;padding:3px;border-radius:999px;background:#F1EFE7}\n.seg span{display:flex;align-items:center;height:24px;padding:0 11px;border-radius:999px;font-size:13px;color:#76817B;white-space:nowrap}\n.seg span.on{background:#fff;color:#173F35;font-weight:600;box-shadow:0 1px 2px rgba(23,63,53,.10)}\n.sw{width:22px;height:8px;flex:none;display:inline-flex;align-items:center}\n.chip{display:inline-flex;align-items:center;gap:5px;height:22px;padding:0 9px;border-radius:999px;background:rgba(37,49,45,.05);font-size:12px;color:#25312D;font-weight:600}\n@media (prefers-reduced-motion: no-preference){.seg span{transition:none}}\n</style>\n<div class=\"ci\" data-kid=\"1\" data-name=\"dashboard page layout container\" style=\"width:1440px;height:810px;padding:24px;background:#EEF1EA;display:flex;flex-direction:column;overflow:hidden\">\n<!-- cabeçalho -->\n<div data-kid=\"1-1\" data-name=\"page header bar\" style=\"height:48px;display:flex;align-items:center;justify-content:space-between\">\n<div data-kid=\"1-1-1\" data-name=\"header left brand and section group\" style=\"display:flex;align-items:center;gap:14px\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1\" data-name=\"sugarcane leaf logo icon\" fill=\"none\" height=\"30\" viewbox=\"0 0 22 30\" width=\"22\">\n<path d=\"M5 29C5 19.5 7.2 11.6 12.4 4.2\" stroke=\"#173F35\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M12.4 4.2C16.4 6.4 18.9 10.2 19.6 14.8C15.1 14.2 11.7 11.6 10.2 7.6\" stroke=\"#4E7966\" stroke-linejoin=\"round\" stroke-width=\"2.2\"></path>\n<path d=\"M6.6 20.4C5.1 19.7 3.7 20 2.4 20.9\" stroke=\"#C17A4A\" stroke-linecap=\"round\" stroke-width=\"2.2\"></path>\n</svg>\n<span class=\"disp\" data-kid=\"1-1-1-2\" data-name=\"product brand name text\" style=\"font-size:26px;line-height:30px;font-weight:600;letter-spacing:-.4px;color:#173F35\">CANA INTELLIGENCE</span>\n<span data-kid=\"1-1-1-3\" data-name=\"brand section divider\" style=\"width:1px;height:22px;background:rgba(37,49,45,.14)\"></span>\n<span data-kid=\"1-1-1-4\" data-name=\"page section title text\" style=\"font-size:16px;line-height:22px;font-weight:600\">Comparativo tático</span>\n</div>\n<div data-kid=\"1-1-2\" data-name=\"header right status and metadata group\" style=\"display:flex;align-items:center;gap:14px\">\n<div data-kid=\"1-1-2-1\" data-name=\"user role and identity block\" style=\"display:flex;align-items:center;gap:9px\">\n<span class=\"ic\" data-kid=\"1-1-2-1-1\" data-name=\"security shield lock icon\" style=\"color:#4E7966\"><i class=\"ti ti-shield-lock\" data-kid=\"1-1-2-1-1-1\" data-name=\"shield lock glyph icon\"></i></span>\n<div data-kid=\"1-1-2-1-2\" data-name=\"user title and name stack\">\n<div data-kid=\"1-1-2-1-2-1\" data-name=\"user role and level text\" style=\"font-size:13px;line-height:16px;font-weight:600\">Gerência · nível tático</div>\n<div data-kid=\"1-1-2-1-2-2\" data-name=\"user name text\" style=\"font-size:12px;line-height:15px;color:#76817B\">Rafael Menezes</div>\n</div>\n</div>\n<span data-kid=\"1-1-2-2\" data-name=\"header vertical divider\" style=\"width:1px;height:22px;background:rgba(37,49,45,.14)\"></span>\n<div data-kid=\"1-1-2-3\" data-name=\"header right season and load metadata\" style=\"text-align:right\">\n<div data-kid=\"1-1-2-3-1\" data-name=\"season period label text\" style=\"font-size:12px;line-height:15px;color:#76817B\">Safra 2026/2027</div>\n<div data-kid=\"1-1-2-3-2\" data-name=\"model load timestamp text\" style=\"font-size:12px;line-height:15px;color:#76817B\">Carga do modelo 12/12/2026 05:12</div>\n</div>\n</div>\n</div>\n<!-- navegação -->\n<div data-kid=\"1-2\" data-name=\"navigation bar\" style=\"height:40px;display:flex;align-items:center;margin-top:8px\">\n<div class=\"card\" data-kid=\"1-2-1\" data-name=\"navigation pill group\" style=\"display:flex;align-items:center;gap:2px;padding:4px;border-radius:999px\">\n<span class=\"navpill on\" data-kid=\"1-2-1-1\" data-name=\"comparativo navigation pill (active)\">Comparativo</span>\n<span class=\"navpill\" data-kid=\"1-2-1-2\" data-name=\"frentes navigation pill\">Frentes</span>\n<span class=\"navpill\" data-kid=\"1-2-1-3\" data-name=\"indicadores navigation pill\">Indicadores</span>\n<span class=\"navpill\" data-kid=\"1-2-1-4\" data-name=\"pendências navigation pill\">Pendências</span>\n</div>\n</div>\n<!-- contexto permanente -->\n<div class=\"car