\"2026-12-09\",\"2026-12-10\",\"2026-12-11\"];\n  const RAW_V = [112.56,109.717,115.588,118.39,118.433,123.457,125.392,115.403,109.063,112.823,114.517,117.942,120.45,124.352,117.284,110.805,110.259,116.447,116.635,121.35,126.56,121.95,119.535,111.08,111.192,112.16,117.29,117.65,126.555,122.406,116.924,106.833,111.69,112.325,114.94,110.994,112.02,110.925,111.275,110.332,111.993,107.84,109.71,112.485,109.91,109.48,109.312,111.265,107.32,110.33,113.487,116.35,116.28,123.237,121.903,116.496,114.823,115.79,110.274,109.83,108.01,112.82,118.49,111.627,111.32,108.825,110.325,113.7,107.44,109.11,110.525,110.69,108.64,115.78,112.297,110.29,111.51,113.985,120.883,117.79,123.343,127.433,118.428,113.853,110.15,112.575,113.998,119.49,113.173,114.352,115.09,113.007,115.243,114.04,114.595,112.315,113.433,114.115,114.686,110.392,110.47,108.892,112.303,117.18,124.16,125.237,116.747,117.773,116.592,118.535,119.4,116.997,113.843,117.223,120.448,117.917,115.88,120.525,115.94,116.94,116.523,121.767,119.01,113.74,115.635,115.718,111.558,114.155,115.22,115.465,120.464,124.22,119.925,116.271,123.825,122.925,122.96,123.142,126.37,121.146,117.74,121.794,116.03,120.543,121.444,122.6,122.458,121.965,121.657,119.68,120.012,121.957,119.622,114.387,111.384,112.385,117.733,117.707,121.344,123.33,116.492,124.38,122.65,122.845,118.065,122.317,124.96,124.102,123.702,125.487,126.25,126.85,124.704,123.773,123.376,123.65,121.67,125.877,122.417,112.29,112.0,114.845,123.735,123.515,121.965,115.256,126.127,121.267,121.97,123.926,122.1,120.62,122.95,123.27,121.79,124.407,117.372,123.555,123.523,122.421,120.988,122.96,123.43,121.115,115.165,108.445,115.133,118.82,119.493,124.13,126.51,115.93,118.612,114.04,118.763,117.084,116.427,117.502,116.266,113.43,115.405,116.105,116.595,116.142,117.843,115.981,118.123,115.635,118.023,109.533,110.17,115.422,114.783,124.548,127.72,121.877,117.345];\n  const RAW_N = [6,3,5,1,4,3,4,4,3,3,6,4,3,4,12,2,7,3,4,5,2,5,2,4,4,1,4,3,2,5,8,3,1,4,2,5,6,2,4,4,3,3,4,4,5,2,4,2,1,3,4,5,1,4,3,8,3,1,5,2,4,1,1,4,2,2,4,5,1,4,4,5,4,2,3,3,3,4,3,1,4,4,6,3,1,2,4,3,3,4,1,4,3,1,4,2,3,4,5,5,5,6,3,4,2,3,6,3,5,2,3,3,3,6,5,3,3,4,4,5,3,4,3,2,2,4,5,4,4,2,7,7,2,8,2,2,1,4,1,5,2,5,1,4,5,3,4,2,3,1,5,4,5,4,5,4,3,3,5,4,8,2,2,4,2,3,1,4,5,8,1,1,8,3,5,3,2,4,3,1,3,2,2,2,4,12,4,4,1,5,5,1,3,4,1,4,5,4,3,7,5,2,4,2,2,2,6,3,7,2,1,2,10,10,8,10,8,6,10,2,4,4,2,6,6,12,8,6,6,3,2,4,3,5,2,4,6];\n\n  const MESES = [\"January\",\"February\",\"March\",\"April\",\"May\",\"June\",\"July\",\"August\",\"September\",\"October\",\"November\",\"December\"];\n  const MES_PT = [\"jan\",\"fev\",\"mar\",\"abr\",\"mai\",\"jun\",\"jul\",\"ago\",\"set\",\"out\",\"nov\",\"dez\"];\n\n  const obs = new Map();\n  RAW_D.forEach((d, i) => obs.set(d, { v: RAW_V[i], n: RAW_N[i] }));\n\n  const labels = [], values = [], counts = [];\n  let cur = new Date(Date.UTC(2026, 0, 4));\n  const end = new Date(Date.UTC(2026, 11, 11));\n  while (cur <= end) {\n    const iso = cur.toISOString().slice(0, 10);\n    const o = obs.get(iso);\n    labels.push(iso);\n    values.push(o ? o.v : null);\n    counts.push(o ? o.n : 0);\n    cur = new Date(cur.getTime() + 86400000);\n  }\n\n  const baseFont = { size: 14, family: \"Segoe UI\" };\n\n  new Chart(document.getElementById(\"atrDaily\"), {\n    type: \"line\",\n    data: {\n      labels: labels,\n      datasets: [{\n        label: \"Leitura diária\",\n        data: values,\n        borderColor: \"#7C9E8B\",\n        backgroundColor: \"#7C9E8B\",\n        borderWidth: 0,\n        fill: false,\n        tension: 0,\n        spanGaps: false,\n        pointRadius: 1.8,\n        pointBackgroundColor: \"#7C9E8B\",\n        pointBorderWidth: 0,\n        pointHoverRadius: 3,\n        pointHoverBackgroundColor: \"#173F35\",\n        pointHoverBorderColor: \"#FFFFFF\",\n        pointHoverBorderWidth: 2\n      }]\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      animation: false,\n      layout: { padding: { top: 6, right: 2, bottom: 0, left: 0 } },\n      interaction: { mode: \"index\", intersect: false },\n      plugins: {\n        legend: { display: false },\n        tooltip: {\n          backgroundColor: \"#25312D\", titleColor: \"#FFFFFF\", bodyColor: \"#FFFFFF\",\n          padding: 12, cornerRadius: 8, displayColors: false,\n          titleFont: { size: 14, weight: \"600\", family: \"Segoe UI\" },\n          bodyFont: baseFont,\n          callbacks: {\n            title: (items) => {\n              const iso = items[0].label;\n              return iso.slice(8, 10) + \"/\" + iso.slice(5, 7) + \"/\" + iso.slice(0, 4);\n            },\n            label: (item) => item.parsed.y.toFixed(2).replace(\".\", \",\") + \" kg/t\",\n            afterLabel: (item) => counts[item.dataIndex] + (counts[item.dataIndex] === 1 ? \" leitura\" : \" leituras\")\n          }\n        }\n      },\n      scales: {\n        x: {\n          grid: { display: false },\n          border: { display: false },\n          ticks: {\n            color: \"#76817B\", font: baseFont, maxRotation: 0, autoSkip: false,\n            callback: function (val) {\n              const iso = this.getLabelForValue(val);\n              return iso.slice(8, 10) === \"04\" ? MES_PT[Number(iso.slice(5, 7)) - 1] : null;\n            }\n          }\n        },\n        y: {\n          min: 100, max: 135,\n          border: { display: false },\n          grid: { color: \"rgba(37,49,45,0.08)\", drawTicks: false },\n          ticks: {\n            color: \"#76817B\", font: baseFont, stepSize: 5, padding: 8,\n            callback: (v) => Number(v).toFixed(1).replace(\".\", \",\")\n          }\n        }\n      }\n    }\n  });\n\n  // Média mensal real do ATR\n  const M_VAL = [116.937,116.877,117.266,112.828,113.027,115.447,116.799,119.921,121.223,120.916,116.873,118.094];\n  const M_N = [30,35,30,90,85,80,96,98,97,90,143,29];\n\n  new Chart(document.getElementById(\"atrMonthly\"), {\n    type: \"line\",\n    data: {\n      labels: MES_PT,\n      datasets: [{\n        data: M_VAL,\n        borderColor: \"#173F35\",\n        backgroundColor: \"#173F35\",\n        borderWidth: 2,\n        fill: false,\n        tension: 0,\n        pointRadius: 3,\n        pointBackgroundColor: \"#173F35\",\n        pointBorderColor: \"#FFFFFF\",\n        pointBorderWidth: 1.5,\n        pointHoverRadius: 4,\n        pointHoverBackgroundColor: \"#173F35\",\n        pointHoverBorderColor: \"#FFFFFF\",\n        pointHoverBorderWidth: 2\n      }]\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      animation: false,\n      layout: { padding: { top: 4, right: 2, bottom: 0, left: 0 } },\n      plugins: {\n        legend: { display: false },\n        tooltip: {\n          backgroundColor: \"#25312D\", titleColor: \"#FFFFFF\", bodyColor: \"#FFFFFF\",\n          padding: 12, cornerRadius: 8, displayColors: false,\n          titleFont: { size: 14, weight: \"600\", family: \"Segoe UI\" },\n          bodyFont: baseFont,\n          callbacks: {\n            title: (items) => items[0].label + \"/2026\",\n            label: (item) => item.parsed.y.toFixed(2).replace(\".\", \",\") + \" kg/t\",\n            afterLabel: (item) => M_N[item.dataIndex] + (M_N[item.dataIndex] === 1 ? \" leitura\" : \" leituras\")\n          }\n        }\n      },\n      scales: {\n        x: {\n          grid: { display: false },\n          border: { display: false },\n          ticks: { color: \"#76817B\", font: baseFont, padding: 2 }\n        },\n        y: {\n          min: 105, max: 125,\n          border: { display: false },\n          grid: { color: \"rgba(37,49,45,0.08)\", drawTicks: false },\n          ticks: {\n            color: \"#76817B\", font: baseFont, stepSize: 5, padding: 6,\n            callback: (v) => Number(v).toFixed(1).replace(\".\", \",\")\n          }\n        }\n      }\n    }\n  });\n</script>",
