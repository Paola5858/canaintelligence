model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Auditoria_Dados","Dim_Calendario","Dim_Faixa_Valor","Dim_Indicador","Fato_Medicoes","Pendencias_Validacao","Resumo_Qualidade","_Medidas","CaminhoDaBase"]

ref table Auditoria_Dados
ref table Dim_Calendario
ref table Dim_Faixa_Valor
ref table Dim_Indicador
ref table Fato_Medicoes
ref table Pendencias_Validacao
ref table Resumo_Qualidade
ref table _Medidas

ref cultureInfo pt-BR

