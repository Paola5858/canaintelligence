	partition Auditoria_Dados = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook ( File.Contents ( CaminhoDaBase ), null, true ),
				    TabelaFonte = Fonte{[Item = "tbl_Auditoria_Dados", Kind = "Table"]}[Data],
				    TiposAtribuidos = Table.TransformColumnTypes (
				        TabelaFonte,
				        {
				            { "ID_Registro", Int64.Type },
				            { "Indicador", type text },
				            { "Data", type date },
				            { "Fonte", type text },
				            { "Valor_Original", Int64.Type },
				            { "Valor_Anterior", Int64.Type },
				            { "Valor_Final", type number },
				            { "Fator_Aplicado", Int64.Type },
				            { "Regra_Transformacao", type text },
				            { "Status_Anterior", type text },
				            { "Status_Final", type text }
				        },
				        "pt-BR"
				    ),
				    LinhasValidas = Table.SelectRows ( TiposAtribuidos, each [ID_Registro] <> null )
				in
				    LinhasValidas

	annotation PBI_ResultType = Table

